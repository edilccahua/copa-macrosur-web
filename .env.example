# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Copa MacroSur MTB
#
# Este archivo es la PLANTILLA: se copia a `.env` (en la raíz del repositorio)
# y se edita ahí. El `.env` NUNCA se versiona (está en `.gitignore`).
#
#     cp .env.example .env
#
# En PRODUCCIÓN estas variables las define Render (no hay `.env` en el
# servidor): son las del panel "Environment" del Web Service `kuspide-api`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ─────────────────────────────────────────────────────────────────
# `development` habilita CORS para cualquier puerto de localhost y relaja los
# límites de entrada. En producción debe ser `production`.
ENVIRONMENT=development

# ── Base de datos ───────────────────────────────────────────────────────────
# En local, la base SQLite por defecto (`./kuspide_mtb.db`) sirve:
#     PYTHONPATH=. python -m backend.app.seed
# En producción (Render), esta variable apunta a Neon:
#     postgresql+asyncpg://<usuario>:<clave>@<host-pooler>/<base>
# Se deja comentada a propósito: activarla en local haría que el desarrollo
# escribiera sobre la base de PRODUCCIÓN.
# DATABASE_URL=postgresql+asyncpg://neondb_owner:<CLAVE>@ep-cool-mode-artnzlbi-pooler.c-4.us-west-2.aws.neon.tech/neondb

# ── Seguridad ───────────────────────────────────────────────────────────────
# Clave de los endpoints de administración (`/api/v1/admin/*`,
# `/api/v1/stages/*/import-excel`, `/api/v1/stages/*/upload-gpx`).
#
# NO HAY VALOR POR DEFECTO: si el servidor no la encuentra, esos endpoints
# responden 503 (fail-closed). Antes el valor estaba escrito en el código Y en
# el bundle del navegador.
#
# Genera una con:  openssl rand -hex 32
ADMIN_API_KEY=

# PIN de juez de cada fecha (`/admin/juez`). Se siembran en la base de datos
# desde aquí, de modo que el repositorio no contiene ningún PIN.
#
# Formato: KUS-F<n>-<4 caracteres>. Sin caracteres que se confunden al
# dictarlos por radio (0/O, 1/I/L).
#
# Para rotarlos: cambia la variable y ejecuta
#     PYTHONPATH=. python -m backend.scripts.rotate_judge_pins --apply
JUDGE_PIN_F1=
JUDGE_PIN_F2=
JUDGE_PIN_F3=
JUDGE_PIN_F4=

# ── CORS ────────────────────────────────────────────────────────────────────
# Orígenes permitidos en producción. El regex de localhost sólo se aplica en
# `ENVIRONMENT=development`.
CORS_ORIGINS=["https://copa-macrosur-web.pages.dev","https://kuspideweb.com","https://www.kuspideweb.com"]

# Interruptor explícito del regex de localhost. En producción se apaga SOLO
# (el validador de `Settings` lo desactiva cuando `ENVIRONMENT=production`):
# dejarlo activo en el servidor abriría la API a cualquier página servida
# desde el portátil de cualquiera.
CORS_ALLOW_LOCALHOST=true

# ── Límites de entrada ──────────────────────────────────────────────────────
# Ver `backend/app/core/limits.py`. Son tres fronteras en el BORDE de la API,
# antes de tocar la base de datos.
#
# Cuota por IP y ventana deslizante. ENCENDIDA en el servidor.
#
# OJO: este interruptor apaga SÓLO la cuota. Los topes de tamaño de abajo
# nunca se apagan: protegen la memoria del servidor (512 MB en el plan Free
# de Render).
RATE_LIMIT_ENABLED=true

# Tope del cuerpo JSON (2 MB): un envío gigante se rechaza por su
# `Content-Length` sin llegar a leerse.
MAX_JSON_BYTES=2097152

# Tope de los archivos subidos (25 MB): es la lista de inscritos y la
# traza GPX de una fecha.
MAX_UPLOAD_BYTES=26214400

# ── Cloudflare R2 (imágenes y archivos GPX) ─────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kuspide-assets
R2_PUBLIC_URL_PREFIX=https://assets.kuspideweb.com
