# Variables de Entorno - Backend Kúspide MTB
APP_NAME="Kúspide MTB Timing Engine"
ENV="development"
DEBUG=true

# Base de datos (SQLite local o PostgreSQL en Neon)
DATABASE_URL="sqlite+aiosqlite:///./kuspide_mtb.db"
# DATABASE_URL="postgresql+asyncpg://user:pass@ep-cool-db.us-east-2.aws.neon.tech/kuspide"

# Seguridad y Autenticación
ADMIN_API_KEY="***REMOVED-ADMIN-API-KEY***"

# Cloudflare R2 / S3 Storage
R2_ENDPOINT_URL="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_access_key"
R2_SECRET_ACCESS_KEY="your_secret_key"
R2_BUCKET_NAME="kuspide-mtb-assets"
R2_PUBLIC_URL_PREFIX="https://assets.kuspidemtb.pe"
