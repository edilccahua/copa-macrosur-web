---
/**
 * PrizeScale.astro — tarjeta de escala de premios.
 *
 * Adaptación de `bento/BentoCard.astro` y `StageTeamCard.astro`: conserva el
 * borde hairline, la superficie `--bg-raised`, las esquinas rectas y la marca
 * de acento superior; cambia la media 16:10 por el podio de montos, que es lo
 * que el lector necesita comparar.
 *
 * La "vida" de la tarjeta NO es una franja ni un chip con borde (specs/03
 * §Reglas 1 y 4: el acento va arriba y sin chips con borde). Es el mismo
 * mecanismo de `PodiumPanel`: un RÓTULO EN MONO CON COLOR, en la esquina
 * superior izquierda, con el icono del ámbito en línea y sin recuadro.
 *
 *   · PRO / NORMAL → el color de su grupo (`--scope-ink`, tokens.css)
 *   · GOLD         → el oro de la copa (`--copa-gold`)
 *
 * El pie lleva el estado del premio: el ganador provisional del acumulado o,
 * en los premios que se pagan en cada fecha, la frecuencia con que se cobran.
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import Podium from './Podium.astro';
import type { PodiumStep } from './Podium.astro';
import type { PrizeStep } from '../data/prizes';

/**
 * El ganador provisional de un premio acumulado: el líder de puntos de la
 * agrupación mientras el campeonato no se cierra.
 */
export interface PrizeLeader {
  /** Nombre del líder. */
  name: string;
  /** Slug del perfil público (`/corredor/{slug}`). */
  slug?: string;
  /** Puntos acumulados. */
  points: number;
  /** Fechas ya disputadas. */
  stagesCounted: number;
  /** Fechas del campeonato (0 = se desconoce). */
  totalStages: number;
}

interface Props {
  /** Rótulo superior, p. ej. "ACUMULADO". */
  label: string;
  /** Título de la tarjeta, p. ej. "PRO". */
  title: string;
  /** Texto de contexto. */
  body?: string;
  /** Los tres peldaños del podio. */
  tiers: PrizeStep[];
  /**
   * Dibuja los peldaños como la FIGURA del podio (medallas y cifras encima)
   * en vez de la lista de cifras. Es el mismo dibujo que usa `/premios`.
   */
  podium?: PodiumStep[];
  /** Moneda de los montos. */
  currency?: string;
  /** Etiquetas de contexto (categorías, fechas...). */
  tags?: string[];
  /** Acento de la tarjeta. */
  accent?: 'pro' | 'normal' | 'gold' | 'neutral';
  /** Si se pasa, la tarjeta entera es un enlace. */
  href?: string;
  /** Icono del ámbito: en línea, sin caja, en el color de acento. */
  icon?: IconName;
  /** Ganador provisional del premio acumulado. */
  leader?: PrizeLeader | null;
  /** Estado del premio cuando no hay un ganador único (p. ej. "CADA FECHA"). */
  status?: string;
}

const {
  label,
  title,
  body,
  tiers,
  podium,
  currency = 'USD',
  tags = [],
  accent = 'gold',
  href,
  icon,
  leader = null,
  status,
} = Astro.props;

const Tag = href ? 'a' : 'article';
const accentClass =
  accent === 'gold' ? 'prize--gold' : accent === 'neutral' ? 'prize--neutral' : `scope-${accent}`;

/**
 * Con el campeonato cerrado el líder ya no es provisional: el premio está
 * repartido. Mientras falten fechas, lo es.
 */
const leaderLabel =
  leader && leader.totalStages > 0 && leader.stagesCounted >= leader.totalStages
    ? 'GANADOR'
    : 'GANADOR PROVISIONAL';

const leaderDetail = leader
  ? leader.totalStages > 0
    ? `${leader.points} PTS · ${leader.stagesCounted} DE ${leader.totalStages} FECHAS`
    : `${leader.points} PTS`
  : '';
---

<Tag class:list={['prize', accentClass]} href={href}>
  <header class="prize__head">
    {
      icon && (
        <span class="prize__icon" aria-hidden="true">
          <Icon name={icon} size={14} />
        </span>
      )
    }
    <span class="prize__titleGroup">
      <h2 class="prize__label">{title}</h2>
      <span class="prize__scope font-mono">· {label}</span>
    </span>
  </header>

  {body && <p class="prize__body">{body}</p>}

  {
    podium ? (
      <Podium steps={podium} />
    ) : (
      <ol class="prize__tiers">
        {
          tiers.map((tier) => (
            <li class="prize__tier">
              <span class="prize__pos font-mono">{tier.position}º</span>
              <span class="prize__amount tabular">
                {currency} {tier.amountUsd}
              </span>
            </li>
          ))
        }
      </ol>
    )
  }

  {
    tags.length > 0 && (
      <ul class="prize__tags">
        {tags.map((tag) => (
          <li class="prize__tag font-mono">{tag}</li>
        ))}
      </ul>
    )
  }

  {
    (leader || status) && (
      <div class="prize__foot">
        {leader ? (
          <>
            <p class="prize__foot-label font-mono">{leaderLabel}</p>
            <p class="prize__foot-name">
              {leader.slug ? (
                <a href={`/corredor/${leader.slug}`}>{leader.name}</a>
              ) : (
                leader.name
              )}
            </p>
            <p class="prize__foot-detail font-mono">{leaderDetail}</p>
          </>
        ) : (
          <p class="prize__foot-label font-mono">{status}</p>
        )}
      </div>
    )
  }

  {href && <span class="prize__explore">Ver todos los premios →</span>}
</Tag>

<style>
  .prize {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
    text-decoration: none;
    /* El podio se mide a sí mismo para bajar la cifra si la pista es
       estrecha. */
    container-type: inline-size;
    transition: border-color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  /* Sin borde de acento superior: la tarjeta se lee por su contenido.
     El color vive en el rótulo y en el icono (specs/03 §Reglas 1 y 4). */
  .prize--gold {
    --prize-accent: var(--copa-gold);
    --prize-accent-ink: var(--copa-gold);
  }

  .prize--neutral {
    --prize-accent: var(--line-strong);
    --prize-accent-ink: var(--line-strong);
  }

  /* scope-pro / scope-normal: vienen de tokens.css. */
  .prize:not(.prize--gold):not(.prize--neutral) {
    --prize-accent: var(--scope, var(--line-strong));
    --prize-accent-ink: var(--scope-ink, var(--line-strong));
  }

  /* El podio de la tarjeta toma el acento de la tarjeta. */
  .prize {
    --podium-accent: var(--prize-accent, var(--copa-gold));
  }

  a.prize:hover {
    border-color: var(--prize-accent, var(--line-strong));
  }

  .prize__head {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 1.25rem;
  }

  /* El titular y su calificador van juntos: si no caben en la pista, el
     calificador baja de línea en vez de partirse en dos. */
  .prize__titleGroup {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem;
    min-width: 0;
  }

  /* El icono va EN LÍNEA: sin caja, sin borde, sin fondo. */
  .prize__icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--prize-accent-ink);
  }

  .prize__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--prize-accent-ink);
  }

  /* El calificador del rótulo ("· ACUMULADO"): mismo aire, misma tinta. */
  .prize__scope {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--prize-accent-ink);
  }

  .prize__currency {
    margin-left: auto;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--faint);
  }

  .prize__body {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  .prize__tiers {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline) solid var(--line);
  }

  .prize__tier {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: center;
    padding-block: 0.55rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .prize__pos {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  /* Los montos van en monoespaciada, como las filas del podio, pero en un
     punto mayor: son el dato que la tarjeta vende. */
  .prize__amount {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    color: var(--ink-strong);
  }

  .prize__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .prize__tag {
    padding: 0.1875rem 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    border: var(--hairline) solid var(--line);
  }

  /* ── El pie: el estado del premio ─────────────────────────────────────── */
  .prize__foot {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: var(--hairline) solid var(--line);
  }

  .prize__foot-label {
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--prize-accent-ink);
  }

  /* El nombre del ganador va en monoespaciada, como las filas de la
     clasificación: la tarjeta no grita más que el podio de al lado. */
  .prize__foot-name {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .prize__foot-name a {
    color: inherit;
    text-decoration: none;
  }

  .prize__foot-name a:hover {
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .prize__foot-detail {
    margin: 0.25rem 0 0;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .prize__explore {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
  }

  a.prize:hover .prize__explore {
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  /* Con el pie de estado, el enlace de exploración no repite el separador. */
  .prize:has(.prize__foot) .prize__explore {
    margin-top: 0;
    padding-top: 0.5rem;
    border-top: 0;
  }
</style>
