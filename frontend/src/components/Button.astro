---
/**
 * Button.astro — EL botón del sistema.
 *
 * Antes cada página definía su propio `.btn` (con medidas distintas: el de
 * `eventos-especiales` y el de `fechas/[slug]` no coincidían). Eso hacía que
 * dos botones del mismo sitio tuvieran dos alturas y dos interletrajes.
 *
 * Ahora hay UNA definición, tomada de la casa: monoespaciada, en versalitas,
 * con la inversión de la referencia (`--invert-bg` / `--invert-fg`) para la
 * variante sólida y una hairline para la fantasma.
 */
interface Props {
  href: string;
  label: string;
  /** `solid` invierte el fondo; `ghost` dibuja una hairline. */
  variant?: 'solid' | 'ghost';
  /** Abre en pestaña nueva con `rel="noopener noreferrer"`. */
  external?: boolean;
  /** Etiqueta accesible cuando el texto visible no basta. */
  ariaLabel?: string;
  class?: string;
}

const {
  href,
  label,
  variant = 'ghost',
  external = false,
  ariaLabel,
  class: className = '',
} = Astro.props;
---

<a
  class:list={['btn', `btn--${variant}`, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  aria-label={ariaLabel}
>
  <span>{label}</span>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0.5rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    white-space: nowrap;
    border: var(--hairline) solid transparent;
    border-radius: var(--radius, 0);
    transition:
      background var(--default-transition-duration) var(--default-transition-timing-function),
      border-color var(--default-transition-duration) var(--default-transition-timing-function),
      color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .btn--solid {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .btn--solid:hover {
    background: var(--accent);
    color: #ffffff;
  }

  .btn--ghost {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }

  .btn--ghost:hover {
    background: var(--bg-sunken);
    border-color: var(--line-strong);
    color: var(--ink-strong);
  }
</style>
