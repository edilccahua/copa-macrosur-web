---
/**
 * Podium.astro — la figura del podio de un premio.
 *
 * Tres peldaños: tercero, primero y segundo, con el primero en el centro y
 * el más alto, como en un podio de verdad. La medalla va dentro del
 * escalón (lleva el puesto calado al vacío, así que no se repite el "1º" en
 * texto) y **la cifra va ENCIMA** de su escalón.
 *
 * Con `holders`, cada peldaño lleva además al ganador provisional de ese
 * puesto. Sin ellos, el podio es sólo la escala del premio.
 *
 * El color de las cifras lo pone quien lo usa: `--podium-accent`.
 */
import MedalIcon from './MedalIcon.astro';

export interface PodiumStep {
  position: 1 | 2 | 3;
  amountUsd: number;
  /** El ganador provisional del puesto (sólo en los premios acumulados). */
  holder?: string | null;
}

interface Props {
  /** Los tres peldaños, en orden de puesto (1º, 2º, 3º). */
  steps: PodiumStep[];
  /** Muestra el ganador provisional dentro de cada peldaño. */
  holders?: boolean;
  currency?: string;
}

const { steps, holders = false, currency = 'USD' } = Astro.props;

/** El orden en que se ven los peldaños: tercero, primero y segundo. */
const escalones = steps.length === 3 ? [steps[2], steps[0], steps[1]] : steps;

const medallero = { 1: 26, 2: 22, 3: 22 } as const;
---

<div class:list={['podium', holders && 'podium--holders']}>
  {
    escalones.map((step) => (
      <div class={`podium__step podium__step--${step.position}`}>
        <span class="podium__value">
          <span class="podium__currency font-mono">{currency}</span>
          {step.amountUsd}
        </span>
        <span class="podium__block">
          <MedalIcon rank={step.position} size={medallero[step.position]} />
          {holders && step.holder && (
            <span class="podium__holder">
              <span class="podium__state font-mono">Provisional</span>
              <span class="podium__name font-mono">{step.holder}</span>
            </span>
          )}
        </span>
      </div>
    ))
  }
</div>

<style>
  .podium {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: end;
    gap: 0.5rem;
  }

  .podium__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .podium__value {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 620;
    font-stretch: 118%;
    line-height: 1;
    letter-spacing: -0.02em;
    /* El premio NO va en color: la cifra es dato, no decoración. El único
       acento de la tarjeta es su rótulo. */
    color: var(--ink-strong);
  }

  .podium__currency {
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .podium__block {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.375rem;
    width: 100%;
    padding-block: 0.5rem;
    background: var(--bg-sunken);
    border: var(--hairline) solid var(--line);
  }

  .podium__step--1 .podium__block {
    height: 6rem;
  }

  .podium__step--2 .podium__block {
    height: 4.5rem;
  }

  .podium__step--3 .podium__block {
    height: 3.375rem;
  }

  /* Con ganador dentro, los peldaños crecen para que quepan la medalla, la
     etiqueta y el nombre. */
  .podium--holders .podium__step--1 .podium__block {
    height: 8.5rem;
  }

  .podium--holders .podium__step--2 .podium__block {
    height: 7rem;
  }

  .podium--holders .podium__step--3 .podium__block {
    height: 5.75rem;
  }

  /* El ganador va CENTRADO: los nombres largos se parten en dos renglones y,
     sin centrar, el segundo queda pegado a la izquierda y el peldaño se ve
     torcido. */
  .podium__holder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    width: 100%;
    padding-inline: 0.375rem;
    text-align: center;
  }

  .podium__state {
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .podium__name {
    font-size: 0.6875rem;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  /* En una celda estrecha la cifra baja un punto para que el podio quepa. */
  @container (max-width: 30rem) {
    .podium__value {
      font-size: var(--text-sm);
    }
  }
</style>
