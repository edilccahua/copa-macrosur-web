---
/**
 * TimelineEvents.astro — Sección de eventos interactiva con timeline y scroll animado.
 * Arquitectura bifacial optimizada:
 * - Desktop (>= 900px): 2 Columnas reales traslapadas (izq: 1, 3, 5 / der: 2, 4, 6 con offset)
 *   y Eje central con chips de fecha técnicos (17-MAY, 26-JUL, etc.) que se encienden al scroll.
 * - Móvil (< 900px): 1 Columna corrida apilada cronológicamente de la 1 a la 6.
 * - Sin selector de pestañas, con excelente relación de portada 16:10 y cero espacios vacíos.
 */
import EventCard from './EventCard.astro';

const ALL_EVENTS = [
