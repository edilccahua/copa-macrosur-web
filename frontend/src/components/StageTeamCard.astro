---
/**
 * StageTeamCard.astro — el podio de clubes de una fecha.
 *
 * Adaptación de `copiaartcraft/src/components/AppCard.astro` (la tarjeta del
 * lineup de getartcraft.com/apps) y de `bento/BentoCard.astro`: se conserva
 * la nomenclatura de clases del original (`bento`, `bento__head`,
 * `bento__index`, `bento__title`, `bento__body`, `bento__tags`)
 * y el mecanismo de acento por tarjeta (`app-<slug>` → `--app` / `--app-ink`).
 * Sin recuadro de iniciales: solo nombre y datos.
 *
 * Un club, una ficha. El acento lo da el lugar en el podio: oro, plata, bronce.
 */
import type { TeamPodium } from '../lib/api';
import MedalIcon from './MedalIcon.astro';

interface Props {
  teams: TeamPodium[];
}

const { teams } = Astro.props;

/** El acento por lugar en el podio: oro, plata, bronce. */
const placeClass = (index: number) => `app-club-${index + 1}`;

/** Las medallas del club, en el orden del Tour. */
function medals(team: TeamPodium): { label: string; value: number }[] {
  return [
    { label: 'OROS', value: team.first_places ?? 0 },
    { label: 'PLATAS', value: team.second_places ?? 0 },
    { label: 'BRONCES', value: team.third_places ?? 0 },
  ];
}

/** La línea de contexto de la tarjeta. */
function context(team: TeamPodium): string {
  const riders = team.riders_counted === 1 ? 'corredor puntuó' : 'corredores puntuaron';
  const best = team.best_rank <= 900 ? ' · mejor puesto ' + team.best_rank + 'º' : '';
  return `${team.riders_counted} ${riders}${best}`;
}
---

<ol class="lineup">
  {
    teams.map((team, index) => (
      <li class={`bento bento--span-4 ${placeClass(index)}`}>
        <header class="bento__head">
          <span class="bento__index tabular">{String(index + 1).padStart(2, '0')}</span>
          <MedalIcon
            rank={(index + 1) as 1 | 2 | 3}
            size={22}
            class="bento__medal"
          />
        </header>

        <h3 class="bento__title">
          <a href={`/equipos/${team.team_slug}`}>{team.team_name}</a>
        </h3>
        <p class="bento__body">{context(team)}</p>
        <p class="bento__status">{team.points} PTS</p>

        <ul class="bento__tags">
          {medals(team).map((medal) => (
            <li class="bento__tag">
              {medal.value} {medal.label}
            </li>
          ))}
        </ul>

        <a class="bento__explore" href={`/equipos/${team.team_slug}`}>
          Ver ficha del club →
        </a>
      </li>
    ))
  }
</ol>

<style>
  .lineup {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
    list-style: none;
    margin: 1.5rem 0 3.5rem;
    padding: 0;
  }

  /* La tarjeta de club es el bento de artcraft: superficie, hairline, acento
     arriba y el mismo ritmo de hover. */
  .bento {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color var(--default-transition-duration) var(--default-transition-timing-function),
      background var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .bento:hover {
    border-color: var(--app, var(--line-strong));
    background: var(--bg);
  }

  .bento::before {
    content: '';
    display: block;
    height: 2px;
    background: var(--app, var(--line));
  }

  .bento__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    min-height: 1.25rem;
  }

  .bento__label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .bento__medal {
    align-self: center;
  }

  .bento__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink);
  }

  .bento__title a {
    color: inherit;
    text-decoration: none;
  }

  .bento__title a:hover {
    color: var(--app-ink);
  }

  .bento__body {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .bento__status {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--app-ink);
  }

  .bento__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: auto 0 0;
    padding-top: 0.5rem;
    border-top: var(--hairline) solid var(--line);
    list-style: none;
  }

  .bento__tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
    color: var(--muted);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
  }

  .bento__explore {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--app-ink);
    text-decoration: none;
  }

  .bento__explore:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* El lugar en el podio marca el acento: oro, plata, bronce. */
  .app-club-1 {
    --app: var(--podium-1, #a97a12);
    --app-ink: var(--podium-1, #a97a12);
  }

  .app-club-2 {
    --app: var(--podium-2, #6f7784);
    --app-ink: var(--podium-2, #6f7784);
  }

  .app-club-3 {
    --app: var(--podium-3, #8a5a34);
    --app-ink: var(--podium-3, #8a5a34);
  }

  @media (min-width: 48em) {
    .lineup {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
</style>
