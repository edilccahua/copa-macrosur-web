---
/**
 * StagePodiumGrid.astro — el podio por categoría de una fecha.
 *
 * Cada categoría disputada muestra su top-3 con dorsal, tiempo oficial,
 * puntos y club. Los datos vienen del backend (`podium` del resumen), que usa
 * el `category_rank` calculado por el motor de scoring: el PDF oficial manda.
 */
import type { CategoryPodium } from '../lib/api';

interface Props {
  podium: CategoryPodium[];
  id?: string;
}

const { podium, id } = Astro.props;
---

<div class="podium" id={id}>
  {
    podium.map((cat) => (
      <section class="cat">
        <header class="cat__head">
          <h3 class="cat__code font-mono">{cat.short_code}</h3>
          <span class="cat__name">{cat.category_name}</span>
        </header>

        <ol class="cat__list">
          {cat.entries.map((e) => (
            <li class="row">
              <span class="row__rank font-mono" data-rank={e.rank}>
                {e.rank}º
              </span>
              <span class="row__bib font-mono">#{e.bib_number}</span>
              <a class="row__name" href={`/corredor/${e.rider_slug}`}>
                {e.rider_name}
              </a>
              <span class="row__team">
                {e.team_slug ? (
                  <a href={`/equipos/${e.team_slug}`}>{e.team_name}</a>
                ) : (
                  e.team_name
                )}
              </span>
              <span class="row__time font-mono">{e.formatted_time}</span>
              <span class="row__pts font-mono">+{e.points_earned}</span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .podium {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 47.99em) {
    .podium {
      grid-template-columns: 1fr;
    }
  }

  .cat {
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    min-width: 0;
  }

  .cat__head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: var(--hairline) solid var(--line);
    background: var(--bg);
  }

  .cat__code {
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cat__name {
    font-family: var(--font-display, var(--font-sans));
    font-size: 0.9375rem;
    font-weight: 620;
    letter-spacing: -0.01em;
    color: var(--ink-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 1.75rem 2.75rem minmax(0, 1fr);
    grid-template-areas:
      'rank bib name'
      'rank bib team'
      'time time pts';
    align-items: center;
    gap: 0.1rem 0.5rem;
    padding: 0.7rem 1rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .row:last-child {
    border-bottom: none;
  }

  .row__rank {
    grid-area: rank;
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .row__rank[data-rank='1'] {
    color: var(--podium-1, #a97a12);
  }

  .row__rank[data-rank='2'] {
    color: var(--podium-2, #6f7784);
  }

  .row__rank[data-rank='3'] {
    color: var(--podium-3, #8a5a34);
  }

  .row__bib {
    grid-area: bib;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .row__name {
    grid-area: name;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row__name:hover {
    color: var(--accent);
  }

  .row__team {
    grid-area: team;
    font-size: 0.6875rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row__team a {
    color: inherit;
    text-decoration: none;
  }

  .row__team a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15rem;
  }

  .row__time {
    grid-area: time;
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink-strong);
  }

  .row__pts {
    grid-area: pts;
    font-size: 0.75rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    text-align: right;
  }

  @media (min-width: 48em) {
    .row {
      grid-template-columns: 1.75rem 2.75rem minmax(0, 1fr) auto;
      grid-template-areas: 'rank bib name time' 'rank bib team pts';
      gap: 0.1rem 0.625rem;
    }

    .row__pts {
      align-self: center;
    }
  }
</style>
