---
/**
 * SiteHeader.astro — cabecera oficial de Kúspide MTB.
 *
 * Estructura tomada de getartcraft.com (medida en vivo a 1600 px):
 *
 *   barra: flex h-12 items-stretch justify-between   (48 px, full-bleed)
 *   [ marca │ nav ] ......................... [ celdas de iconos ]
 *     ↑ pegados a la izquierda                  ↑ pegadas al borde
 *
 *   - la marca es el LOGO (un icono en el original; aquí el wordmark). No es
 *     un item de menú: "KÚSPIDE" e "INICIO" llevan a la portada, pero el que
 *     se marca como activo es "INICIO";
 *   - los items van en mono 0.6875rem, versalitas, tracking 0.15em, con
 *     0.625rem de padding a cada lado;
 *   - el item ACTIVO se invierte (pastilla); al pasar el puntero sólo cambia
 *     el color, como en la referencia;
 *   - en la referencia el nav desaparece por debajo de `lg`; aquí el corte
 *     está en 900px, con un cajón superpuesto en móvil.
 *
 * La cabecera **persiste** entre navegaciones (`transition:persist`): el
 * router de Astro reutiliza este mismo elemento, así que la entrada de la
 * barra —que es una animación CSS— ocurre UNA sola vez por sesión y NO se
 * repite al cambiar de página.
 */
import { NAV_GROUPS, CONTACT_WHATSAPP } from '../lib/nav';
import { isActivePath } from '../lib/nav';

const path = Astro.url.pathname;
const current = NAV_GROUPS.flatMap((g) => g.items).find((item) => isActivePath(path, item));
---

<header class="hdr" id="site-header" transition:persist="site-header">
  <div class="hdr__bar">
    <div class="hdr__left">
      <a class="hdr__brand" href="/" aria-label="Kuspide Xtreme Sports — Copa MacroSur MTB 2026">
        <span class="brand-text">KÚSPIDE</span>
      </a>

      <nav class="hdr__nav" aria-label="Navegación principal">
        {
          NAV_GROUPS.map((group) => (
            <div class:list={['hdr__group', { 'hdr__group--sep': group.separated }]}>
              {group.items.map((item) => (
                <a
                  class:list={['hdr__link', { 'is-active': isActivePath(path, item) }]}
                  href={item.href}
                  data-nav-match={item.match.join('|')}
                  data-nav-anchor={item.anchor ? 'true' : undefined}
                  aria-current={isActivePath(path, item) ? 'page' : undefined}
                >
                  <span class="hdr__label">{item.label}</span>
                </a>
              ))}
            </div>
          ))
        }
      </nav>

      <!--
        Indicador de sección (móvil). En escritorio el nav ya dice en qué
        sección estás; en móvil, donde el nav está oculto, este rótulo ocupa
        su lugar: sólo el nombre de la sección ("INICIO", "FECHAS",
        "CLASIFICACIONES"…), sin ninguna descripción.
      -->
      <span class="hdr__here" data-nav-here>
        <span class="hdr__here-label" data-nav-current-label>{current?.label ?? 'INICIO'}</span>
      </span>
    </div>

    <div class="hdr__right">
      <div class="hdr__cell hdr__cell--hide-sm">
        <a
          href={CONTACT_WHATSAPP.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contacto WhatsApp"
          title={`WhatsApp oficial Kúspide: ${CONTACT_WHATSAPP.phone}`}
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.5 8.5 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </a>
      </div>

      <div class="hdr__cell">
        <button id="theme-toggle" class="hdr__theme" type="button" aria-label="Conmutar tema (claro u oscuro)">
          <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
          <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.5"></path>
          </svg>

          <!--
            Aviso de PRIMERA VISITA: sólo aparece una vez (se guarda la marca
            en localStorage) y señala que el tema se cambia ahí. Desaparece
            solo a los 4,5 s.
          -->
          <span class="hdr__hint" data-theme-hint role="status" hidden>
            <strong>CAMBIA EL TEMA AQUÍ</strong>
            <span>Claro u oscuro. Hasta que lo elijas, sigue al del dispositivo.</span>
          </span>
        </button>
      </div>

      <div class="hdr__cell hdr__cell--burger">
        <button
          class="hdr__burger"
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-panel"
          aria-label="Menú"
        >
          <!--
            El burger va con barras RELLENAS, no con trazos. Con `stroke-width`
            en un viewBox de 24 unidades dibujado a 16 px, un trazo de 1.5 sale
            de un píxel de pelo: tres líneas finas separadas por huecos se leen
            mucho más livianas que el círculo del icono de tema, que al ser un
            contorno cerrado "rellena" y da volumen. Con barras de 2 px el
            burger tiene el mismo peso visual que el sol: 12 × 11 px.
          -->
          <svg class="i-bars" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <rect x="3" y="4" width="18" height="3"></rect>
            <rect x="3" y="10.5" width="18" height="3"></rect>
            <rect x="3" y="17" width="18" height="3"></rect>
          </svg>
          <svg class="i-close" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true">
            <line x1="4.5" y1="4.5" x2="19.5" y2="19.5"></line>
            <line x1="19.5" y1="4.5" x2="4.5" y2="19.5"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!--
    Cajón de navegación (móvil). Va SUPERPUESTO al contenido: no empuja la
    página ni produce salto de layout. Entra con un desplazamiento corto y
    los items se escalonan.
  -->
  <!--
    Barra de avance de lectura. Va pegada al borde inferior del menú y
    sólo aparece donde NO hay regulador lateral (por debajo de 48em), que
    es donde el usuario no tiene ninguna otra indicación de en qué parte
    de la página está.
  -->
  <span class="hdr__progress" data-read-progress aria-hidden="true"></span>

  <div class="hdr__scrim" id="nav-scrim" aria-hidden="true"></div>

  <nav class="hdr__drawer" id="nav-panel" aria-label="Menú">
    {
      NAV_GROUPS.map((group) =>
        group.items.map((item, index) => (
          <a
            class:list={['hdr__drawer-link', { 'is-active': isActivePath(path, item) }]}
            href={item.href}
            data-nav-match={item.match.join('|')}
            data-nav-anchor={item.anchor ? 'true' : undefined}
            data-nav-label={item.label}
            aria-current={isActivePath(path, item) ? 'page' : undefined}
            style={`--i: ${index + 1};`}
          >
            <span class="hdr__label">{item.label}</span>
          </a>
        ))
      )
    }
  </nav>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: var(--hairline) solid var(--line);
  }

  /* La barra: como la referencia, `justify-between` — la marca y el nav
     pegados a la izquierda, las celdas de iconos al borde derecho. */
  .hdr__bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    box-sizing: border-box;
    min-width: 0;
    height: var(--nav-height-mobile, 3rem);
    /* Encima del velo y del cajón, que son `fixed`. */
    position: relative;
    z-index: 3;
  }

  .hdr__left {
    display: flex;
    align-items: stretch;
    min-width: 0;
  }

  .hdr__right {
    display: flex;
    align-items: stretch;
    flex: 0 0 auto;
  }

  /* ── Entrada de la barra ────────────────────────────────────────────────
     La animación vive en CSS, no en JS: el estado inicial está en la hoja de
     estilos, así que no hay destello (el contenido no se pinta visible antes
     de ocultarse) y no depende de que GSAP haya cargado. Como la cabecera
     PERSISTE entre navegaciones, el elemento se crea una sola vez y la
     animación ocurre una vez por sesión. */
  @keyframes hdr-item-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hdr__bar > * {
    animation: hdr-item-in 0.45s var(--ease-out) both;
    animation-delay: calc(var(--hdr-intro-delay, 0.05s) + var(--hdr-intro-stagger, 0.05s) * var(--i, 0));
  }

  .hdr__bar > :nth-child(1) { --i: 0; }
  .hdr__bar > :nth-child(2) { --i: 1; }

  /* Una vez que la entrada ha terminado, la animación se DESACTIVA.
     Motivo: al navegar, el router reinserta la cabecera persistente en el
     body nuevo y eso reinicia las animaciones CSS del elemento: la barra
     desaparecía y volvía a entrar en cada clic. Con esta clase, la
     animación ocurre UNA vez por sesión (al cargar) y nunca más. */
  .hdr.is-ready .hdr__bar > * {
    animation: none;
    opacity: 1;
    transform: none;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--ink);
    white-space: nowrap;
  }

  /* La marca: un separador vertical la separa del menú (como la referencia). */
  .hdr__brand {
    display: flex;
    align-items: center;
    padding-inline: 1rem;
    border-right: var(--hairline) solid var(--line);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  /* Las celdas no llevan padding: lo lleva el elemento interactivo, para que
     el ÁREA CLICABLE sea toda la celda (antes había que apuntar al icono). */
  .hdr__cell {
    position: relative;
    display: flex;
    align-items: stretch;
    justify-content: center;
    flex: 0 0 auto;
    border-left: var(--hairline) solid var(--line);
    color: var(--muted);
    transition: color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .hdr__cell > a,
  .hdr__cell > button {
    display: grid;
    place-items: center;
    padding-inline: 0.875rem;
    height: 100%;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .hdr__cell:hover {
    color: var(--ink);
  }

  /* El botón del tema ocupa la celda entera. */
  .hdr__theme {
    position: relative;
  }

  .hdr__nav {
    display: none;
    align-items: stretch;
    min-width: 0;
  }

  /* Grupos separados por un hairline vertical, como en getartcraft.com
     (`ml-1.5 + border-l + pl-1.5`). */
  .hdr__group {
    display: flex;
    align-items: stretch;
  }

  .hdr__group--sep {
    margin-left: 0.5rem;
    padding-left: 0.5rem;
    border-left: var(--hairline) solid var(--line);
  }

  .hdr__link {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    /* El aire entre items: con la pastilla encima del texto (6 px) y 12 px de
       padding en el enlace, entre dos pastillas quedan 24 px. En la referencia
       son 20 px (10 px de padding + 6 px de pastilla en cada lado). */
    padding-inline: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
  }

  /**
   * La pastilla va sobre el TEXTO, no sobre la celda entera.
   *
   * Es lo que hace getartcraft.com: dentro del enlace hay un `<span>` con
   * `px-1.5 py-0.5` que lleva el fondo invertido, tanto en el item activo
   * como al pasar el puntero (`group-hover:bg-invert`). Medido allí: chip de
   * 45×21 px dentro de una celda de 65×48.
   *
   * Antes el fondo iba en el enlace entero: la pastilla ocupaba toda la
   * celda (de altura completa) y el hover era sólo un cambio de color, que
   * no es lo que hace la referencia.
   */
  .hdr__label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.375rem;
    transition:
      background-color var(--default-transition-duration) var(--default-transition-timing-function),
      color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .hdr__link:hover .hdr__label,
  .hdr__link.is-active .hdr__label {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .i-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .i-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .i-sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-moon {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .i-sun {
      display: block;
    }
  }

  .i-close {
    display: none;
  }

  .hdr.is-open .i-bars {
    display: none;
  }

  .hdr.is-open .i-close {
    display: block;
  }

  /* ── Cajón (móvil) ───────────────────────────────────────────────────────
     Va superpuesto al contenido: el cajón es `fixed` y el velo tapa la
     página. Así no hay salto de layout al abrirlo. */

  .hdr__scrim {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: color-mix(in srgb, var(--bg) 55%, #000 45%);
    opacity: 0;
    visibility: hidden;
    touch-action: none;
    /* Al cerrar, la visibilidad se oculta DESPUÉS del fundido; al abrir,
       cambia de inmediato (así el cajón ya es enfocable). */
    transition:
      opacity 220ms var(--ease-out),
      visibility 0s linear 220ms;
  }

  .hdr.is-open .hdr__scrim {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 220ms var(--ease-out),
      visibility 0s;
  }

  .hdr__drawer {
    position: fixed;
    top: var(--header-offset-mobile, 4rem);
    left: 0;
    right: 0;
    z-index: 2;
    max-height: calc(100dvh - var(--header-offset-mobile, 4rem));
    overflow-y: auto;
    /* El scroll del cajón no se encadena con el de la página. */
    overscroll-behavior: contain;
    background: var(--bg);
    border-bottom: var(--hairline) solid var(--line);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
    transform: translateY(-10px);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 260ms var(--ease-out),
      opacity 200ms var(--ease-out),
      visibility 0s linear 260ms;
  }

  .hdr.is-open .hdr__drawer {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    transition:
      transform 260ms var(--ease-out),
      opacity 200ms var(--ease-out),
      visibility 0s;
  }

  @keyframes drawer-item-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hdr.is-open .hdr__drawer-link {
    animation: drawer-item-in 0.32s var(--ease-out) both;
    animation-delay: calc(0.05s + 0.035s * var(--i, 1));
  }

  .hdr__drawer-current {
    padding: 0.75rem 1rem 0.625rem;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--faint);
    border-bottom: var(--hairline) solid var(--line);
  }

  .hdr__drawer-current strong {
    color: var(--ink);
    font-weight: 700;
  }

  /**
   * Barra de avance de lectura: una línea bajo el menú que se llena según
   * lo scrolleado. Sólo se dibuja donde no hay regulador lateral (por debajo
   * de 48em), que es donde el usuario no tiene ninguna otra referencia de
   * en qué parte de la página está.
   */
  .hdr__progress {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    pointer-events: none;
  }

  @media (max-width: 47.99em) {
    .hdr__progress {
      display: block;
    }
  }

  /**
   * Aviso de primera visita: un globo que señala el botón del tema.
   *
   * Aparece UNA sola vez (queda marcado en `localStorage`) y se va solo a los
   * 4,5 s. Va anclado al botón, no a la celda, para que la flecha apunte
   * siempre al icono.
   */
  .hdr__hint {
    position: absolute;
    top: calc(100% + 10px);
    /* Anclado al BORDE DERECHO del botón, no al centro: el botón está en el
       extremo de la barra, así que centrado el globo se salía de la
       pantalla. */
    right: 0;
    z-index: 45;
    width: max-content;
    max-width: min(16rem, calc(100vw - 2rem));
    padding: 0.5rem 0.625rem;
    background: var(--invert-bg);
    color: var(--invert-fg);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
    text-align: left;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.32);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 280ms var(--ease-out),
      transform 280ms var(--ease-out);
    pointer-events: none;
  }

  .hdr__hint.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* La flecha: sobre el icono (el centro del botón está a ~22 px de su
     borde derecho). */
  .hdr__hint::before {
    content: '';
    position: absolute;
    top: -5px;
    right: 16px;
    width: 10px;
    height: 10px;
    background: var(--invert-bg);
    transform: rotate(45deg);
  }

  .hdr__hint strong {
    display: block;
    font-weight: 700;
  }

  .hdr__hint span {
    display: block;
    margin-top: 0.25rem;
    opacity: 0.72;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* ── Transición del tema ─────────────────────────────────────────────────
     Al cambiar de tema, los colores de las superficies maestras se interpolan
     suavemente (280ms) sin sobrecargar el compositor ni interferir con las
     animaciones de scroll o SVG. */
  :global(html.theme-switching),
  :global(html.theme-switching body),
  :global(html.theme-switching .hdr),
  :global(html.theme-switching .ftr) {
    transition:
      background-color 280ms var(--ease-in-out),
      border-color 280ms var(--ease-in-out),
      color 280ms var(--ease-in-out) !important;
  }

  /**
   * Indicador de sección de la barra (móvil). Ocupa el lugar del nav, que
   * en móvil está oculto: dice en qué sección estás, sólo con el nombre.
   */
  .hdr__here {
    display: none;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    padding-inline: 0.875rem;
    border-left: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hdr__here-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hdr__drawer-link {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.9375rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    border-bottom: var(--hairline) solid var(--line);
    text-decoration: none;
  }

  /* "Dónde estoy": la misma pastilla invertida que en la barra (el mismo
     lenguaje visual). */
  .hdr__drawer-link.is-active .hdr__label {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  /* ── Escritorio ───────────────────────────────────────────────────────── */
  @media (min-width: 56.25em) {
    .hdr__bar {
      height: var(--nav-height, 3.0625rem);
    }

    .hdr__nav {
      display: flex;
    }

    /* En escritorio el burger desaparece: se oculta la CELDA entera, con su
       hairline, para que no quede una línea vertical huérfana. */
    .hdr__cell--burger {
      display: none;
    }

    /* En escritorio el cajón no existe: el nav hace ese papel. */
    .hdr__scrim,
    .hdr__drawer {
      display: none;
    }
  }

  /* ── Móvil ─────────────────────────────────────────────────────────────── */
  @media (max-width: 56.24em) {
    /* El contacto de WhatsApp vive en el pie (en móvil la barra se queda
       con lo esencial). */
    .hdr__cell--hide-sm {
      display: none;
    }

    /* En móvil el nav está oculto: el indicador de sección ocupa su sitio. */
    .hdr__here {
      display: flex;
    }

    .hdr__brand {
      padding-inline: 0.875rem;
    }

    .brand-text {
      font-size: 0.75rem;
    }
  }
</style>
