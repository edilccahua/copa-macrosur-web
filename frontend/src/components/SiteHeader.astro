---
/**
 * SiteHeader.astro — cabecera oficial de Kúspide MTB.
 * Replicación fiel de la estructura full-bleed y hairlines de GetArtCraft.
 */
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const navItems = [
  { label: 'Campeonato', href: '/' },
  { label: 'Fechas', href: '/#fechas' },
  { label: 'Eventos Ruta', href: '/eventos-especiales' },
  { label: 'Ranking', href: '/ranking-general' },
  { label: 'En Vivo', href: '/en-vivo' },
  { label: 'Inscripciones', href: '/inscripciones' },
  { label: 'Reclamos', href: '/reclamos' },
];

const cta = { label: 'Inscripción', href: '/inscripciones' };
---
<header class="hdr" id="site-header">
  <div class="hdr__bar">
    <a class="hdr__brand" href="/" aria-label="Kúspide MTB">
      <span class="brand-text">KÚSPIDE</span>
    </a>

    <nav class="hdr__nav" aria-label="Navegación principal">
      {
        navItems.map((item) => (
          <a class:list={['hdr__link', { 'is-active': isActive(item.href) }]} href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hdr__spacer"></div>

    <div class="hdr__cell">
      <a href="https://wa.me/51994382248" target="_blank" rel="noopener noreferrer" aria-label="Contacto WhatsApp" title="WhatsApp Oficial Kúspide: 994 382 248">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
      </a>
    </div>

    <div class="hdr__cell">
      <a href="/admin/juez" aria-label="Panel del Juez" title="Panel Móvil del Juez">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="13" r="8"></circle>
          <polyline points="12 9 12 13 15 15"></polyline>
          <path d="M12 5V2M10 2h4"></path>
        </svg>
      </a>
    </div>

    <div class="hdr__cell">
      <button id="theme-toggle" type="button" aria-label="Conmutar tema">
        <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
        <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>

    <button class="hdr__cell hdr__burger" id="nav-toggle" type="button" aria-expanded="false" aria-label="Menú">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>

    <a class="hdr__cta" href={cta.href}>
      <span>{cta.label}</span>
    </a>
  </div>

  <div class="hdr__panel" id="nav-panel">
    {
      navItems.map((item) => (
        <a class:list={['hdr__panel-link', { 'is-active': isActive(item.href) }]} href={item.href}>
          {item.label}
        </a>
      ))
    }
    <a class="hdr__panel-link highlight font-mono" href="/admin/juez">[COMISARIO] Panel Juez Oficial</a>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeButton = document.getElementById('theme-toggle');

  themeButton?.addEventListener('click', () => {
    const current =
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('kuspide-theme', next);
    } catch (e) {}
  });

  const header = document.getElementById('site-header');
  const navButton = document.getElementById('nav-toggle');
  navButton?.addEventListener('click', () => {
    const open = header?.classList.toggle('is-open') ?? false;
    navButton.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: var(--hairline) solid var(--line);
  }

  .hdr__bar {
    display: flex;
    align-items: stretch;
    box-sizing: border-box;
    min-width: 0;
    height: var(--nav-height-mobile, 3rem);
    /* El CTA no debe quedar pegado al scrollbar ni recortarse. */
    padding-inline-end: max(0.5rem, env(safe-area-inset-right));
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .hdr__brand,
  .hdr__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 1rem;
    flex: 0 0 auto;
    border-left: var(--hairline) solid var(--line);
    color: var(--muted);
    transition: color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .hdr__brand {
    padding-inline: 1.25rem;
    border-left: 0;
    border-right: var(--hairline) solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .hdr__cell:hover {
    color: var(--ink);
  }

  .hdr__nav {
    display: none;
    align-items: stretch;
    border-left: var(--hairline) solid var(--line);
  }

  .hdr__link {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    padding-inline: 1rem;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: var(--muted);
    border-right: var(--hairline) solid var(--line);
    text-decoration: none;
    transition: color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .hdr__link:hover {
    color: var(--ink);
  }

  .hdr__link.is-active {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .hdr__spacer {
    flex: 1 1 auto;
  }

  .hdr__cta {
    display: none;
    align-items: center;
    gap: 0.5rem;
    flex: 0 0 auto;
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
    padding-inline: 1.5rem;
    background: var(--invert-bg);
    color: var(--invert-fg);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    white-space: nowrap;
    text-decoration: none;
    border-left: var(--hairline) solid var(--line);
    transition: background var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .hdr__cta:hover {
    background: var(--accent);
    color: #fff;
  }

  .i-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .i-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .i-sun {
    display: block;
  }

  .hdr__panel {
    display: none;
    flex-direction: column;
    border-top: var(--hairline) solid var(--line);
    background: var(--bg);
  }

  .hdr.is-open .hdr__panel {
    display: flex;
  }

  .hdr__panel-link {
    padding: 0.875rem 1rem;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    border-bottom: var(--hairline) solid var(--line);
    text-decoration: none;
  }

  .hdr__panel-link.is-active {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .hdr__panel-link.highlight {
    color: var(--muted);
  }

  @media (min-width: 48em) {
    .hdr__bar {
      height: var(--nav-height, 3.0625rem);
    }

    .hdr__nav {
      display: flex;
    }

    .hdr__burger {
      display: none;
    }

    .hdr__panel {
      display: none !important;
    }

    .hdr__cta {
      display: flex;
    }
  }
</style>
