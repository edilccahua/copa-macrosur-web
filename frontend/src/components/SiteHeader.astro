---
/**
 * SiteHeader.astro — cabecera oficial de Kúspide MTB.
 *
 * Estructura tomada de getartcraft.com (medida en vivo, no de memoria):
 *   marca │ GRUPO │ [iconos]
 *   - la marca es el LOGO (un icono, no un item de menú). "KÚSPIDE" e
 *     "INICIO" llevan a la portada, pero el que se marca como activo es
 *     "INICIO";
 *   - los items van en mono, versalitas, tracking 0.15em;
 *   - el item activo se invierte (pastilla) y lleva `aria-current`;
 *   - los grupos se separan con un hairline vertical.
 *
 * La cabecera **persiste** entre navegaciones (`transition:persist`): el
 * router de Astro reutiliza este mismo elemento, así que la entrada de la
 * barra —que es una animación CSS— ocurre UNA sola vez por sesión y NO se
 * repite al cambiar de página.
 */
import { NAV_GROUPS, CONTACT_WHATSAPP } from '../lib/nav';
import { isActivePath } from '../lib/nav';

const path = Astro.url.pathname;
---

<header class="hdr" id="site-header" transition:persist="site-header">
  <div class="hdr__bar">
    <a class="hdr__brand" href="/" aria-label="Kúspide MTB — Campeonato 2026">
      <span class="brand-text">KÚSPIDE</span>
    </a>

    <nav class="hdr__nav" aria-label="Navegación principal">
      {
        NAV_GROUPS.map((group) => (
          <div class:list={['hdr__group', { 'hdr__group--sep': group.separated }]}>
            {group.items.map((item) => (
              <a
                class:list={['hdr__link', { 'is-active': isActivePath(path, item) }]}
                href={item.href}
                data-nav-match={item.match.join('|')}
                data-nav-anchor={item.anchor ? 'true' : undefined}
                aria-current={isActivePath(path, item) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        ))
      }
    </nav>

    <div class="hdr__right">
      <div class="hdr__cell hdr__cell--hide-sm">
        <a
          href={CONTACT_WHATSAPP.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contacto WhatsApp"
          title={`WhatsApp oficial Kúspide: ${CONTACT_WHATSAPP.phone}`}
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.5 8.5 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </a>
      </div>

      <div class="hdr__cell">
        <button id="theme-toggle" type="button" aria-label="Conmutar tema">
          <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" fill="none" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
          <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </button>
      </div>

      <button class="hdr__cell hdr__burger" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Menú">
        <svg class="i-bars" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg class="i-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="hdr__panel" id="nav-panel">
    {
      NAV_GROUPS.map((group) =>
        group.items.map((item) => (
          <a
            class:list={['hdr__panel-link', { 'is-active': isActivePath(path, item) }]}
            href={item.href}
            data-nav-match={item.match.join('|')}
            data-nav-anchor={item.anchor ? 'true' : undefined}
            aria-current={isActivePath(path, item) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      )
    }
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: var(--hairline) solid var(--line);
  }

  /* Tres columnas: marca │ menú (centrado) │ iconos. El menú lleva espacio a
     los dos lados para quedar centrado en el hueco que le queda. */
  .hdr__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    box-sizing: border-box;
    min-width: 0;
    height: var(--nav-height-mobile, 3rem);
    padding-inline-end: max(0.5rem, env(safe-area-inset-right));
  }

  /* ── Entrada de la barra ────────────────────────────────────────────────
     La animación vive en CSS, no en JS: el estado inicial está en la hoja de
     estilos, así que no hay destello (el contenido no se pinta visible antes
     de ocultarse) y no depende de que GSAP haya cargado. Como la cabecera
     PERSISTE entre navegaciones, el elemento se crea una sola vez y la
     animación ocurre una vez por sesión. */
  @keyframes hdr-item-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hdr__bar > * {
    animation: hdr-item-in 0.45s var(--ease-out) both;
    animation-delay: calc(var(--hdr-intro-delay, 0.05s) + var(--hdr-intro-stagger, 0.05s) * var(--i, 0));
  }

  .hdr__bar > :nth-child(1) { --i: 0; }
  .hdr__bar > :nth-child(2) { --i: 1; }
  .hdr__bar > :nth-child(3) { --i: 2; }

  /* Una vez que la entrada ha terminado, la animación se DESACTIVA.
     Motivo: al navegar, el router reinserta la cabecera persistente en el
     body nuevo y eso reinicia las animaciones CSS del elemento: la barra
     desaparecía y volvía a entrar en cada clic. Con esta clase, la
     animación ocurre UNA vez por sesión (al cargar) y nunca más. */
  .hdr.is-ready .hdr__bar > * {
    animation: none;
    opacity: 1;
    transform: none;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--ink);
    white-space: nowrap;
  }

  /* La marca: como el icono de artcraft, es el logo. Un separador vertical
     la separa del menú. */
  .hdr__brand {
    display: flex;
    align-items: center;
    padding-inline: 1.25rem;
    border-right: var(--hairline) solid var(--line);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .hdr__right {
    display: flex;
    align-items: stretch;
  }

  .hdr__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 0.875rem;
    flex: 0 0 auto;
    border-left: var(--hairline) solid var(--line);
    color: var(--muted);
    transition: color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .hdr__cell:hover {
    color: var(--ink);
  }

  .hdr__nav {
    display: none;
    align-items: stretch;
    justify-content: center;
    min-width: 0;
    /* Espacio al principio y al final: el menú queda centrado en el hueco
       que le dejan la marca y los iconos. */
    padding-inline: 1.5rem;
  }

  /* Grupos separados por un hairline vertical, como en getartcraft.com
     (`<li class="border-l border-line ml-1.5 pl-1.5">`). */
  .hdr__group {
    display: flex;
    align-items: stretch;
  }

  .hdr__group--sep {
    margin-left: 0.5rem;
    padding-left: 0.5rem;
    border-left: var(--hairline) solid var(--line);
  }

  .hdr__link {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    padding-inline: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    white-space: nowrap;
    color: var(--muted);
    text-decoration: none;
    transition:
      color var(--default-transition-duration) var(--default-transition-timing-function),
      background-color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  /* La pastilla invertida: el activo y el que tiene el puntero encima. */
  .hdr__link:hover,
  .hdr__link.is-active {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .i-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .i-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .i-sun {
    display: block;
  }

  .i-close {
    display: none;
  }

  .hdr.is-open .i-bars {
    display: none;
  }

  .hdr.is-open .i-close {
    display: block;
  }

  .hdr__panel {
    display: none;
    flex-direction: column;
    border-top: var(--hairline) solid var(--line);
    background: var(--bg);
  }

  .hdr.is-open .hdr__panel {
    display: flex;
  }

  .hdr__panel-link {
    padding: 0.875rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    border-bottom: var(--hairline) solid var(--line);
    text-decoration: none;
  }

  .hdr__panel-link.is-active {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  /* ── Móvil ─────────────────────────────────────────────────────────────── */
  @media (max-width: 47.99em) {
    /* El contacto de WhatsApp vive en el pie (en móvil la barra se queda
       con lo esencial). */
    .hdr__cell--hide-sm {
      display: none;
    }

    .hdr__brand {
      padding-inline: 0.875rem;
    }

    .brand-text {
      font-size: 0.75rem;
    }
  }

  @media (min-width: 48em) {
    .hdr__bar {
      height: var(--nav-height, 3.0625rem);
    }

    .hdr__nav {
      display: flex;
    }

    .hdr__burger {
      display: none;
    }

    .hdr__panel {
      display: none !important;
    }
  }
</style>
