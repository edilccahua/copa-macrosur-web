---
/**
 * GhostWord.astro — el rótulo fantasma de la esquina superior derecha.
 *
 * Presente en el original en las tres páginas, recortado por el borde:
 * `ARTCRAFT` en la home, `CRAFTING APPS` en /apps, `PRICING` en /pricing.
 * Va por detrás del contenido y no es interactivo.
 */
interface Props {
  text: string;
}

const { text } = Astro.props;
---
<div class="ghost" aria-hidden="true">{text}</div>

<style>
  .ghost {
    display: none;
  }

  @media (min-width: 48em) {
    .ghost {
      display: block;
      position: absolute;
      top: 2.75rem;
      right: 0;
      z-index: 0;
      pointer-events: none;
      font-family: var(--font-display);
      font-size: clamp(2rem, 4.5vw, 4rem);
      font-weight: 620;
      font-stretch: 118%;
      letter-spacing: -0.04em;
      line-height: 0.9;
      white-space: nowrap;
      color: var(--ink);
      /* Rótulo fantasma atenuado (marca de agua). */
      transform: translateX(4%);
      opacity: 0.04;
    }
  }</style>
