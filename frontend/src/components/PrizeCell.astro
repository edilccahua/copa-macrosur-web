---
/**
 * PrizeCell.astro — la celda de los premios.
 *
 * Es LA gramática de la página: los premios y las notas se muestran con esta
 * misma celda. Es la tabla de principios de la referencia
 * (`copiaartcraft/src/pages/apps.astro`, y `/apps` en vivo): una grilla con
 * filetes de 1px, sin tarjeta propia, y una anatomía fija por celda:
 *
 *   emblema · índice  →  titular  →  regla  →  la cifra y su estado
 *
 * La grilla dibuja los filetes con `gap: 1px` sobre su propio fondo, y las
 * celdas lo tapan con el fondo de la página: por eso la tabla no es un
 * mosaico de cajas sino UNA rejilla.
 *
 * En una celda ANCHA (la de un premio que ocupa media página) el contenido se
 * parte en dos columnas —la identidad a la izquierda, el dato a la derecha—
 * para que el texto ocupe el ancho en vez de quedarse pegado a un lado. Se
 * decide por **container query**: la celda se mide a sí misma, no la
 * página.
 */
import Icon from './Icon.astro';
import type { IconName } from './Icon.astro';
import Podium from './Podium.astro';
import type { PodiumStep } from './Podium.astro';
import type { PrizePosition } from '../data/prizes';

/** Un peldaño del podio: el puesto, su cifra y quién lo lleva (si el premio
 * es acumulado y el campeonato sigue abierto). */
export interface PrizePodiumStep extends PodiumStep {
  position: PrizePosition;
}

interface Props {
  /** Etiqueta de cabecera, para las celdas que son una nota. */
  label?: string;
  /** Icono del ámbito. */
  icon?: IconName;
  /** Logotipo del patrocinador, en lugar de icono. */
  logo?: string;
  logoAlt?: string;
  /** Titular del premio. */
  title?: string;
  /** Regla del premio. */
  body?: string;
  /** Etiquetas de detalle (las 11 categorías). */
  notes?: string[];
  /**
   * El podio del premio: los tres peldaños con su medalla. Es la forma de
   * leer un premio con tres puestos en la casa (la misma que usa
   * `PodiumPanel` para las clasificaciones).
   */
  podium?: PrizePodiumStep[];
  /** La cifra del premio, cuando es una sola (Premio CLARO, títulos). */
  amount?: string;
  /** Etiqueta del estado: qué pasa con el premio. */
  state?: string | null;
  /** El dato del estado: el nombre de quien lo lleva. */
  value?: string | null;
  /** Detalle del estado. */
  detail?: string | null;
}

const {
  label,
  icon,
  logo,
  logoAlt,
  title,
  body,
  notes = [],
  podium,
  amount,
  state,
  value,
  detail,
} = Astro.props;
---

<article class="cell">
  <header class="cell__head">
    {
      logo ? (
        <span class="cell__emblem cell__emblem--logo">
          <img src={logo} alt={logoAlt ?? ''} loading="lazy" />
        </span>
      ) : icon ? (
        <span class="cell__emblem">
          <Icon name={icon} size={20} />
        </span>
      ) : label ? (
        <span class="cell__label font-mono">{label}</span>
      ) : null
    }
  </header>

  <div class="cell__main">
    <div class="cell__titleRow">
      {title && <h3 class="cell__title">{title}</h3>}
      {/*
        El premio único va como un STICKER en la esquina: una sola cifra no
        necesita un podio, necesita una pegatina. Con dos o tres peldaños
        (abajo) la cifra se dibuja sobre su escalón.
      */}
      {amount && !podium && <span class="cell__sticker font-mono">{amount}</span>}
    </div>
    {body && <p class="cell__body">{body}</p>}
    {notes.length > 0 && <p class="cell__notes font-mono">{notes.join(' · ')}</p>}
  </div>

  {
    (podium || amount || state || value || detail) && (
      <div class="cell__data">
        {podium && (
          <Podium steps={podium} holders={podium.some((step) => step.holder)} />
        )}
        {state && <p class="cell__state font-mono">{state}</p>}
        {value && <p class="cell__value font-mono">{value}</p>}
        {detail && <p class="cell__detail font-mono">{detail}</p>}
      </div>
    )
  }
</article>

<style>
  .cell {
    /* Una sola tinta para TODA la página de premios: el oro de la copa.
       Los colores de ámbito (azul de PRO, verde de NORMAL) viven en las
       clasificaciones, donde identifican una pestaña; en los premios sólo
       distinguirían dos tarjetas que ya se distinguen por su titular. */
    --cell-accent: var(--copa-gold);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    /* Tapa el fondo de la grilla: lo que se ve entre celdas es el filete. */
    background: var(--bg);
    /* La celda se mide a sí misma para decidir su propia composición. */
    container-type: inline-size;
  }

  .cell__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.25rem;
  }

  .cell__emblem {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
    background: var(--bg-sunken);
    border: var(--hairline) solid var(--line);
    color: var(--cell-accent);
  }

  /* El logotipo va a su proporción: la caja se ensancha, la altura no. */
  .cell__emblem--logo {
    width: auto;
    min-width: 2.25rem;
    padding: 0.375rem 0.625rem;
    background: #fff;
  }

  .cell__emblem img {
    display: block;
    width: auto;
    height: auto;
    max-height: 1.5rem;
  }

  .cell__label {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .cell__titleRow {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .cell__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 620;
    font-stretch: 118%;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink-strong);
  }

  /* El sticker del premio único: la cifra, en una pegatina. */
  .cell__sticker {
    flex: 0 0 auto;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--bg);
    background: var(--cell-accent);
    transform: rotate(-2.5deg);
  }

  .cell__body {
    margin: 0;
    max-width: 58ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  /* La lista de categorías va en una línea, no en once cajas: el dato se
     lee de un vistazo y la celda no crece. */
  .cell__notes {
    margin: 0.5rem 0 0;
    font-size: 0.625rem;
    line-height: 1.6;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .cell__data {
    margin-top: auto;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
  }

  .cell__amount {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: var(--cell-accent);
  }

  .cell__state {
    margin: 0.5rem 0 0;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* Tras el podio, el estado va en su propia banda: si no, se lee como
     parte del peldaño. */
  .cell__data:has(.podium) .cell__state {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: var(--hairline) solid var(--line);
  }

  .cell__value {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .cell__detail {
    margin: 0.25rem 0 0;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  /* ── La celda ancha: identidad a la izquierda, dato a la derecha ───────
     Sólo la celda que ocupa la página entera (el Premio CLARO) se parte en
     dos columnas. Las que van en una tabla de dos o cuatro caben con el
     texto en una sola columna, como las celdas de la referencia.

     La medida la decide la celda (container query), no la página: la misma
     celda se parte si la pista es ancha y se queda apilada si es estrecha. */
  @container (min-width: 42rem) {
    .cell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'head head'
        'main data';
      column-gap: 2.5rem;
      align-items: start;
    }

    .cell__head {
      grid-area: head;
    }

    .cell__main {
      grid-area: main;
    }

    .cell__data {
      grid-area: data;
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
      align-self: end;
    }
  }
</style>
