---
/**
 * SiteFooter.astro — pie de página oficial de Kúspide MTB.
 * Estructura y escala portadas de copiaartcraft/src/components/SiteFooter.astro
 */
---
<footer class="ftr">
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand">
        <div class="ftr__logo">KÚSPIDE</div>
        <p class="ftr__tagline">
          La Copa MacroSur MTB — Edición 2026 Kúspide. Organizado por <strong>Kúspide Xtreme Sports</strong>. Cronometraje electrónico, clasificaciones por categoría y Copa de Equipos en Arequipa.
        </p>
        <div class="ftr__contacts font-mono">
          <span>INFORMES WHATSAPP:</span>
          <a class="ftr__phone" href="https://wa.me/51994382248" target="_blank" rel="noopener noreferrer">994 382 248</a>
          <span class="ftr__sep">·</span>
          <a class="ftr__phone" href="https://wa.me/51980081335" target="_blank" rel="noopener noreferrer">980 081 335</a>
        </div>
      </div>

      <div class="ftr__cols">
        <div class="ftr__col">
          <h3 class="ftr__col-title">Calendario MTB</h3>
          <ul>
            <li><a href="/fechas/la-joya-extreme">La Joya · 17 May</a></li>
            <li><a href="/fechas/z-xtreme-2026">Z Xtreme · 23 Ago</a></li>
            <li><a href="/fechas/vuelta-a-los-poblados">Poblados · 25 Oct</a></li>
            <li><a href="/fechas/quequena-xtreme">Quequeña · 13 Dic</a></li>
            <li><a href="/eventos-especiales"><strong>Eventos de Ruta Extra →</strong></a></li>
          </ul>
        </div>

        <div class="ftr__col">
          <h3 class="ftr__col-title">Competición</h3>
          <ul>
            <li><a href="/ranking-general">Ranking acumulado</a></li>
            <li><a href="/en-vivo">Cronómetro en vivo</a></li>
            <li><a href="/fechas/la-joya-extreme/resultados">Resultados oficiales</a></li>
            <li><a href="/ranking-general">Copa de equipos</a></li>
          </ul>
        </div>

        <div class="ftr__col">
          <h3 class="ftr__col-title">Organización</h3>
          <ul>
            <li><a href="/inscripciones">Inscripciones</a></li>
            <li><a href="/reclamos">Buzón de reclamos</a></li>
            <li><a href="/admin/juez">Panel del juez</a></li>
            <li><a href="/admin">Administración</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="ftr__bottom">
      <span>© 2026 Kúspide MTB</span>
      <span>Copa Macrosur MTB · Arequipa, Perú</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    border-top: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    padding-block: 3rem 1.5rem;
  }

  .ftr__top {
    display: grid;
    gap: 2.5rem;
  }

  .ftr__logo {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 750;
    font-stretch: 125%;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .ftr__tagline {
    margin-top: 0.75rem;
    max-width: 30ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .ftr__contacts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .ftr__phone {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .ftr__phone:hover {
    color: var(--accent);
  }

  .ftr__sep {
    color: var(--hairline-strong);
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .ftr__col-title {
    margin-bottom: 0.75rem;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .ftr__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ftr__col li + li {
    margin-top: 0.375rem;
  }

  .ftr__col a {
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
  }

  .ftr__col a:hover {
    color: var(--ink);
  }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  @media (min-width: 48em) {
    .ftr__top {
      grid-template-columns: 1fr 1.4fr;
    }

    .ftr__cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
