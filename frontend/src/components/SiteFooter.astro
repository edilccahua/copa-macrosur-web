---
/**
 * SiteFooter.astro — pie de página oficial de Kúspide MTB.
 * Estructura y escala portadas de copiaartcraft/src/components/SiteFooter.astro
 *
 * El calendario se lee de la API (no se escribe a mano): antes el pie
 * repetía las fechas en literal y mentía en cuanto el organizador movía
 * una carrera. Tampoco hay enlaces de administración ni al panel del juez:
 * el sitio público no expone herramientas internas.
 */
import { getStages, formatStageDateShort } from '../lib/stages';

const stages = await getStages();
---
<footer class="ftr">
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a class="ftr__logo" href="/">COPA MACROSUR MTB</a>
        <p class="ftr__tagline">
          La Copa MacroSur MTB — Edición 2026. Organizado por <strong>Kuspide Xtreme Sports</strong>. Cronometraje electrónico, clasificaciones por categoría y Copa de Equipos en Arequipa.
        </p>
        <div class="ftr__contacts font-mono">
          <span>INFORMES WHATSAPP:</span>
          <a class="ftr__phone" href="https://wa.me/51994382248" target="_blank" rel="noopener noreferrer">994 382 248</a>
          <span class="ftr__sep">·</span>
          <a class="ftr__phone" href="https://wa.me/51980081335" target="_blank" rel="noopener noreferrer">980 081 335</a>
        </div>
      </div>

      <div class="ftr__cols">
        <div class="ftr__col">
          <h3 class="ftr__col-title">Calendario MTB</h3>
          <ul>
            {
              stages.map((s) => (
                <li>
                  <a href={`/fechas/${s.slug}`}>
                    {s.name.replace(/^Fecha\s+\d+\s*:\s*/i, '')} · {formatStageDateShort(s.date)}
                  </a>
                </li>
              ))
            }
            <li><a href="/eventos-especiales"><strong>Eventos de Ruta Extra →</strong></a></li>
          </ul>
        </div>

        <div class="ftr__col">
          <h3 class="ftr__col-title">Competición</h3>
          <ul>
            <li><a href="/ranking-general">Clasificaciones</a></li>
            <li><a href="/ranking-general?tabla=EQUIPO">Copa de Equipos</a></li>
            <li><a href="/ranking-general?modo=fecha">Resultados por fecha</a></li>
            <li><a href="/en-vivo">Cronómetro en vivo</a></li>
            <li><a href="/premios">Premios</a></li>
          </ul>
        </div>

        <div class="ftr__col">
          <h3 class="ftr__col-title">Organización</h3>
          <ul>
            <li><a href="/inscripciones">Inscripciones</a></li>
            <li><a href="/reclamos">Buzón de reclamos</a></li>
            <li><a href="/eventos-especiales">Clásicas de ruta</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="ftr__bottom">
      <span>© 2026 Copa MacroSur MTB</span>
      <span>Copa Macrosur MTB · Arequipa, Perú</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    border-top: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    padding-block: 3rem 1.5rem;
  }

  .ftr__top {
    display: grid;
    gap: 2.5rem;
  }

  .ftr__logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 750;
    font-stretch: 125%;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }

  .ftr__logo:hover {
    color: var(--accent);
  }

  .ftr__tagline {
    margin-top: 0.75rem;
    max-width: 30ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .ftr__contacts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .ftr__phone {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .ftr__phone:hover {
    color: var(--accent);
  }

  .ftr__sep {
    color: var(--hairline-strong);
  }

  .ftr__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .ftr__col-title {
    margin-bottom: 0.75rem;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .ftr__col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ftr__col li + li {
    margin-top: 0.375rem;
  }

  .ftr__col a {
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
  }

  .ftr__col a:hover {
    color: var(--ink);
  }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  @media (min-width: 48em) {
    .ftr__top {
      grid-template-columns: 1fr 1.4fr;
    }

    .ftr__cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
