---
/**
 * StageStatsRow.astro — las cifras de la jornada de una fecha.
 *
 * Muestra lo que el backend calculó (`GET /stages/{slug}/summary` → `stats`):
 * inscripciones, finalizados, no finalizados, puntos, velocidad del ganador y
 * número de categorías. Una fecha que aún no se ha disputado no tiene cifras:
 * se dice con palabras, no con ceros falsos.
 */
import type { StageStats } from '../lib/api';
import Icon from './Icon.astro';

interface Props {
  stats: StageStats;
}

const { stats } = Astro.props;

const undisclosed = stats.entries_total === 0;

/**
 * `non_finishers` solo cuenta abandonos cuando la fecha ya se ha disputado.
 * En una fecha con inscripción abierta no hay abandonos: hay gente que
 * todavía no corre, y la cifra se rotula distinto para no mentir.
 */
const nonFinishersLabel =
  stats.non_finishers > 0 ? 'NO FINALIZARON' : 'AÚN NO COMPITEN';

/** El tipo de los iconos, para que TS no lo infiera como `string`. */
type IconName =
  | 'users'
  | 'flag'
  | 'endurance'
  | 'trophy'
  | 'bolt'
  | 'bike';

const cells: { label: string; value: string; icon: IconName }[] = [
  { label: 'INSCRITOS', value: undisclosed ? '—' : String(stats.entries_total), icon: 'users' },
  { label: 'FINALIZARON', value: undisclosed ? '—' : String(stats.finishers), icon: 'flag' },
  { label: nonFinishersLabel, value: undisclosed ? '—' : String(stats.non_finishers), icon: 'endurance' },
  { label: 'PUNTOS', value: undisclosed ? '—' : String(stats.points_total), icon: 'trophy' },
  {
    label: 'VEL. GANADOR',
    value: stats.winner_avg_speed_kmh != null ? `${stats.winner_avg_speed_kmh} KM/H` : '—',
    icon: 'bolt',
  },
  { label: 'CATEGORÍAS', value: undisclosed ? '—' : String(stats.categories_count), icon: 'bike' },
];

/**
 * Lo que PUBLICA el PDF oficial frente a lo que recalcula el motor.
 *
 * Normalmente coinciden. En la Fecha 2 no: el PDF no imprime el 6º lugar de
 * OPEN DAMAS, así que publica 554 puntos y el motor, al rellenar el hueco,
 * reparte 555. Cuando difieren, la ficha enseña los dos números y explica por
 * qué: el del organizador y el del motor, sin que nadie tenga que fiarse de
 * una cifra que no aparece en el documento oficial.
 */
const officialDiffers =
  !undisclosed &&
  stats.official_points != null &&
  stats.official_points !== stats.points_total;
---

{
  undisclosed ? (
    <p class="stats__pending font-mono">
      [ CIFRAS DE JORNADA — DISPONIBLES AL CERRAR LA FECHA ]
    </p>
  ) : (
    <dl class="stats">
      {cells.map((cell) => (
        <div class="stats__cell">
          <dt class="stats__label font-mono">
            <Icon name={cell.icon} size={12} class="stats__icon" />
            {cell.label}
          </dt>
          <dd class="stats__value font-mono">{cell.value}</dd>
        </div>
      ))}
    </dl>
  )
}

{
  officialDiffers && (
    <p class="stats__note font-mono">
      [ PUNTOS: {stats.official_points} EN EL PDF OFICIAL · {stats.points_total} TRAS EL
      RECÁLCULO DEL MOTOR ] El PDF oficial no imprime el 6º lugar de Open Damas: al
      rellenar el hueco, el motor reparte un punto más.
    </p>
  )
}

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    margin: 1.5rem 0 0;
    border-top: var(--hairline) solid var(--line);
    border-left: var(--hairline) solid var(--line);
  }

  .stats__cell {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.125rem;
    border-right: var(--hairline) solid var(--line);
    border-bottom: var(--hairline) solid var(--line);
    background: var(--bg-raised);
  }

  .stats__label {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .stats__icon {
    flex: 0 0 auto;
    color: var(--accent);
  }

  .stats__value {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 620;
    font-variant-numeric: tabular-nums;
    color: var(--ink-strong);
    line-height: 1.1;
  }

  .stats__pending {
    margin: 1.5rem 0 0;
    padding: 1rem 1.25rem;
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* La nota de los puntos: solo aparece cuando el PDF oficial y el motor no
     coinciden. Va en el mismo tono que el resto de las etiquetas. */
  .stats__note {
    margin: 0.75rem 0 0;
    padding: 0.75rem 1rem;
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
