---
/**
 * HeroWordmark.astro — el rótulo del hero, letra por letra.
 *
 * Medido del original (`tools/probe-wordmark.mjs`):
 *   font-family Archivo · 95.4px · peso 850 · font-stretch 125% · oblicuo
 *   color #000 · letras en `inline-block`, cada una con su ancho
 *   rect 672×95 centrado en un viewport de 1440
 *
 * La animación la aplica `src/scripts/showcase-motion.ts` con los tiempos del
 * `introTuner` del original:
 *   wordAt 0.35 · wordDur 0.85 · copyAt 1.05 · instrAt 0.70
 *
 * Tinta de carrera: el oblicuo y la sombra del acento salen de los pósters
 * de `races/info/` (Z Xtreme / cartel madre): `MTB` en amarillo de carrera
 * con borde y sombra dura negra, levemente rotado como una cinta.
 * El `skew`/`rotate` van en la LÍNEA: GSAP anima cada `[data-letter]`.
 *
 * La animación la aplica `src/scripts/showcase-motion.ts` con los tiempos del
 * `introTuner` del original:
 *   wordAt 0.35 · wordDur 0.85 · copyAt 1.05 · instrAt 0.70
 *
 * PALABRAS: el rótulo del campeonato tiene DOS palabras ("COPA MACROSUR").
 * La referencia original es de una sola ("ARTCRAFT"), así que aquí cada palabra
 * es un bloque y el espacio va en el `column-gap` del contenedor: si el
 * espacio fuese un `<span>` más, el colapso de espacios en línea lo borraría
 * y se leería "COPAMACROSUR".
 *
 * El bloque de palabras lleva `flex-wrap`: en pantallas estrechas el rótulo
 * baja a dos líneas en vez de desbordar (el ancho de una línea no se controla
 * con el tamaño de letra, sino con el salto de línea).
 */
interface Props {
  text?: string;
  /**
   * Palabra que va en el amarillo de carrera. En los pósters oficiales "MTB" y
   * "EDICIÓN 2026" son las únicas palabras en amarillo: es el color que
   * distingue a la copa, y el que hace que el hero no sea un bloque
   * monocromo. Si la palabra no aparece en `text`, no se marca nada.
   */
  accent?: string;
}

const { text = 'ARTCRAFT', accent } = Astro.props;

/**
 * Palabras y letras, con un índice GLOBAL para la animación (la secuencia de
 * entrada es continua entre palabras). Se calcula aquí y no en la plantilla
 * para que el índice no dependa del orden de render.
 *
 * La palabra de acento va SIEMPRE en su propia línea: así el lockup es el
 * mismo en cualquier ancho. Si dependiera del ancho, el rótulo saltaría de
 * una línea a dos al cruzar un punto de inflexión, y el salto se vería.
 */
const words = text.split(' ').filter(Boolean);
const accentIndex = accent ? words.indexOf(accent) : -1;

const mainWords = accentIndex >= 0 ? words.filter((_, i) => i !== accentIndex) : words;
const accentWords = accentIndex >= 0 ? [words[accentIndex]] : [];

/** Un bloque de palabras: cada letra con su índice global. */
const blocks = [
  { words: mainWords, accent: false },
  { words: accentWords, accent: true },
].filter((block) => block.words.length > 0);

let letterIndex = 0;
---
<div class:list={['wordmark', accentIndex >= 0 && 'wordmark--stacked']} data-hero-wordmark aria-hidden="true">
  {
    blocks.map((block) => (
      <span class:list={['wordmark__line', block.accent && 'wordmark__line--accent']}>
        {block.words.map((word) => (
          <span class="wordmark__word">
            {[...word].map((letter) => (
              <span class="wordmark__letter" data-letter={letterIndex++}>{letter}</span>
            ))}
          </span>
        ))}
      </span>
    ))
  }
</div>

<style>
  .wordmark {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.22em;
    font-family: var(--font-display);
    /* El máximo es el valor medido; por debajo se adapta. */
    font-size: clamp(2.5rem, 12vw, 95.4px);
    /* Tinta de carrera (pósters `races/info/`): negro pesado y oblicuo.
       El `italic` cae a oblicua sintética (solo se importa Archivo upright
       para no pesar en `/en-vivo`); el `skew` va en la LÍNEA, no en la letra,
       para no pelear con la intro de GSAP que anima `[data-letter]`. */
    font-weight: 850;
    font-style: italic;
    font-stretch: 125%;
    letter-spacing: -0.02em;
    line-height: 0.94;
    color: var(--ink-strong);
    user-select: none;
  }

  .wordmark__word {
    display: inline-flex;
  }

  /* Con palabra de acento el rótulo se apila: la línea principal y, debajo,
     la palabra de acento. Es el lockup del póster oficial. */
  .wordmark--stacked {
    flex-direction: column;
    align-items: center;
    row-gap: 0.06em;
  }

  .wordmark__line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.22em;
    /* Oblicuo de velocidad del póster. En el contenedor: GSAP escribe
       `transform` en cada `[data-letter]`, aquí no hay conflicto. */
    transform: skewX(-6deg);
  }

  /* La palabra de acento: el "MTB" del rótulo va en el amarillo de carrera
     de los pósters (`--copa-race`), con borde y sombra dura negra para que
     se lea sobre la cordillera en claro y en oscuro. Ligera rotación de
     cinta, como la de `Z Xtreme`. */
  .wordmark__line--accent {
    color: var(--copa-race);
    -webkit-text-stroke: 1.5px var(--copa-carbon);
    paint-order: stroke fill;
    text-shadow:
      3px 3px 0 var(--copa-carbon),
      -1px -1px 0 var(--copa-carbon);
    transform: skewX(-6deg) rotate(-2deg);
  }

  .wordmark__letter {
    display: inline-block;
    will-change: transform;
  }

  /* En móvil el rótulo baja a dos líneas: dos palabras de 4 y 8 letras a
     12vw no caben en 390 px, y una sola línea se saldría del papel. */
  @media (max-width: 47.99em) {
    .wordmark {
      font-size: clamp(2.25rem, 11.5vw, 4.5rem);
      line-height: 0.92;
    }
  }
</style>
