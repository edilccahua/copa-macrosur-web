---
/**
 * StageLeaderboard.astro — el leaderboard de podio por categoría.
 *
 * Una fila por categoría, compacta: el nombre de la categoría y los tres
 * ganadores con su club. Sin dorsal, sin tiempo y sin puntos: el detalle
 * completo está en el ranking, en modo FECHA
 * (`/ranking-general?modo=fecha&tabla=PRO&categoria=ELI&fecha=<n>`).
 *
 * El puesto NO es un número: es una MEDALLA (oro, plata, bronce), la misma
 * pieza que usa Strava en sus clasificaciones. La geometría vive en
 * `src/assets/medals/medal-N.svg` y la dibuja `MedalIcon.astro`, que la
 * inserta en línea para que herede el color del token `--podium-N` y para
 * que el número calado deje ver el fondo de la página.
 *
 * El acento de cada categoría es el de su grupo (PRO / NORMAL / E-BIKE) y se
 * ve al pasar el ratón por encima: el título toma el color del grupo.
 */
import type { CategoryPodium } from '../lib/api';
import MedalIcon from './MedalIcon.astro';

interface Props {
  podium: CategoryPodium[];
  id?: string;
}

const { podium, id } = Astro.props;

/**
 * El acento de la categoría sale de su grupo: PRO, NORMAL o E-BIKE. Los
 * grupos del backend se mapean a las clases `scope-*` de `tokens.css`, que
 * ya definen el par `--scope` / `--scope-ink` de cada uno.
 */
const SCOPE_CLASS: Record<string, string> = {
  PRO: 'scope-pro',
  NORMAL: 'scope-normal',
  'E-BIKE': 'scope-ebike',
};
const groupClass = (group: string) => SCOPE_CLASS[group] ?? 'scope-pro';
---

<div class="leaderboard" id={id}>
  {
    podium.map((category) => (
      <section class={`cat ${groupClass(category.group)}`}>
        <header class="cat__head">
          <span class="cat__name">{category.category_name}</span>
        </header>

        <ol class="cat__podium">
          {category.entries.map((entry) => (
            <li class="cat__row" data-rank={entry.rank}>
              <MedalIcon rank={entry.rank as 1 | 2 | 3} size={18} class="cat__medal" />
              <a class="cat__rider" href={`/corredor/${entry.rider_slug}`}>
                {entry.rider_name}
              </a>
              <span class="cat__team">
                {entry.team_slug ? (
                  <a href={`/equipos/${entry.team_slug}`}>{entry.team_name}</a>
                ) : (
                  entry.team_name
                )}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .leaderboard {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 0 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 3.5rem;
    border-top: var(--hairline) solid var(--line);
  }

  .cat {
    padding: 0.875rem 0;
    border-bottom: var(--hairline) solid var(--line);
    min-width: 0;
  }

  /* El acento por grupo vive en `tokens.css` (`.scope-pro`, `.scope-normal`,
     `.scope-ebike`), que define `--scope` (color vivo) y `--scope-ink` (su
     variante legible). Aquí solo se consume. */

  .cat__head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }

  /* Solo el título de la categoría: el código corto (EBK, ELI, MSA…) ya no
     acompaña, y el color del grupo aparece al pasar el ratón.
     El título NO es blanco como el resto del texto: va en la tipografía
     display, con más cuerpo y con el acento del grupo (PRO / NORMAL /
     E-BIKE) para que se lea de un vistazo qué categoría es cuál y se
     distinga de los nombres de los corredores, que van en tinta neutra. */
  .cat__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 680;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--scope-ink, var(--ink-strong));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  .cat:hover .cat__name {
    color: var(--scope, var(--ink-strong));
  }

  .cat__podium {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cat__row {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    grid-template-areas:
      'medal rider'
      'medal team';
    align-items: baseline;
    column-gap: 0.5rem;
    padding: 0.2rem 0;
  }

  /* La medalla va arriba, alineada con el nombre del corredor. */
  .cat__medal {
    grid-area: medal;
    align-self: start;
    margin-top: 0.0625rem;
  }

  .cat__rider {
    grid-area: rider;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  .cat__row[data-rank='1'] .cat__rider {
    color: var(--ink-strong);
  }

  .cat:hover .cat__row[data-rank='1'] .cat__rider {
    color: var(--scope-ink, var(--ink-strong));
  }

  .cat__rider:hover {
    color: var(--scope-ink, var(--ink-strong));
  }

  .cat__team {
    grid-area: team;
    font-size: 0.6875rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat__team a {
    color: inherit;
    text-decoration: none;
  }

  .cat__team a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15rem;
  }
</style>
