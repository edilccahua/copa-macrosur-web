---
/**
 * StageLeaderboard.astro — el leaderboard de podio por categoría.
 *
 * Una fila por categoría, compacta: el nombre de la categoría y los tres
 * ganadores con su club. Sin dorsal, sin tiempo y sin puntos: el detalle
 * completo está en el ranking, en modo FECHA
 * (`/ranking-general?modo=fecha&tabla=PRO&categoria=ELI&fecha=<n>`).
 *
 * El puesto NO es un número: es una MEDALLA (oro, plata, bronce), la misma
 * pieza que usa Strava en sus clasificaciones. La geometría vive en
 * `src/assets/medals/medal-N.svg` y la dibuja `MedalIcon.astro`, que la
 * inserta en línea para que herede el color del token `--podium-N` y para
 * que el número calado deje ver el fondo real de la página.
 *
 * **AGRUPACIÓN POR GRUPO.** Antes las once categorías se listaban en una
 * grilla de tres columnas con el título de cada una teñido del color de su
 * grupo: once rótulos en tres colores a la vez, un arcoíris. Ahora las
 * categorías van agrupadas en bloques PRO / NORMAL / E-BIKE, y el color del
 * grupo aparece **una sola vez por bloque**, en la etiqueta del grupo. El
 * título de la categoría va en tinta: lo que dice la etiqueta es a qué
 * agrupación pertenece, no cómo se colorea.
 */
import type { CategoryPodium } from '../lib/api';
import MedalIcon from './MedalIcon.astro';

interface Props {
  podium: CategoryPodium[];
  id?: string;
}

const { podium, id } = Astro.props;

/**
 * El acento por grupo vive en `tokens.css` (`.scope-pro`, `.scope-normal`,
 * `.scope-ebike`), que define `--scope` (color vivo) y `--scope-ink` (su
 * variante legible). Aquí solo se consume.
 */
const SCOPE_CLASS: Record<string, string> = {
  PRO: 'scope-pro',
  NORMAL: 'scope-normal',
  'E-BIKE': 'scope-ebike',
};
const groupClass = (group: string) => SCOPE_CLASS[group] ?? 'scope-pro';

/** El orden de los bloques: primero los profesionales, luego el resto. */
const GROUP_ORDER = ['PRO', 'NORMAL', 'E-BIKE'];

/** Los bloques, con sus categorías, en el orden de arriba. */
const groups = GROUP_ORDER.map((name) => ({
  name,
  label: name === 'E-BIKE' ? 'E-BIKE' : name,
  categories: podium.filter((c) => c.group === name),
})).filter((g) => g.categories.length > 0);

/** Los que no caen en ningún grupo conocido, al final y sin color. */
const leftovers = podium.filter((c) => !GROUP_ORDER.includes(c.group));
---

<div class="leaderboard" id={id}>
  {
    groups.map((group) => (
      <section class={`group ${groupClass(group.name)}`}>
        <header class="group__head">
          <span class="group__name">{group.label}</span>
          <span class="group__meta font-mono">
            {group.categories.length} {group.categories.length === 1 ? 'CATEGORÍA' : 'CATEGORÍAS'}
          </span>
        </header>

        <div class="group__cats">
          {group.categories.map((category) => (
            <section class="cat">
              <h3 class="cat__name">{category.category_name}</h3>

              <ol class="cat__podium">
                {category.entries.map((entry) => (
                  <li class="cat__row" data-rank={entry.rank}>
                    <MedalIcon rank={entry.rank as 1 | 2 | 3} size={18} class="cat__medal" />
                    <a class="cat__rider" href={`/corredor/${entry.rider_slug}`}>
                      {entry.rider_name}
                    </a>
                    <span class="cat__team">
                      {entry.team_slug ? (
                        <a href={`/equipos/${entry.team_slug}`}>{entry.team_name}</a>
                      ) : (
                        entry.team_name
                      )}
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </section>
    ))
  }

  {
    leftovers.length > 0 && (
      <section class="group">
        <header class="group__head">
          <span class="group__name">OTRAS CATEGORÍAS</span>
          <span class="group__meta font-mono">{leftovers.length}</span>
        </header>
        <div class="group__cats">
          {leftovers.map((category) => (
            <section class="cat">
              <h3 class="cat__name">{category.category_name}</h3>
              <ol class="cat__podium">
                {category.entries.map((entry) => (
                  <li class="cat__row" data-rank={entry.rank}>
                    <MedalIcon rank={entry.rank as 1 | 2 | 3} size={18} class="cat__medal" />
                    <a class="cat__rider" href={`/corredor/${entry.rider_slug}`}>
                      {entry.rider_name}
                    </a>
                    <span class="cat__team">{entry.team_name}</span>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </section>
    )
  }
</div>

<style>
  .leaderboard {
    margin-top: 1.5rem;
    margin-bottom: 3.5rem;
  }

  /* ── Bloque de grupo ────────────────────────────────────────────────── */
  .group {
    margin-top: 2.25rem;
  }

  .group:first-child {
    margin-top: 0;
  }

  .group__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.625rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  /* El color del grupo aparece AQUÍ, una vez por bloque, y no en los once
     títulos de categoría. */
  .group__name {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--scope-ink, var(--ink-strong));
  }

  .group__meta {
    margin-left: auto;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  /* ── Categorías ─────────────────────────────────────────────────────── */
  .group__cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0 1.5rem;
  }

  .cat {
    padding: 0.875rem 0;
    border-bottom: var(--hairline) solid var(--line);
    min-width: 0;
  }

  /* El título de la categoría va en tinta: el grupo ya está dicho arriba. */
  .cat__name {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--ink-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat__podium {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cat__row {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    grid-template-areas:
      'medal rider'
      'medal team';
    align-items: baseline;
    column-gap: 0.5rem;
    padding: 0.2rem 0;
  }

  /* La medalla va arriba, alineada con el nombre del corredor. */
  .cat__medal {
    grid-area: medal;
    align-self: start;
    margin-top: 0.0625rem;
  }

  .cat__rider {
    grid-area: rider;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  .cat__row[data-rank='1'] .cat__rider {
    color: var(--ink-strong);
  }

  .cat__rider:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 0.15rem;
  }

  .cat__team {
    grid-area: team;
    font-size: 0.6875rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat__team a {
    color: inherit;
    text-decoration: none;
  }

  .cat__team a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15rem;
  }
</style>
