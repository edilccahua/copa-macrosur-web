---
/**
 * StageLeaderboard.astro — el podio por categoría como LINEUP.
 *
 * Copia la estructura de `getartcraft.com/apps` (`copiaartcraft/src/pages/
 * apps.astro` + `AppCard.astro`): una retícula continua de columnas con
 * bordes compartidos, agrupada en tres bloques (PRO / NORMAL / E-BIKE).
 *
 * Cada celda:
 *   · borde completo (1 px compartido con la vecina);
 *   · franja superior en degradado, del color vivo del grupo a su versión
 *     tenue;
 *   · cabeza: **nombre largo de la categoría** en el color del grupo y el
 *     grupo a la derecha, en mono versalitas;
 *   · los tres del podio, con su medalla;
 *   · pie `VER CLASIFICACIÓN ↗`, anclado abajo para que toda la fila termine
 *     a la misma altura.
 */
import type { CategoryPodium } from '../lib/api';
import MedalIcon from './MedalIcon.astro';

interface Props {
  podium: CategoryPodium[];
  /** Número de la fecha: compone el enlace a la clasificación. */
  stageNumber?: number;
  id?: string;
}

const { podium, stageNumber, id } = Astro.props;

/** El acento por grupo vive en `tokens.css` (`.scope-*` → `--scope`). */
const SCOPE_CLASS: Record<string, string> = {
  PRO: 'scope-pro',
  NORMAL: 'scope-normal',
  'E-BIKE': 'scope-ebike',
};
const groupClass = (group: string) => SCOPE_CLASS[group] ?? 'scope-pro';

/** El orden de los bloques: PRO, NORMAL, E-BIKE y, al final, lo demás. */
const GROUP_ORDER = ['PRO', 'NORMAL', 'E-BIKE'];

const groups = GROUP_ORDER.map((name) => ({
  name,
  label: name,
  categories: podium.filter((c) => c.group === name),
})).filter((g) => g.categories.length > 0);

const leftovers = podium.filter((c) => !GROUP_ORDER.includes(c.group));

/** Enlace a la clasificación de una categoría en esta fecha. */
function standingsHref(category: CategoryPodium): string {
  const params = new URLSearchParams({
    modo: 'fecha',
    tabla: category.group || 'PRO',
    categoria: category.short_code,
  });
  if (stageNumber != null) params.set('fecha', String(stageNumber));
  return `/ranking-general?${params.toString()}`;
}
---

<div class="leaderboard" id={id}>
  {
    groups.map((group) => (
      <section class={`group ${groupClass(group.name)}`}>
        <header class="group__head">
          <span class="group__name">{group.label}</span>
          <span class="group__meta">
            {group.categories.length} {group.categories.length === 1 ? 'CATEGORÍA' : 'CATEGORÍAS'}
          </span>
        </header>

        <ol class="lineup">
          {group.categories.map((category) => (
            <li class="panel">
              <header class="panel__head">
                <h3 class="panel__name">{category.category_name}</h3>
                <span class="panel__scope">{group.label}</span>
              </header>

              <ol class="panel__podium">
                {category.entries.map((entry) => (
                  <li class="panel__row" data-rank={entry.rank}>
                    <MedalIcon
                      rank={entry.rank as 1 | 2 | 3}
                      size={18}
                      class="panel__medal"
                    />
                    <a class="panel__rider" href={`/corredor/${entry.rider_slug}`}>
                      {entry.rider_name}
                    </a>
                    <span class="panel__team">
                      {entry.team_slug ? (
                        <a href={`/equipos/${entry.team_slug}`}>{entry.team_name}</a>
                      ) : (
                        entry.team_name
                      )}
                    </span>
                  </li>
                ))}
              </ol>

              <a class="panel__link" href={standingsHref(category)}>
                Ver clasificación <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  {
    leftovers.length > 0 && (
      <section class="group">
        <header class="group__head">
          <span class="group__name">OTRAS CATEGORÍAS</span>
          <span class="group__meta">{leftovers.length}</span>
        </header>
        <ol class="lineup">
          {leftovers.map((category) => (
            <li class="panel">
              <header class="panel__head">
                <h3 class="panel__name">{category.category_name}</h3>
              </header>
              <ol class="panel__podium">
                {category.entries.map((entry) => (
                  <li class="panel__row" data-rank={entry.rank}>
                    <MedalIcon
                      rank={entry.rank as 1 | 2 | 3}
                      size={18}
                      class="panel__medal"
                    />
                    <a class="panel__rider" href={`/corredor/${entry.rider_slug}`}>
                      {entry.rider_name}
                    </a>
                    <span class="panel__team">{entry.team_name}</span>
                  </li>
                ))}
              </ol>
              <a class="panel__link" href={standingsHref(category)}>
                Ver clasificación <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</div>

<style>
  .leaderboard {
    margin-top: 1.25rem;
    margin-bottom: 3rem;
  }

  /* ── Bloques de grupo: aquí SÍ hay separación entre PRO y NORMAL ─────── */
  .group {
    margin-top: 2.5rem;
  }

  .group:first-child {
    margin-top: 0;
  }

  .group__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
  }

  .group__name {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--scope-ink, var(--ink-strong));
  }

  .group__meta {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  /* ── Retícula: cada celda con sus CUATRO bordes ───────────────────────
     `margin: -1px 0 0 -1px` superpone el borde superior/izquierdo con el
     inferior/derecho de la vecina: las líneas compartidas quedan de 1 px,
     sin duplicarse. El padding de 1 px del contenedor evita que la primera
     celda se salga de la caja. Las celdas vacías de la última fila no
     dibujan nada. */
  .lineup {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 1px 0 0 1px;
    list-style: none;
  }

  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: -1px 0 0 -1px;
    padding: 1rem 1.125rem 1.125rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
    min-width: 0;
  }

  /* Franja superior: degradado del color VIVO del grupo a su versión tenue. */
  .panel::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--scope, var(--line-strong)) 0%,
      color-mix(in srgb, var(--scope, var(--line)) 10%, transparent) 100%
    );
  }

  /* ── Cabeza: el NOMBRE de la categoría, en el color del grupo ────────── */
  .panel__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .panel__name {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--scope-ink, var(--ink-strong));
    /* Dos líneas reservadas: los podios de una fila arrancan a la misma
       altura aunque un nombre de categoría ocupe dos renglones. */
    min-height: 2.7em;
  }

  .panel__scope {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ── Podio ───────────────────────────────────────────────────────────── */
  .panel__podium {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .panel__row {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    grid-template-areas:
      'medal rider'
      'medal team';
    align-items: center;
    column-gap: 0.5rem;
  }

  .panel__medal {
    grid-area: medal;
    align-self: start;
    margin-top: 0.0625rem;
  }

  /* El puesto que no lleva medalla se dice con el número. */
  .panel__rider {
    grid-area: rider;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  .panel__row[data-rank='1'] .panel__rider {
    color: var(--ink-strong);
  }

  .panel__rider:hover {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 0.15rem;
  }

  .panel__team {
    grid-area: team;
    font-family: var(--font-body);
    font-size: 0.65625rem;
    line-height: 1.35;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .panel__team a {
    color: inherit;
    text-decoration: none;
  }

  .panel__team a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15rem;
  }

  /* ── Pie ─────────────────────────────────────────────────────────────── */
  .panel__link {
    margin-top: auto;
    padding-top: 0.625rem;
    border-top: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  .panel__link:hover {
    color: var(--scope-ink, var(--ink-strong));
  }

  @media (min-width: 40em) {
    .lineup {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .lineup {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
