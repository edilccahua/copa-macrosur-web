---
/**
 * AppCard.astro — la tarjeta del lineup de /apps.
 *
 * Es más rica que BentoCard: lleva índice, género, bloque de imagen, icono,
 * nombre, descripción, estado, insignias de plataforma y enlace de exploración.
 *
 * En la "muda" esta tarjeta pasa a ser la tarjeta de una FECHA del campeonato:
 * cartel en lugar de captura, distancia y desnivel en lugar de plataformas.
 */
import type { CraftApp } from '../data/site';

interface Props {
  item: CraftApp;
  /** Marca la tarjeta para el revelado al entrar en pantalla. */
  reveal?: boolean;
}

const { item, reveal = false } = Astro.props;
---
<article class={`appcard app-${item.app}`} data-reveal={reveal ? '' : undefined}>
  <div class="appcard__media">
    <span class="appcard__initial" aria-hidden="true">{item.name.slice(0, 2)}</span>
  </div>

  <div class="appcard__body">
    <header class="appcard__head">
      <span class="appcard__index tabular">{item.index}</span>
      <span class="appcard__category">{item.category}</span>
    </header>

    <div class="appcard__title-row">
      <span class="appcard__icon" aria-hidden="true">{item.name.slice(0, 1)}</span>
      <h3 class="appcard__name">{item.name}</h3>
    </div>

    <p class="appcard__text">{item.body}</p>

    <p class="appcard__status">{item.status}</p>

    <ul class="appcard__platforms">
      {item.platforms.map((platform) => <li class="appcard__platform">{platform}</li>)}
    </ul>

    <span class="appcard__explore">Explore {item.name} →</span>
  </div>
</article>

<style>
  .appcard {
    display: flex;
    flex-direction: column;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  .appcard:hover {
    border-color: var(--app, var(--line-strong));
  }

  /* Bloque de imagen. En el original es una captura real; acá un relleno
     marcado con el acento de la app. */
  .appcard__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: var(--bg-sunken);
    border-bottom: var(--hairline) solid var(--line);
  }

  .appcard__initial {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    color: var(--app);
    opacity: 0.35;
  }

  .appcard__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem;
  }

  .appcard__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .appcard__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--app-ink);
  }

  .appcard__category {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .appcard__title-row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .appcard__icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 auto;
    background: var(--bg-sunken);
    border: var(--hairline) solid var(--line);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--app-ink);
  }

  .appcard__name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.03em;
  }

  .appcard__text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .appcard__status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--app-ink);
  }

  .appcard__platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: var(--hairline) solid var(--line);
  }

  .appcard__platform {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
    color: var(--muted);
    border: var(--hairline) solid var(--line);
  }

  .appcard__explore {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--app-ink);
  }

  .appcard:hover .appcard__explore {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
