---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { BASE_URL } from '../../lib/api';

// SSR: el perfil de equipo se resuelve contra la API en cada request (antes se
// generaba con `getStaticPaths` + mock). Ver specs/03 §2.
const { slug } = Astro.params;

let profile: any = null;
let notFound = false;
try {
  const res = await fetch(`${BASE_URL}/api/v1/teams/${slug}`);
  if (res.status === 404) {
    notFound = true;
    Astro.response.status = 404;
  } else if (res.ok) {
    profile = await res.json();
  }
} catch (e) {
  Astro.response.status = 503;
}

const team = profile?.team;
const standing = profile?.standing;
const roster = profile?.roster || [];
---
<Base title={`${team?.name || 'Equipo no encontrado'} — Copa de Equipos | Copa MacroSur MTB`}>
  <SiteHeader />

  <main class="container page-content">
    {notFound || !team ? (
      <div class="team-header-box">
        <div class="breadcrumb font-mono">
          <a href="/ranking-general">← VOLVER A LA COPA DE EQUIPOS</a>
        </div>
        <h1 class="team-name">EQUIPO NO ENCONTRADO</h1>
        <p class="team-desc">No existe ningún equipo con el identificador «{slug}».</p>
      </div>
    ) : (
    <>
    <div class="team-header-box">
      <div class="breadcrumb font-mono">
        <a href="/ranking-general">← VOLVER A LA COPA DE EQUIPOS</a>
      </div>

      <div class="team-hero">
        <div class="team-logo-box font-mono">
          {team.name ? team.name.slice(0, 4).toUpperCase() : 'CLUB'}
        </div>
        <div>
          <span class="team-badge font-mono">EQUIPO OFICIAL DEL CAMPEONATO</span>
          <h1 class="team-name">{team.name}</h1>
          <p class="team-desc">{team.description || 'Club oficial registrado para la temporada 2026.'}</p>
        </div>
      </div>

      <!-- Medallero y Estadísticas -->
      <div class="team-stats-grid font-mono">
        <div class="stat-box">
          <div class="stat-label">PUESTO GENERAL</div>
          <div class="stat-val highlight">{standing?.current_rank ? `${standing.current_rank}°` : '-'}</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">PUNTOS COPA</div>
          <div class="stat-val">{standing?.total_points || 0} pts</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">OROS [1° LUGAR]</div>
          <div class="stat-val medal-gold">{standing?.first_places || 0}</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">PLATAS [2° LUGAR]</div>
          <div class="stat-val medal-silver">{standing?.second_places || 0}</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">BRONCES [3° LUGAR]</div>
          <div class="stat-val medal-bronze">{standing?.third_places || 0}</div>
        </div>
        <div class="stat-box">
          <div class="stat-label">CICLISTAS ACTIVOS</div>
          <div class="stat-val">{roster.length}</div>
        </div>
      </div>
    </div>

    <!-- Plantilla de Ciclistas -->
    <section class="roster-section">
      <div class="section-title font-mono">PLANTILLA DE CORREDORES EN EL CAMPEONATO</div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Ciclista</th>
              <th>Categoría Principal</th>
              <th class="col-pts">Puntos Aportados</th>
            </tr>
          </thead>
          <tbody>
            {roster.length === 0 ? (
              <tr>
                <td colspan="3" class="font-mono">Sin corredores registrados en la plantilla.</td>
              </tr>
            ) : (
              roster.map((r: any) => (
                <tr>
                  <td class="rider-name-cell">
                    <a href={`/corredor/${r.slug}`} class="rider-link">{r.full_name}</a>
                  </td>
                  <td>
                    {r.categories && r.categories.length > 0 ? (
                      r.categories.map((c: string) => <span class="badge-cat">{c}</span>)
                    ) : (
                      <span class="badge-cat">OFICIAL</span>
                    )}
                  </td>
                  <td class="col-pts font-mono pts-tag">+{r.points_contributed || 0} pts</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>
    </>
    )}
  </main>

  <SiteFooter />
</Base>

<style>
  .page-content {
    padding-top: 3rem;
  }

  .team-header-box {
    border-bottom: var(--hairline) solid var(--line);
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .team-hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
  }

  .team-logo-box {
    width: 5.625rem;
    height: 5.625rem;
    background: var(--invert-bg, #101014);
    color: var(--invert-fg, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .team-badge {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    display: block;
    margin-bottom: 0.35rem;
  }

  .team-name {
    font-family: var(--font-display, var(--font-sans));
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }

  .team-desc {
    max-width: 37.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }

  .team-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat-box {
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    padding: 1rem;
  }

  .stat-label {
    font-size: 0.625rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-bottom: 0.35rem;
  }

  .stat-val {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .stat-val.highlight {
    color: var(--accent);
  }

  .medal-gold { color: #f59e0b; }
  .medal-silver { color: #94a3b8; }
  .medal-bronze { color: #b45309; }

  .roster-section {
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .table-wrap {
    overflow-x: auto;
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.8125rem;
  }

  .data-table th {
    padding: 0.75rem 1.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    border-bottom: var(--hairline) solid var(--line);
    background: var(--bg);
  }

  .data-table td {
    padding: 0.875rem 1.25rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .badge-cat {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    font-size: 0.6875rem;
    background: var(--bg);
    border: var(--hairline) solid var(--line);
  }

  .pts-tag {
    color: var(--accent);
    font-weight: 800;
  }

  @media (min-width: 48em) {
    .team-stats-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
