---
import Base from '../../layouts/Base.astro';
import JudgeDashboard from '../../components/svelte/JudgeDashboard.svelte';
---
<Base title="Panel Oficial del Juez — Kúspide MTB">
  <div class="judge-screen-wrap">
    <div class="judge-top-bar">
      <a href="/" class="back-link font-mono">← VOLVER AL SITIO</a>
      <span class="judge-role font-mono">CRONOMETRAJE OFICIAL</span>
    </div>

    <!-- PWA del Juez con IndexedDB y teclado táctil POS -->
    <JudgeDashboard client:only="svelte" stageId={1} initialJudgePin="***REMOVED-JUDGE-PIN-F1***" />
  </div>
</Base>

<style>
  .judge-screen-wrap {
    min-height: 100vh;
    background: var(--bg, #fbfbfd);
  }

  .judge-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.25rem;
    background: var(--invert-bg, #101014);
    color: var(--invert-fg, #ffffff);
    border-bottom: var(--hairline) solid var(--line);
  }

  .back-link {
    color: #ffffff;
    font-size: 0.6875rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.1em;
  }

  .back-link:hover {
    color: var(--accent, #ff5500);
  }

  .judge-role {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #ff5500;
    letter-spacing: 0.12em;
  }
</style>
