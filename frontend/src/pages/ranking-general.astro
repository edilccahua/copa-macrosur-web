---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StandingsTable from '../components/svelte/StandingsTable.svelte';
import {
  API_V1,
  packStandingsRows,
  packTeamStandingsRows,
} from '../lib/api';

// SSR: la clasificación se resuelve contra la API en cada request (ver specs/03 §0).

// --- Argumentos de la URL ----------------------------------------------------
// La tabla se puede abrir en cualquier vista y compartirla por enlace:
//   ?modo=acumulado|fecha  ·  ?tabla=PRO|NORMAL|E-BIKE|EQUIPO
//   ?categoria=ELI          ·  ?fecha=2   (número de fecha, no el id)
const qp = Astro.url.searchParams;

const mode: 'acumulado' | 'fecha' = qp.get('modo') === 'fecha' ? 'fecha' : 'acumulado';
const tabla = (qp.get('tabla') ?? 'PRO').toUpperCase();
const kind: 'individual' | 'teams' = tabla === 'EQUIPO' ? 'teams' : 'individual';
// Los enlaces viejos con el ámbito anterior ("E-MTB") siguen funcionando.
const scope = ['PRO', 'NORMAL', 'E-BIKE'].includes(tabla)
  ? tabla
  : tabla === 'E-MTB'
    ? 'E-BIKE'
    : 'PRO';
const catCode = (qp.get('categoria') ?? '').toUpperCase();
const stageNumber = Number(qp.get('fecha'));

// --- Contexto (fechas disponibles y catálogo de categorías) ------------------
let context: any = {
  stages: [],
  selected_stage_id: null,
  stages_counted: 0,
  total_distance_km: 0,
  groups: {},
  scope_labels: {},
  scope_labels_long: {},
  scope_order: [],
  categories: [],
};
let fallbackRows: any[] = [];
let fallbackTeams: any[] = [];

/**
 * Una lectura de la clasificación. `null` si el backend no responde: la isla
 * muestra el estado vacío y reintenta al interactuar (specs/03 §0.2).
 */
async function pedir(url: string): Promise<any | null> {
  try {
    const res = await fetch(url);
    if (!res.ok) return null;
    return await res.json();
  } catch {
    return null;
  }
}

/**
 * UNA sola tanda de llamadas al backend.
 *
 * Antes eran TRES: la general (siempre) y, si la URL traía argumentos, la
 * individual y la de equipos dentro de un `Promise.all`. La general sólo
 * servía para traducir `?fecha=2` y `?categoria=ELI` a los ids que pide la
 * API... y sus FILAS se descartaban, porque la respuesta de la vista pedida
 * trae el mismo contexto (fechas, categorías, grupos).
 *
 * Ahora:
 * · La respuesta de la clasificación trae el contexto, así que la lectura
 *   general sólo hace falta cuando hay que traducir `?fecha=`/`?categoria=`
 *   a ids.
 * · La Copa de Equipos sólo se pide cuando la vista ES la de equipos: antes
 *   se pedía siempre y se tiraba a la basura en cuanto la isla cambiaba de
 *   pestaña (la isla la vuelve a pedir sola al pulsar EQUIPO).
 */
/**
 * Los ids que pide la API (`stage`, `category_id`) salen del contexto: la URL
 * trae el NÚMERO de la fecha y el CÓDIGO de la categoría, no sus ids.
 */
function resuelveFecha(ctx: any) {
  return Number.isFinite(stageNumber) && stageNumber > 0
    ? (ctx.stages.find((s: any) => s.stage_number === stageNumber) ?? null)
    : null;
}

function resuelveCategoria(ctx: any) {
  return catCode
    ? (ctx.categories.find((c: any) => c.short_code === catCode) ?? null)
    : null;
}

const params = new URLSearchParams();
params.set('mode', mode);
params.set('scope', scope);

// ¿La URL pide una fecha o una categoría concretas? Entonces hacen falta sus
// ids, y los ids sólo salen del contexto.
const pideIds = (Number.isFinite(stageNumber) && stageNumber > 0) || catCode !== '';

if (pideIds) {
  // 1) El contexto: de aquí salen el id de la fecha y el de la categoría.
  const general = await pedir(`${API_V1}/public/standings?${params.toString()}`);
  if (general) {
    context = general.context ?? context;

    // 2) La vista pedida, ya con sus ids: una sola tanda.
    const q = new URLSearchParams(params);
    const stageArg = resuelveFecha(context);
    const catArg = resuelveCategoria(context);
    if (stageArg) q.set('stage', String(stageArg.id));
    if (catArg) q.set('category_id', String(catArg.id));

    const [ind, tms] = await Promise.all([
      kind === 'teams'
        ? Promise.resolve(null)
        : pedir(`${API_V1}/public/standings?${q.toString()}`),
      kind === 'teams'
        ? pedir(`${API_V1}/public/standings?${q.toString()}&kind=teams`)
        : Promise.resolve(null),
    ]);
    if (ind) {
      fallbackRows = ind.rows ?? [];
      context = ind.context ?? context;
    }
    if (tms) fallbackTeams = tms.rows ?? [];
  }
} else {
  // Una sola llamada: la vista pedida. Su respuesta trae el contexto.
  const suffix = kind === 'teams' ? '&kind=teams' : '';
  const payload = await pedir(`${API_V1}/public/standings?${params.toString()}${suffix}`);
  if (payload) {
    context = payload.context ?? context;
    if (kind === 'teams') {
      fallbackTeams = payload.rows ?? [];
    } else {
      fallbackRows = payload.rows ?? [];
    }
  }
}

// --- Los argumentos se resuelven contra el contexto -------------------------
const stageArg = resuelveFecha(context);
const catArg = resuelveCategoria(context);

const initialStageId = stageArg ? stageArg.id : (context.selected_stage_id ?? null);
const initialCategoryId = catArg ? catArg.id : null;

// Las filas viajan COLUMNADAS (ver `packStandingsRows`): el atributo `props`
// del <astro-island> pesa ~25 KB en vez de ~90 KB. La tabla recibe los mismos
// datos; sólo cambia el formato del viaje.
const packedRows = packStandingsRows(fallbackRows);
const packedTeams = packTeamStandingsRows(fallbackTeams);

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=30'
);
---

<Base
  title={mode === 'fecha'
    ? 'Clasificación de la Fecha — Copa MacroSur MTB'
    : 'Ranking General Acumulado — Copa MacroSur MTB'}
>
  <SiteHeader />

  <main class="container page-content">
    <StandingsTable
      client:load
      context={context}
      initialRows={packedRows}
      initialTeams={packedTeams}
      initialStageId={initialStageId}
      initialScope={scope}
      initialCategoryId={initialCategoryId}
      initialMode={mode}
      initialKind={kind}
    />
  </main>

  <SiteFooter />
</Base>

<style>
  .page-content {
    /* La clasificación es una tabla densa: aprovecha el ancho de la pantalla. */
    --container-page: 108rem;
    box-sizing: border-box;
    min-width: 0;
    padding-top: 2.5rem;
    scroll-margin-top: calc(var(--header-offset, 3.0625rem) + 1rem);
  }

  @media (max-width: 47.99em) {
    .page-content {
      /* Móvil: reducción del padding para pegar el contenido a la barra de menú y ganar espacio útil */
      padding-top: 0.35rem;
      padding-inline: 0.65rem;
      scroll-margin-top: calc(var(--header-offset-mobile, 3.25rem) + 0.35rem);
    }
  }

</style>
