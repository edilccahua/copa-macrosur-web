---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StandingsTable from '../components/svelte/StandingsTable.svelte';
import { API_V1 } from '../lib/api';

// SSR: la clasificación se resuelve contra la API en cada request (ver specs/03 §0).
let payload: any = null;
let fallbackRows: any[] = [];
let fallbackTeams: any[] = [];

try {
  const res = await fetch(`${API_V1}/public/standings?scope=PRO`);
  if (res.ok) payload = await res.json();
} catch (e) {
  // Modo SSR sin backend: la isla muestra el estado vacío con su mensaje.
}

// La Copa de Equipos se carga aparte (mismo corte de fecha que la clasificación).
try {
  const res = await fetch(`${API_V1}/public/standings?kind=teams`);
  if (res.ok) {
    const teams = await res.json();
    fallbackTeams = teams.rows ?? [];
  }
} catch (e) {}

fallbackRows = payload?.rows ?? [];

const context = payload?.context ?? {
  stages: [],
  selected_stage_id: null,
  stages_counted: 0,
  total_distance_km: 0,
  groups: {},
  scope_labels: {},
  scope_order: [],
  categories: [],
};
---

<Base title="Ranking General Acumulado — Kúspide MTB">
  <SiteHeader />

  <main class="container page-content">
    <div class="page-header">
      <div class="breadcrumb font-mono">CAMPEONATO MTB 2026 / CLASIFICACIÓN OFICIAL</div>
      <h1 class="page-title">Ranking general <em>acumulado</em></h1>
    </div>

    <StandingsTable
      client:load
      stages={context.stages}
      context={context}
      initialRows={fallbackRows}
      initialTeams={fallbackTeams}
      initialStageId={context.selected_stage_id}
      initialScope="PRO"
      initialCategoryId={null}
    />
  </main>

  <SiteFooter />
</Base>

<style>
  .page-content {
    /* La clasificación es una tabla densa: aprovecha el ancho de la pantalla. */
    --container-page: 108rem;
    box-sizing: border-box;
    min-width: 0;
    padding-top: 2.5rem;
    scroll-margin-top: calc(var(--nav-height, 3.0625rem) + 1rem);
  }

  @media (max-width: 47.99em) {
    .page-content {
      /* El navbar sticky mide 3rem en móvil: la cinta nunca queda debajo. */
      padding-top: calc(1.5rem + env(safe-area-inset-top));
      scroll-margin-top: calc(var(--nav-height-mobile, 3rem) + 0.75rem);
    }
  }

  .page-header {
    border-bottom: var(--hairline) solid var(--line);
    padding-bottom: 1.25rem;
    margin-bottom: 0;
  }

  .breadcrumb {
    font-size: 0.6875rem;
    color: var(--muted);
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--ink-strong);
    text-wrap: balance;
    margin: 0;
  }

  .page-title em {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
</style>
