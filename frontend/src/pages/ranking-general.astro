---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StandingsTable from '../components/svelte/StandingsTable.svelte';

let individualStandings = [];
let teamStandings = [];

try {
  const [resInd, resTeam] = await Promise.all([
    fetch('http://localhost:8000/api/v1/public/standings/individual'),
    fetch('http://localhost:8000/api/v1/public/standings/teams')
  ]);
  if (resInd.ok) individualStandings = await resInd.json();
  if (resTeam.ok) teamStandings = await resTeam.json();
} catch (e) {
  // Modo SSR offline fallback
}

const categories = [
  { id: 1, name: 'ELITE', short_code: 'ELI' },
  { id: 2, name: 'MASTER A', short_code: 'MSA' },
  { id: 3, name: 'MASTER B', short_code: 'MSB' },
  { id: 4, name: 'MASTER C', short_code: 'MSC' },
  { id: 5, name: 'MASTER D', short_code: 'MSD' },
  { id: 6, name: 'TURISMO OPEN VARONES', short_code: 'TOV' },
  { id: 7, name: 'TURISMO MASTER VARONES', short_code: 'TMV' },
  { id: 8, name: 'OPEN DAMAS', short_code: 'OPD' },
  { id: 9, name: 'DAMAS MASTER', short_code: 'DMM' },
  { id: 10, name: 'JUVENILES 15 - 17', short_code: 'JUV' },
  { id: 11, name: 'E-BIKE OPEN', short_code: 'EBK' }
];
---
<Base title="Ranking General Acumulado — Kúspide MTB">
  <SiteHeader />

  <main class="container page-content">
    <div class="page-header">
      <div class="breadcrumb font-mono">CAMPEONATO MTB 2026 / CLASIFICACIÓN OFICIAL</div>
      <h1 class="page-title">RANKING GENERAL ACUMULADO</h1>
      <p class="page-desc">
        Puntaje oficial sumado de las 4 fechas según el reglamento UCI. Los puestos desempatan por victorias de categoría y puesto en la última fecha disputada.
      </p>
    </div>

    <!-- Isla Svelte 5 con Runes -->
    <StandingsTable
      client:visible
      initialIndividual={individualStandings}
      initialTeams={teamStandings}
      categories={categories}
    />
  </main>

  <SiteFooter />
</Base>

<style>
  .page-content {
    padding-top: 3rem;
  }

  .page-header {
    border-bottom: var(--hairline) solid var(--line);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .breadcrumb {
    font-size: 0.6875rem;
    color: var(--accent, #ff5500);
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin: 0 0 1rem 0;
  }

  .page-desc {
    max-width: 720px;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
