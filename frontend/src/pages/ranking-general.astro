---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StandingsTable from '../components/svelte/StandingsTable.svelte';
import { API_V1 } from '../lib/api';

// SSR: la clasificación se resuelve contra la API en cada request (ver specs/03 §0).

// --- Argumentos de la URL ----------------------------------------------------
// La tabla se puede abrir en cualquier vista y compartirla por enlace:
//   ?modo=acumulado|fecha  ·  ?tabla=PRO|NORMAL|E-BIKE|EQUIPO
//   ?categoria=ELI          ·  ?fecha=2   (número de fecha, no el id)
const qp = Astro.url.searchParams;

const mode: 'acumulado' | 'fecha' = qp.get('modo') === 'fecha' ? 'fecha' : 'acumulado';
const tabla = (qp.get('tabla') ?? 'PRO').toUpperCase();
const kind: 'individual' | 'teams' = tabla === 'EQUIPO' ? 'teams' : 'individual';
// Los enlaces viejos con el ámbito anterior ("E-MTB") siguen funcionando.
const scope = ['PRO', 'NORMAL', 'E-BIKE'].includes(tabla)
  ? tabla
  : tabla === 'E-MTB'
    ? 'E-BIKE'
    : 'PRO';
const catCode = (qp.get('categoria') ?? '').toUpperCase();
const stageNumber = Number(qp.get('fecha'));

// --- Contexto (fechas disponibles y catálogo de categorías) ------------------
let context: any = {
  stages: [],
  selected_stage_id: null,
  stages_counted: 0,
  total_distance_km: 0,
  groups: {},
  scope_labels: {},
  scope_labels_long: {},
  scope_order: [],
  categories: [],
};
let fallbackRows: any[] = [];
let fallbackTeams: any[] = [];

try {
  const res = await fetch(`${API_V1}/public/standings?scope=${scope}&mode=${mode}`);
  if (res.ok) {
    const payload = await res.json();
    context = payload.context ?? context;
    fallbackRows = payload.rows ?? [];
  }
} catch (e) {
  // Modo SSR sin backend: la isla muestra el estado vacío con su mensaje.
}

// --- Los argumentos se resuelven contra el contexto -------------------------
const stageArg = Number.isFinite(stageNumber) && stageNumber > 0
  ? (context.stages.find((s: any) => s.stage_number === stageNumber) ?? null)
  : null;
const catArg = catCode
  ? (context.categories.find((c: any) => c.short_code === catCode) ?? null)
  : null;

// Si la URL pide otra fecha, otra categoría, la Copa de Equipos o el modo
// "fecha", se piden esos datos (el corte por defecto ya vino arriba).
if (stageArg || catArg || kind === 'teams' || mode === 'fecha') {
  const q = new URLSearchParams();
  q.set('mode', mode);
  q.set('scope', scope);
  if (stageArg) q.set('stage', String(stageArg.id));
  if (catArg) q.set('category_id', String(catArg.id));

  try {
    const [ind, tms] = await Promise.all([
      fetch(`${API_V1}/public/standings?${q.toString()}`).then((r) => (r.ok ? r.json() : null)),
      fetch(`${API_V1}/public/standings?${q.toString()}&kind=teams`).then((r) =>
        r.ok ? r.json() : null
      ),
    ]);
    if (ind) {
      fallbackRows = ind.rows ?? [];
      context = ind.context ?? context;
    }
    if (tms) fallbackTeams = tms.rows ?? [];
  } catch (e) {
    // Sin backend: la isla reintenta al interactuar.
  }
}

const initialStageId = stageArg ? stageArg.id : (context.selected_stage_id ?? null);
const initialCategoryId = catArg ? catArg.id : null;
---

<Base title="Ranking General Acumulado — Kúspide MTB">
  <SiteHeader />

  <main class="container page-content">
    <div class="page-header">
      <div class="breadcrumb font-mono">CAMPEONATO MTB 2026 / CLASIFICACIÓN OFICIAL</div>
      <!-- El rótulo cambia con el modo (acumulado / de la fecha): lo ajusta la isla. -->
      <h1 class="page-title">
        <span data-mode-title>Ranking general</span> <em data-mode-word>acumulado</em>
      </h1>
    </div>

    <StandingsTable
      client:load
      stages={context.stages}
      context={context}
      initialRows={fallbackRows}
      initialTeams={fallbackTeams}
      initialStageId={initialStageId}
      initialScope={scope}
      initialCategoryId={initialCategoryId}
      initialMode={mode}
      initialKind={kind}
    />
  </main>

  <SiteFooter />
</Base>

<style>
  .page-content {
    /* La clasificación es una tabla densa: aprovecha el ancho de la pantalla. */
    --container-page: 108rem;
    box-sizing: border-box;
    min-width: 0;
    padding-top: 2.5rem;
    scroll-margin-top: calc(var(--header-offset, 3.0625rem) + 1rem);
  }

  @media (max-width: 47.99em) {
    .page-content {
      /* La cabecera sticky: la cinta nunca queda debajo. */
      padding-top: calc(1.5rem + env(safe-area-inset-top));
      scroll-margin-top: calc(var(--header-offset-mobile, 4rem) + 0.75rem);
    }
  }

  .page-header {
    border-bottom: var(--hairline) solid var(--line);
    padding-bottom: 1.25rem;
    margin-bottom: 0;
  }

  .breadcrumb {
    font-size: 0.6875rem;
    color: var(--muted);
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--ink-strong);
    text-wrap: balance;
    margin: 0;
  }

  .page-title em {
    font-family: var(--font-serif, Georgia, serif);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
</style>
