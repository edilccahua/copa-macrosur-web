---
import Showcase from '../layouts/Showcase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroWordmark from '../components/HeroWordmark.astro';
import DisplayTitle from '../components/DisplayTitle.astro';
import HeroScene from '../components/HeroScene.astro';
import SectionLabel from '../components/bento/SectionLabel.astro';
import MedalIcon from '../components/MedalIcon.astro';
import EventCountdown from '../components/svelte/EventCountdown.svelte';
import TimelineEvents from '../components/TimelineEvents.astro';
import { API_V1 } from '../lib/api';
import { getStages, formatStageDate } from '../lib/stages';

/**
 * Copa de Equipos: se lee de la API. SIN datos literales: el arreglo de
 * respaldo que había (142/99/88) estaba desactualizado y ponía de líder al
 * equipo equivocado cuando la API no respondía (specs/03 §0.2).
 */
let topTeams: { name: string; points: number }[] = [];
let teamsError = false;
try {
  const res = await fetch(`${API_V1}/public/standings/teams`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      topTeams = data.slice(0, 3).map((t: any) => ({ name: t.team_name, points: t.total_points }));
    }
  } else {
    teamsError = true;
  }
} catch (e) {
  teamsError = true;
}

/** El calendario y la próxima fecha salen de la BD, no de literales. */
const stages = await getStages();
const nextStage =
  stages.find((s) => s.status === 'REGISTRATION_OPEN') ??
  stages.find((s) => s.status === 'UPCOMING') ??
  null;

const countdownTarget = nextStage
  ? `${nextStage.date}T${(nextStage.start_time ?? '08:00').replace(' AM', '').replace(' PM', '')}:00-05:00`
  : '';
---
<Showcase
  title="Kúspide MTB — Campeonato Oficial 2026"
  sections={[
    { label: 'Fechas', id: 'fechas' },
    { label: 'Clasificación', id: 'clasificacion' },
  ]}
>
  <SiteHeader />

  <main class="home">
    <!-- ── Hero editorial con escena (El Misti + sol/luna) ─────────────── -->
    <section class="hero" data-draw>
      <HeroScene />

      <div class="hero__content container">
        <div class="hero__eyebrow" data-draw-eyebrow>[ CIRCUITO OFICIAL MTB XC 2026 ]</div>

        <HeroWordmark text="KÚSPIDE" />

        <div class="hero__copy" data-hero-copy>
          <DisplayTitle size="hero" before="Campeonato regional " accent="MTB 2026." />
          <p class="hero__body">
            Cuatro fechas de cross-country y maratón en Arequipa. Cronometraje electrónico,
            clasificaciones por categoría y Copa de Clubes.
          </p>
        </div>

        <div class="hero__actions" data-hero-copy>
          <a class="btn btn--solid" href="/inscripciones">
            <span>Pre-inscripción</span>
            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </a>
          <a class="btn btn--ghost" href="/ranking-general">
            <span>Ver ranking</span>
            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M2 13V9M6 13V5M10 13V3M14 13V7"/>
            </svg>
          </a>
        </div>

        <ul class="hero__meta" data-hero-copy>
          {
            stages.map((s) => (
              <li>
                <a href={`/fechas/${s.slug}`}>{s.short_name || s.name.replace(/^Fecha\s+\d+\s*:\s*/i, '')}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Próxima fecha dentro del primer viewport -->
      {
        nextStage && (
          <div class="hero__next" id="proxima">
            <div class="next__inner container">
              <div class="next__meta">
                <span class="next__dot" aria-hidden="true" />
                <span>[ PRÓXIMA FECHA ]</span>
                <span>{formatStageDate(nextStage.date)}</span>
              </div>
              <div class="next__main">
                <h2 class="next__title">
                  {nextStage.short_name || nextStage.name.replace(/^Fecha\s+\d+\s*:\s*/i, '')}
                </h2>
                <p class="next__specs">
                  {nextStage.distance_km.toFixed(1)} KM · +{nextStage.elevation_gain_m} M
                  {nextStage.start_location ? ` · PARTIDA: ${nextStage.start_location.toUpperCase()}` : ''}
                  {nextStage.start_time ? ` (${nextStage.start_time})` : ''}
                </p>
              </div>
              <div class="next__timer">
                <EventCountdown
                  client:load
                  targetDate={countdownTarget}
                  status={nextStage.status ?? 'UPCOMING'}
                  label="LARGADA OFICIAL"
                />
              </div>
              <div class="next__actions">
                <a class="btn btn--solid" href="/inscripciones">
                  <span>Inscribirse</span>
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </a>
                <a class="btn btn--ghost" href={`/fechas/${nextStage.slug}`}>
                  <span>Ficha de ruta</span>
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        )
      }
    </section>

    <!-- ── 01 · Fechas y Eventos 2026 ──────────────────────────────── -->
    <section class="section container" id="fechas">
      <SectionLabel number="01" label="Calendario de carreras 2026" kicker="COPA MACROSUR MTB & CLÁSICAS DE RUTA" />

      <TimelineEvents />
    </section>

    <!-- ── 02 · Clasificación y premios ───────────────────────────────── -->
    <section class="section container" id="clasificacion">
      <SectionLabel number="02" label="Clasificación y premios" kicker="TRAS LAS DOS PRIMERAS FECHAS" />

      <div class="panels">
        <div class="panel">
          <div class="panel__head">[ COPA DE EQUIPOS ]</div>
          {teamsError ? (
            <>
              <h3 class="panel__title">Clasificación no disponible</h3>
              <p class="panel__body">
                No pudimos cargar la Copa de Equipos en este momento. Vuelve a intentarlo en unos
                segundos.
              </p>
            </>
          ) : (
            <>
              <h3 class="panel__title">{topTeams[0]?.name ?? 'Sin equipos aún'}</h3>
              <p class="panel__body">
                Líder de la Copa de Equipos acumulada tras La Joya Extreme y Z Xtreme 2026.
              </p>

              <ol class="podium">
                {
                  topTeams.map((t, idx) => (
                    <li class="podium__row">
                      <MedalIcon rank={(idx + 1) as 1 | 2 | 3} size={20} class="podium__medal" />
                      <span class="podium__name">{t.name}</span>
                      <span class="podium__pts">{t.points} pts</span>
                    </li>
                  ))
                }
              </ol>
            </>
          )}

          <a class="panel__cta" href="/ranking-general?tabla=EQUIPO">Ver copa completa →</a>
        </div>

        <div class="panel">
          <div class="panel__head">[ PREMIOS ESPECIALES ]</div>

          <div class="award">
            <img src="/images/premio_coca.jpg" alt="Premio Especial Coca" />
            <div>
              <h4 class="award__name">Premio Especial Coca</h4>
              <p class="award__text">S/ 300 + trofeo conmemorativo a la máxima persistencia.</p>
            </div>
          </div>

          <div class="award">
            <img src="/images/rey_montana.jpg" alt="Rey de la Montaña" />
            <div>
              <h4 class="award__name">Rey de la Montaña</h4>
              <p class="award__text">S/ 500 + maillot de lunares al mejor tiempo en la subida cumbre.</p>
            </div>
          </div>

          <a class="panel__cta" href="/fechas/la-joya-extreme">Ver ganadores →</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Showcase>

<style>
  /* ── Botones ─────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    border: var(--hairline) solid transparent;
    border-radius: var(--radius);
    white-space: nowrap;
    text-decoration: none;
    transition:
      background var(--default-transition-duration) var(--default-transition-timing-function),
      border-color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .btn--solid {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .btn--solid:hover {
    background: var(--accent);
    color: #fff;
  }

  .btn--ghost {
    border-color: var(--line);
    color: var(--ink);
  }

  .btn--ghost:hover {
    border-color: var(--line-strong);
    background: var(--bg-raised);
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Altura estimada de la tarjeta para anclar la línea base de la cordillera */
    --hero-next-height: 14rem;
    /* Ocupa el primer viewport completo, descontando la cabecera */
    min-height: calc(100vh - var(--header-offset-mobile, 4rem));
    min-height: calc(100svh - var(--header-offset-mobile, 4rem));
    text-align: center;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 3rem 2rem;
  }

  .hero__eyebrow {
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .hero__copy {
    margin-top: 1.5rem;
  }

  .hero__body {
    margin: 1.25rem auto 0;
    max-width: 46ch;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .hero__meta a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .hero__meta a:hover {
    color: var(--ink);
  }

  /* ── Banda próxima fecha (dentro del hero) ───────────────────────────── */
  .hero__next {
    position: relative;
    z-index: 2;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: var(--hairline) solid var(--line);
  }

  .next__inner {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding-block: 1.5rem;
  }

  .next__timer {
    display: flex;
    align-items: center;
  }

  .next__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .next__meta > span {
    white-space: nowrap;
  }

  .next__dot {
    width: 0.375rem;
    height: 0.375rem;
    flex: 0 0 auto;
    background: var(--ink);
  }

  .next__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  @media (min-width: 48em) {
    .next__title {
      font-size: var(--text-3xl);
    }
  }

  .next__specs {
    margin: 0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .next__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ── Secciones ───────────────────────────────────────────────────────── */
  .section {
    padding-block: 0;
  }

  .section + .section {
    margin-top: 3rem;
  }

  /* ── Paneles ─────────────────────────────────────────────────────────── */
  .panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 4rem;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
  }

  .panel__head {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .panel__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  .panel__body {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .podium {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--hairline) solid var(--line);
  }

  .podium__row {
    display: grid;
    grid-template-columns: 1.25rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-block: 0.6rem;
    border-bottom: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .podium__medal {
    align-self: center;
  }

  .podium__name {
    overflow: hidden;
    color: var(--ink);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .podium__pts {
    color: var(--muted);
  }

  .award {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    align-items: center;
    padding-block: 0.75rem;
    border-top: var(--hairline) solid var(--line);
  }

  .award img {
    display: block;
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border: var(--hairline) solid var(--line);
  }

  .award__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  .award__text {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .panel__cta {
    margin-top: auto;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: none;
  }

  .panel__cta:hover {
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  /* ── Móvil & Tablet Ajustes de Espaciado ────────────────────────────── */
  @media (max-width: 48em) {
    .hero__content {
      padding-block: 1.75rem 1rem;
    }

    .hero__eyebrow {
      margin-bottom: 0.75rem;
    }

    .hero__copy {
      margin-top: 0.85rem;
    }

    .hero__body {
      margin: 0.6rem auto 0;
      font-size: 0.9375rem;
      line-height: 1.45;
    }

    .hero__actions {
      margin-top: 1.25rem;
    }

    .hero__meta {
      margin: 1rem 0 0;
    }

    .next__inner {
      padding-block: 1.15rem;
      gap: 0.85rem;
    }
  }

  @media (max-width: 32em) {
    .hero {
      --hero-next-height: 16.5rem;
    }
  }

  /* ── Desktop ─────────────────────────────────────────────────────────── */
  @media (min-width: 48em) {
    .hero {
      --hero-next-height: 5.5rem;
      min-height: calc(100vh - var(--header-offset, 3.0625rem));
      min-height: calc(100svh - var(--header-offset, 3.0625rem));
    }

    .hero__content {
      padding-block: 4rem 3rem;
    }

    .next__inner {
      grid-template-columns: auto 1fr;
      padding-block: 1.75rem;
    }

    .next__timer {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .section + .section {
      margin-top: 4rem;
    }

    .panels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68.75em) {
    .hero {
      --hero-next-height: 5.25rem;
    }

    .next__inner {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      gap: 1.5rem;
    }

    .next__timer {
      grid-column: auto;
      justify-self: center;
    }
  }
</style>
