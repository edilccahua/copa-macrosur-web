---
import Showcase from '../layouts/Showcase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroWordmark from '../components/HeroWordmark.astro';
import DisplayTitle from '../components/DisplayTitle.astro';
import HeroScene from '../components/HeroScene.astro';
import SectionLabel from '../components/bento/SectionLabel.astro';
import PodiumPanel from '../components/PodiumPanel.astro';
import PrizeScale from '../components/PrizeScale.astro';
import EventCountdown from '../components/svelte/EventCountdown.svelte';
import TimelineEvents from '../components/TimelineEvents.astro';
import { API_V1 } from '../lib/api';
import { getStages, formatStageDate } from '../lib/stages';
import { SITE_NAME, BRAND_WORDMARK, BRAND_ACCENT, BRAND_EDITION } from '../data/site';
import { ACCUMULATED_PRIZES, PER_DATE_PRIZES, PRIZE_CURRENCY } from '../data/prizes';

/**
 * Las tres clasificaciones de la portada se leen de la API. SIN datos
 * literales: cualquier cifra de respaldo quedaría desactualizada y pondría
 * de líder a quien no toca (specs/03 §0.2).
 *
 * · PRO · TODOS    → acumulado del grupo PRO (todas sus categorías)
 * · NORMAL · TODOS → acumulado del grupo NORMAL (todas sus categorías)
 * · EQUIPO         → Copa de Equipos acumulada
 */
type PodiumRow = { name: string; points: number };

async function fetchScopePodium(
  scope: 'PRO' | 'NORMAL'
): Promise<{ rows: PodiumRow[]; error: boolean }> {
  try {
    const res = await fetch(`${API_V1}/public/standings?scope=${scope}`);
    if (!res.ok) return { rows: [], error: true };
    const data = await res.json();
    const rows = Array.isArray(data.rows) ? data.rows : [];
    return {
      rows: rows
        .slice(0, 3)
        .map((r: any) => ({ name: r.rider_name, points: r.total_points })),
      error: false,
    };
  } catch (e) {
    return { rows: [], error: true };
  }
}

const [proPodium, normalPodium] = await Promise.all([
  fetchScopePodium('PRO'),
  fetchScopePodium('NORMAL'),
]);

let topTeams: PodiumRow[] = [];
let teamsError = false;
try {
  const res = await fetch(`${API_V1}/public/standings/teams`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      topTeams = data.slice(0, 3).map((t: any) => ({ name: t.team_name, points: t.total_points }));
    }
  } else {
    teamsError = true;
  }
} catch (e) {
  teamsError = true;
}

/** El calendario y la próxima fecha salen de la BD, no de literales. */
const stages = await getStages();
const nextStage =
  stages.find((s) => s.status === 'REGISTRATION_OPEN') ??
  stages.find((s) => s.status === 'UPCOMING') ??
  null;

/**
 * Los premios especiales de la Fecha 1, leídos de la API. Antes el panel
 * escribía a mano el texto del premio y no coincidía con la BD ("trofeo
 * conmemorativo a la máxima persistencia" frente a "Trofeo Conmemorativo
 * Coca de Bronce").
 */
let awards: {
  title: string;
  sponsor_name?: string | null;
  sponsor_logo_url?: string | null;
  prize_description?: string | null;
  winner_name?: string | null;
}[] = [];
try {
  const res = await fetch(`${API_V1}/stages/la-joya-extreme/summary`);
  if (res.ok) {
    const data = await res.json();
    awards = Array.isArray(data.awards) ? data.awards : [];
  }
} catch (e) {
  awards = [];
}

const countdownTarget = nextStage
  ? `${nextStage.date}T${(nextStage.start_time ?? '08:00').replace(' AM', '').replace(' PM', '')}:00-05:00`
  : '';

/**
 * El nombre REAL de la fecha ("El Retorno a los Poblados 2"), no el corto
 * ("Poblados"): el corto era para el índice compacto del hero.
 */
const nextStageName = nextStage
  ? nextStage.name.replace(/^Fecha\s+\d+\s*:\s*/i, '')
  : '';

/**
 * DISTANCIA y DESNIVEL son POR VUELTA en la BD (specs/01 §1.4): en una
 * fecha de varias vueltas hay que multiplicar por las vueltas para no
 * prometer un tercio de la carrera. Una fecha sin ruta publicada no tiene
 * cifras: entonces la banda lo dice.
 */
const nextLaps = Math.max(1, nextStage?.laps ?? 1);
const nextKmLap = nextStage?.distance_km ?? null;
const nextKmTotal = nextKmLap != null ? nextKmLap * nextLaps : null;
const nextGainLap = nextStage?.elevation_gain_m ?? null;
const nextGainTotal = nextGainLap != null ? nextGainLap * nextLaps : null;
const nextDistanceText =
  nextKmLap == null
    ? 'DISTANCIA POR CONFIRMAR'
    : nextLaps > 1
      ? `${nextKmLap.toFixed(2)} KM × ${nextLaps} VUELTAS = ${nextKmTotal!.toFixed(2)} KM`
      : `${nextKmTotal!.toFixed(2)} KM`;
---
<Showcase
  title={`${SITE_NAME} — Campeonato Oficial 2026`}
  sections={[
    { label: 'Fechas', id: 'fechas' },
    { label: 'Clasificación', id: 'clasificacion' },
    { label: 'Premios', id: 'premios' },
  ]}
>
  <SiteHeader />

  <main class="home">
    <!-- ── Hero editorial con escena (El Misti + sol/luna) ─────────────── -->
    <section class="hero" data-draw>
      <HeroScene />

      <div class="hero__content container">
        <div class="hero__eyebrow" data-draw-eyebrow>[ {BRAND_EDITION} ]</div>

        <HeroWordmark text={BRAND_WORDMARK} accent={BRAND_ACCENT} />

        <div class="hero__copy" data-hero-copy>
          <DisplayTitle size="hero" before="Cuatro fechas de MTB en " accent="Arequipa." />
        </div>

        <div class="hero__actions" data-hero-copy>
          <a class="btn btn--ghost" href="/ranking-general">
            <span>Ver ranking</span>
            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <path d="M3 13V9.5M8 13V5.5M13 13V2.5"/>
            </svg>
          </a>
        </div>

        <ul class="hero__meta" data-hero-copy>
          {
            stages.map((s) => (
              <li>
                <a href={`/fechas/${s.slug}`}>{s.short_name || s.name.replace(/^Fecha\s+\d+\s*:\s*/i, '')}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Próxima fecha dentro del primer viewport -->
      {
        nextStage && (
          <div class="hero__next" id="proxima">
            <div class="next__inner container">
              <div class="next__meta">
                <span class="next__dot" aria-hidden="true" />
                <span class="next__label">[ PRÓXIMA FECHA ]</span>
                <span>{formatStageDate(nextStage.date)}</span>
              </div>
              <div class="next__main">
                <h2 class="next__title">{nextStageName}</h2>
                <p class="next__specs">
                  {nextDistanceText}
                  {nextGainTotal != null ? ` · +${nextGainTotal} M` : ''}
                  {nextStage?.start_location ? ` · PARTIDA: ${nextStage.start_location.toUpperCase()}` : ''}
                  {nextStage?.start_time ? ` (${nextStage.start_time})` : ''}
                </p>
              </div>
              <div class="next__timer">
                <EventCountdown
                  client:load
                  targetDate={countdownTarget}
                  status={nextStage.status ?? 'UPCOMING'}
                  label="LARGADA OFICIAL"
                />
              </div>
              <div class="next__actions">
                <a class="btn btn--solid" href="/inscripciones">
                  <span>Inscribirse</span>
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </a>
                <a class="btn btn--ghost" href={`/fechas/${nextStage.slug}`}>
                  <span>Ficha de ruta</span>
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.5 14V9.5A2.5 2.5 0 0 1 5 7h6a2.5 2.5 0 0 0 2.5-2.5V2" />
                    <circle cx="13.5" cy="2" r="1.4" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        )
      }
    </section>

    <!-- ── 01 · Fechas y Eventos 2026 ──────────────────────────────── -->
    <section class="section container" id="fechas">
      <SectionLabel number="01" label="Calendario de carreras 2026" kicker="COPA MACROSUR MTB & CLÁSICAS DE RUTA" />

      <TimelineEvents />
    </section>

    <!-- ── 02 · Clasificación ─────────────────────────────────────────── -->
    <section class="section container" id="clasificacion">
      <SectionLabel number="02" label="Clasificación" kicker="ACUMULADO TRAS LAS FECHAS DISPUTADAS" />

      <div class="panels panels--three">
        <PodiumPanel
          kicker="[ PRO · TODOS ]"
          rows={proPodium.rows}
          error={proPodium.error}
          body="Líder del acumulado PRO sumando todas sus categorías: Elite, Master A, Master B y Master C."
          href="/ranking-general?tabla=PRO"
        />

        <PodiumPanel
          kicker="[ NORMAL · TODOS ]"
          rows={normalPodium.rows}
          error={normalPodium.error}
          body="Líder del acumulado NORMAL sumando todas sus categorías: Turismo, Master D, Damas y Juveniles."
          href="/ranking-general?tabla=NORMAL"
        />

        <PodiumPanel
          kicker="[ COPA DE EQUIPOS ]"
          rows={topTeams}
          error={teamsError}
          body="Líder de la Copa de Equipos acumulada del campeonato."
          href="/ranking-general?tabla=EQUIPO"
          scope="team"
        />
      </div>
    </section>

    <!-- ── 03 · Premios ───────────────────────────────────────────────── -->
    <section class="section container" id="premios">
      <SectionLabel number="03" label="Premios" kicker="EN DÓLARES · EDICIÓN 2026" />

      <div class="panels panels--three">
        {
          ACCUMULATED_PRIZES.map((prize) => (
            <PrizeScale
              label="ACUMULADO"
              title={prize.label}
              body={prize.blurb}
              tiers={prize.tiers}
              currency={PRIZE_CURRENCY}
              accent={prize.scope === 'PRO' ? 'pro' : 'normal'}
              tags={['CAMPEONATO']}
            />
          ))
        }

        <PrizeScale
          label="POR FECHA"
          title="CADA CATEGORÍA"
          body="El podio de cada una de las 11 categorías, en cada una de las cuatro fechas."
          tiers={PER_DATE_PRIZES}
          currency={PRIZE_CURRENCY}
          accent="gold"
          tags={['11 CATEGORÍAS', '4 FECHAS']}
        />
      </div>

      <div class="panel panel--awards">
        <div class="panel__head font-mono">[ PREMIOS ESPECIALES ]</div>

        {
          awards.length > 0 ? (
            awards.map((award) => (
              <div class="award">
                {award.sponsor_logo_url && (
                  <img src={award.sponsor_logo_url} alt={award.title} loading="lazy" />
                )}
                <div>
                  <h4 class="award__name">{award.title}</h4>
                  {award.prize_description && (
                    <p class="award__text font-mono">{award.prize_description}</p>
                  )}
                </div>
              </div>
            ))
          ) : (
            <p class="panel__body">Los premios especiales se anuncian al cerrar la fecha.</p>
          )
        }

        <a class="panel__cta" href="/premios">Ver todos los premios →</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Showcase>

<style>
  /* ── Botones ─────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    border: var(--hairline) solid transparent;
    border-radius: var(--radius);
    white-space: nowrap;
    text-decoration: none;
    transition:
      background var(--default-transition-duration) var(--default-transition-timing-function),
      border-color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .btn--solid {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .btn--solid:hover {
    background: var(--accent);
    color: #fff;
  }

  .btn--ghost {
    border-color: var(--line);
    color: var(--ink);
  }

  .btn--ghost:hover {
    border-color: var(--line-strong);
    background: var(--bg-raised);
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Altura estimada de la tarjeta para anclar la línea base de la cordillera */
    --hero-next-height: 14rem;
    /* Ocupa el primer viewport completo, descontando la cabecera */
    min-height: calc(100vh - var(--header-offset-mobile, 4rem));
    min-height: calc(100svh - var(--header-offset-mobile, 4rem));
    text-align: center;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 3rem 2rem;
  }

  .hero__eyebrow {
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    /* El oro de la copa: en el póster oficial "EDICIÓN 2026" también va en
       amarillo. Es el único color del hero. */
    color: var(--copa-gold);
  }

  .hero__copy {
    margin-top: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .hero__meta a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .hero__meta a:hover {
    color: var(--ink);
  }

  /* ── Banda próxima fecha (dentro del hero) ───────────────────────────── */
  .hero__next {
    position: relative;
    z-index: 2;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: var(--hairline) solid var(--line);
  }

  .next__inner {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding-block: 1.5rem;
  }

  .next__timer {
    display: flex;
    align-items: center;
  }

  .next__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .next__meta > span {
    white-space: nowrap;
  }

  .next__dot {
    width: 0.375rem;
    height: 0.375rem;
    flex: 0 0 auto;
    background: var(--ink);
  }

  .next__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  @media (min-width: 48em) {
    .next__title {
      font-size: var(--text-3xl);
    }
  }

  .next__specs {
    margin: 0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .next__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ── Secciones ───────────────────────────────────────────────────────── */
  .section {
    padding-block: 0;
  }

  .section + .section {
    margin-top: 3rem;
  }

  /* ── Paneles ─────────────────────────────────────────────────────────── */
  .panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 4rem;
  }

  /* La sección de premios cierra con la tarjeta de premios especiales. */
  .panel--awards {
    margin-top: -2.5rem;
    margin-bottom: 4rem;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
  }

  .panel__head {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .panel__body {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .award {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1rem;
    align-items: center;
    padding-block: 0.75rem;
    border-top: var(--hairline) solid var(--line);
  }

  .award img {
    display: block;
    width: 4rem;
    height: 4rem;
    object-fit: cover;
    border: var(--hairline) solid var(--line);
  }

  .award__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  .award__text {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .panel__cta {
    margin-top: auto;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: none;
  }

  .panel__cta:hover {
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  /* ── Móvil & Tablet Ajustes de Espaciado ────────────────────────────── */
  @media (max-width: 48em) {
    .hero__content {
      padding-block: 1.75rem 1rem;
    }

    .hero__eyebrow {
      margin-bottom: 0.75rem;
    }

    .hero__copy {
      margin-top: 0.85rem;
    }

    .hero__actions {
      margin-top: 1.25rem;
    }

    .hero__meta {
      margin: 1rem 0 0;
    }

    /* ── La banda de la próxima fecha, en móvil ──────────────────────────
       Se queda con lo esencial: la fecha, el nombre real de la carrera, el
       cronómetro y los botones. Se van el rótulo "[ PRÓXIMA FECHA ]" (la
       banda ya se entiende por estar en el hero) y la línea de datos
       (47.2 KM · +761 M · PARTIDA: …), que en 390 px ocupaba dos renglones
       de monoespaciada y era lo que más ruido metía. */
    .next__label,
    .next__specs {
      display: none;
    }

    .next__inner {
      padding-block: 1.15rem;
      gap: 0.85rem;
    }

    .next__title {
      font-size: var(--text-xl);
    }
  }

  @media (max-width: 32em) {
    .hero {
      --hero-next-height: 16.5rem;
    }
  }

  /* ── Desktop ─────────────────────────────────────────────────────────── */
  @media (min-width: 48em) {
    .hero {
      --hero-next-height: 5.5rem;
      min-height: calc(100vh - var(--header-offset, 3.0625rem));
      min-height: calc(100svh - var(--header-offset, 3.0625rem));
    }

    .hero__content {
      padding-block: 4rem 3rem;
    }

    .next__inner {
      grid-template-columns: auto 1fr;
      padding-block: 1.75rem;
    }

    .next__timer {
      grid-column: 1 / -1;
      justify-self: start;
    }

    .section + .section {
      margin-top: 4rem;
    }

    .panels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68.75em) {
    .hero {
      --hero-next-height: 5.25rem;
    }

    /* Tres clasificaciones y tres bloques de premios en una sola línea. */
    .panels--three {
      grid-template-columns: repeat(3, 1fr);
    }

    /* En la banda ancha la fecha se apila ARRIBA del nombre de la carrera, en
       la misma columna. Con la fecha en su propia columna el nombre real
       ("El Retorno a los Poblados 2") se partía en dos renglones y los datos
       de la carrera en otros dos: cuatro renglones de ruido en una línea. */
    .next__inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas:
        'meta timer actions'
        'main timer actions';
      column-gap: 2.5rem;
      row-gap: 0.375rem;
    }

    .next__meta {
      grid-area: meta;
    }

    .next__main {
      grid-area: main;
      /* El hero va centrado (`text-align: center` en `.hero`); esta pila se
         alinea a la izquierda, como un bloque de título. */
      text-align: left;
    }

    .next__timer {
      grid-area: timer;
      grid-column: auto;
      justify-self: center;
      align-self: center;
    }

    .next__actions {
      grid-area: actions;
      align-self: center;
    }
  }
</style>
