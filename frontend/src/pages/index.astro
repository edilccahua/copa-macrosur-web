---
import Showcase from '../layouts/Showcase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroWordmark from '../components/HeroWordmark.astro';
import DisplayTitle from '../components/DisplayTitle.astro';
import HeroScene from '../components/HeroScene.astro';
import SectionLabel from '../components/bento/SectionLabel.astro';
import PodiumPanel from '../components/PodiumPanel.astro';
import PrizeScale from '../components/PrizeScale.astro';
import LiveSection from '../components/LiveSection.svelte';
import Icon from '../components/Icon.astro';
import EventCountdown from '../components/svelte/EventCountdown.svelte';
import TimelineEvents from '../components/TimelineEvents.astro';
import {
  getHomeBundle,
  type HomeBundle,
  type LiveStageBrief,
  type LiveStatus,
  type MountainTitle,
} from '../lib/api';
import { formatStageDate } from '../lib/stages';
import { SITE_NAME, BRAND_WORDMARK, BRAND_ACCENT, BRAND_EDITION } from '../data/site';
import {
  ACCUMULATED_PRIZES,
  PER_DATE_PRIZES,
  PER_DATE_PRIZE_ICON,
  PRIZE_CURRENCY,
} from '../data/prizes';
import { MOUNTAIN_TITLES } from '../data/mountain-titles';
import type { PrizeLeader } from '../components/PrizeScale.astro';

/**
 * Las tres clasificaciones de la portada se leen de la API. SIN datos
 * literales: cualquier cifra de respaldo quedaría desactualizada y pondría
 * de líder a quien no toca (specs/03 §0.2).
 *
 * · PRO · TODOS    → acumulado del grupo PRO (todas sus categorías)
 * · NORMAL · TODOS → acumulado del grupo NORMAL (todas sus categorías)
 * · EQUIPO         → Copa de Equipos acumulada
 */
type PodiumRow = { name: string; points: number; slug?: string };

/** Una fila del podio agregado por la API, en la forma de la tarjeta. */
function aPodiumRow(fila: { rider_name: string; total_points: number; rider_slug?: string | null }): PodiumRow {
  return {
    name: fila.rider_name,
    points: fila.total_points,
    slug: fila.rider_slug ?? undefined,
  };
}

/**
 * LA PORTADA SE LEE EN UNA SOLA LLAMADA.
 *
 * Antes eran siete (dos clasificaciones, la de equipos, el calendario, el
 * estado en vivo, los títulos de montaña y el premio CLARO) y todas salían
 * del SSR de Cloudflare, que no cachea el HTML: siete esperas de red para
 * construir una página. Ahora la API devuelve el agregado entero en una
 * respuesta y el backend lo cachea 60 s.
 *
 * Si la llamada falla, la portada degrada como antes: secciones vacías y el
 * aviso "no pudimos cargar" en los podios. Nunca inventa datos.
 */
let bundle: HomeBundle | null = null;
let cargaFallida = true;
try {
  bundle = await getHomeBundle();
  cargaFallida = false;
} catch (e) {
  bundle = null;
}

const stages = bundle?.stages ?? [];
const proPodium = {
  rows: (bundle?.pro_podium ?? []).map(aPodiumRow),
  error: cargaFallida,
};
const normalPodium = {
  rows: (bundle?.normal_podium ?? []).map(aPodiumRow),
  error: cargaFallida,
};
const topTeams = (bundle?.teams_podium ?? []).map((fila) => ({
  name: fila.team_name,
  points: fila.total_points,
}));
const teamsError = cargaFallida;
const liveStatusRaw = bundle?.live_status ?? null;
const mountain: Record<'kom' | 'qom' | 'kamikaze_male' | 'kamikaze_female', MountainTitle | null> =
  bundle?.mountain_titles ?? {
    kom: null,
    qom: null,
    kamikaze_male: null,
    kamikaze_female: null,
  };
const remontada = bundle?.remontada ?? null;

const nextStage =
  stages.find((s) => s.status === 'REGISTRATION_OPEN') ??
  stages.find((s) => s.status === 'UPCOMING') ??
  null;

/**
 * El premio acumulado se paga al LÍDER de la agrupación. Mientras el
 * campeonato no se cierra, ese líder sólo es provisional: la tarjeta lo dice
 * con su nombre en vez de un "por anunciar" vacío.
 *
 * El recuento de fechas sale del Premio CLARO (`remontada`), que ya se pide
 * para esta portada: no cuesta una petición extra.
 */
function provisionalLeader(rows: PodiumRow[]): PrizeLeader | null {
  const top = rows[0];
  if (!top) return null;
  return {
    name: top.name,
    slug: top.slug,
    points: top.points,
    stagesCounted: remontada?.stages_counted ?? 0,
    totalStages: remontada?.total_stages ?? 0,
  };
}

function toLiveBrief(s: typeof nextStage): LiveStageBrief | null {
  if (!s) return null;
  return {
    id: s.id,
    stage_number: s.stage_number,
    name: s.name,
    short_name: s.short_name ?? null,
    slug: s.slug,
    date: s.date,
    status: s.status ?? 'UPCOMING',
    start_time: s.start_time ?? null,
    poster_url: s.poster_url ?? null,
  };
}

const fallbackBrief = toLiveBrief(nextStage);
const liveStatus: LiveStatus = liveStatusRaw ?? {
  active: false,
  state: 'no_race_today',
  stage: fallbackBrief,
  next_stage: fallbackBrief,
  opens_at: null,
  closed_at: null,
};

// Cache-Control para que Cloudflare Pages Edge sirva la portada en milisegundos
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=30'
);

const countdownTarget = nextStage
  ? `${nextStage.date}T${(nextStage.start_time ?? '08:00').replace(' AM', '').replace(' PM', '')}:00-05:00`
  : '';

/**
 * El nombre REAL de la fecha ("El Retorno a los Poblados 2"), no el corto
 * ("Poblados"): el corto era para el índice compacto del hero.
 */
const nextStageName = nextStage
  ? nextStage.name.replace(/^Fecha\s+\d+\s*:\s*/i, '')
  : '';

/**
 * DISTANCIA y DESNIVEL son POR VUELTA en la BD (specs/01 §1.4): en una
 * fecha de varias vueltas hay que multiplicar por las vueltas para no
 * prometer un tercio de la carrera. Una fecha sin ruta publicada no tiene
 * cifras: entonces la banda lo dice.
 */
const nextLaps = Math.max(1, nextStage?.laps ?? 1);
const nextKmLap = nextStage?.distance_km ?? null;
const nextKmTotal = nextKmLap != null ? nextKmLap * nextLaps : null;
const nextGainLap = nextStage?.elevation_gain_m ?? null;
const nextGainTotal = nextGainLap != null ? nextGainLap * nextLaps : null;
const nextDistanceText =
  nextKmLap == null
    ? 'DISTANCIA POR CONFIRMAR'
    : nextLaps > 1
      ? `${nextKmLap.toFixed(2)} KM × ${nextLaps} VUELTAS = ${nextKmTotal!.toFixed(2)} KM`
      : `${nextKmTotal!.toFixed(2)} KM`;
---
<Showcase
  title={`${SITE_NAME} — Campeonato Oficial 2026`}
  sections={[
    { label: 'Fechas', id: 'fechas' },
    { label: 'Clasificación', id: 'clasificacion' },
    { label: 'Premios', id: 'premios' },
    { label: 'Transmisión', id: 'envivo' },
  ]}
>
  <SiteHeader />

  <main class="home">
    <!-- ── Hero editorial con escena (El Misti + sol/luna) ─────────────── -->
    <section class="hero" data-draw>
      <HeroScene />

      <div class="hero__content container">
        <div class="hero__eyebrow" data-draw-eyebrow>[ {BRAND_EDITION} ]</div>

        <HeroWordmark text={BRAND_WORDMARK} accent={BRAND_ACCENT} />

        <div class="hero__copy" data-hero-copy>
          <DisplayTitle size="hero" before="Cuatro fechas de MTB en " accent="Arequipa." />
        </div>

        <div class="hero__actions" data-hero-copy>
          <a class="btn btn--ghost" href="/ranking-general">
            <span>Ver ranking</span>
            <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <path d="M3 13V9.5M8 13V5.5M13 13V2.5"/>
            </svg>
          </a>
        </div>

        <ul class="hero__meta" data-hero-copy>
          {
            stages.map((s) => (
              <li>
                <a href={`/fechas/${s.slug}`}>{s.short_name || s.name.replace(/^Fecha\s+\d+\s*:\s*/i, '')}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Próxima fecha dentro del primer viewport -->
      {
        nextStage && (
          <div class="hero__next" id="proxima">
            <div class="next__inner container">
              <div class="next__meta">
                <span class="next__dot" aria-hidden="true" />
                <span class="next__label">[ PRÓXIMA FECHA ]</span>
                <span>{formatStageDate(nextStage.date)}</span>
              </div>
              <div class="next__main">
                <h2 class="next__title">{nextStageName}</h2>
                <p class="next__specs">
                  {nextDistanceText}
                  {nextGainTotal != null ? ` · +${nextGainTotal} M` : ''}
                  {nextStage?.start_location ? ` · PARTIDA: ${nextStage.start_location.toUpperCase()}` : ''}
                  {nextStage?.start_time ? ` (${nextStage.start_time})` : ''}
                </p>
              </div>
              <div class="next__timer">
                <EventCountdown
                  client:load
                  targetDate={countdownTarget}
                  status={nextStage.status ?? 'UPCOMING'}
                  label="LARGADA OFICIAL"
                />
              </div>
              <div class="next__actions">
                <a class="btn btn--solid" href="/inscripciones">
                  <span>Inscribirse</span>
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </a>
                <a class="btn btn--ghost" href={`/fechas/${nextStage.slug}`}>
                  <span>Ficha de ruta</span>
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.5 14V9.5A2.5 2.5 0 0 1 5 7h6a2.5 2.5 0 0 0 2.5-2.5V2" />
                    <circle cx="13.5" cy="2" r="1.4" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        )
      }
    </section>

    <!-- ── 01 · Fechas y Eventos 2026 ──────────────────────────────── -->
    <section class="section container" id="fechas">
      <SectionLabel number="01" label="Calendario de carreras 2026" kicker="COPA MACROSUR MTB & CLÁSICAS DE RUTA" />

      <TimelineEvents />
    </section>

    <!-- ── 02 · Clasificación ─────────────────────────────────────────── -->
    <section class="section container" id="clasificacion">
      <SectionLabel number="02" label="Clasificación" kicker="ACUMULADO TRAS LAS FECHAS DISPUTADAS" />

      <div class="panels panels--three">
        <PodiumPanel
          kicker="[ PRO · TODOS ]"
          rows={proPodium.rows}
          error={proPodium.error}
          body="Los tres primeros del acumulado PRO, sumando todas sus categorías: Elite, Master A, Master B y Master C."
          href="/ranking-general?tabla=PRO"
        />

        <PodiumPanel
          kicker="[ NORMAL · TODOS ]"
          rows={normalPodium.rows}
          error={normalPodium.error}
          body="Los tres primeros del acumulado NORMAL, sumando todas sus categorías: Turismo, Master D, Damas y Juveniles."
          href="/ranking-general?tabla=NORMAL"
        />

        <PodiumPanel
          kicker="[ COPA DE EQUIPOS ]"
          rows={topTeams}
          error={teamsError}
          body="Los tres clubes con más puntos de la Copa de Equipos acumulada."
          href="/ranking-general?tabla=EQUIPO"
          scope="team"
        />
      </div>
    </section>

    <!-- ── 03 · Premios ───────────────────────────────────────────────── -->
    <section class="section container" id="premios">
      <SectionLabel number="03" label="Premios" kicker="EN DÓLARES · EDICIÓN 2026" />

      <div class="panels panels--three">
        {
          ACCUMULATED_PRIZES.map((prize) => (
            <PrizeScale
              label="ACUMULADO"
              title={prize.label}
              body={prize.blurb}
              tiers={prize.tiers}
              currency={PRIZE_CURRENCY}
              accent={prize.scope === 'PRO' ? 'pro' : 'normal'}
              icon={prize.icon}
              leader={provisionalLeader(
                prize.scope === 'PRO' ? proPodium.rows : normalPodium.rows
              )}
              tags={['PODIO DE LA AGRUPACIÓN']}
            />
          ))
        }

        <PrizeScale
          label="POR FECHA"
          title="CADA CATEGORÍA"
          body="El podio de cada una de las 11 categorías, en cada una de las cuatro fechas."
          tiers={PER_DATE_PRIZES}
          currency={PRIZE_CURRENCY}
          accent="gold"
          icon={PER_DATE_PRIZE_ICON}
          status="CADA FECHA"
          tags={['11 CATEGORÍAS', '4 FECHAS']}
        />
      </div>

      <div class="specials">
        <div class="specials__head">
          <span class="specials__label font-mono">[ PREMIOS ESPECIALES ]</span>
          <span class="specials__meta font-mono">USD 100 + 4 × USD 15</span>
        </div>

        <div class="special-grid">
          <article class="special special--claro">
            <div class="special__media special__media--logo">
              <img
                src={remontada?.sponsor_logo_url ?? '/images/sponsors/claro.svg'}
                alt="Claro"
                loading="lazy"
              />
            </div>
            <p class="special__label font-mono">ACUMULADO · 4 FECHAS</p>
            <h4 class="special__title">{remontada?.title ?? 'Premio CLARO'}</h4>
            <p class="special__amount font-mono">
              USD {remontada?.amount_usd ?? 100}
            </p>
            <p class="special__winner font-mono">
              {
                remontada?.winner
                  ? `${remontada.provisional ? 'PROVISIONAL' : 'GANADOR'}: ${remontada.winner.rider_name}`
                  : 'POR ANUNCIAR'
              }
            </p>
          </article>

          {
            MOUNTAIN_TITLES.map((definition) => (
              <article class="special">
                <div class="special__media special__media--icon">
                  <Icon name={definition.icon} size={28} />
                </div>
                <p class="special__label font-mono">TÍTULO DE MONTAÑA</p>
                <h4 class="special__title">{definition.title}</h4>
                <p class="special__amount font-mono">USD {definition.amountUsd} · UNO POR FECHA</p>
                <p class="special__winner font-mono">
                  {mountain[definition.key]?.athlete_name ?? 'SIN GANADOR TODAVÍA'}
                </p>
              </article>
            ))
          }
        </div>

        <a class="panel__cta" href="/premios">Ver todos los premios →</a>
      </div>
    </section>

    <!-- ── 04 · Transmisión en vivo ──────────────────────────────────── -->
    <section class="section container" id="envivo">
      <SectionLabel
        number="04"
        label="Transmisión"
        kicker="SEGUIMIENTO DE LLEGADAS EN VIVO"
      />

      <LiveSection client:visible initial={liveStatus} />
    </section>
  </main>

  <SiteFooter />
</Showcase>

<style>
  /* ── Botones ─────────────────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    border: var(--hairline) solid transparent;
    border-radius: var(--radius);
    white-space: nowrap;
    text-decoration: none;
    transition:
      background var(--default-transition-duration) var(--default-transition-timing-function),
      border-color var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .btn--solid {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .btn--solid:hover {
    background: var(--accent);
    color: #fff;
  }

  .btn--ghost {
    border-color: var(--line);
    color: var(--ink);
  }

  .btn--ghost:hover {
    border-color: var(--line-strong);
    background: var(--bg-raised);
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Altura estimada de la tarjeta para anclar la línea base de la cordillera */
    --hero-next-height: 14rem;
    /* Ocupa el primer viewport completo, descontando la cabecera */
    min-height: calc(100vh - var(--header-offset-mobile, 4rem));
    min-height: calc(100svh - var(--header-offset-mobile, 4rem));
    text-align: center;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 3rem 2rem;
  }

  .hero__eyebrow {
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    /* El oro de la copa: en el póster oficial "EDICIÓN 2026" también va en
       amarillo. Es el único color del hero. */
    color: var(--copa-gold);
  }

  .hero__copy {
    margin-top: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--faint);
  }

  .hero__meta a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.1875rem;
  }

  .hero__meta a:hover {
    color: var(--ink);
  }

  /* ── Banda próxima fecha (dentro del hero) ───────────────────────────── */
  .hero__next {
    position: relative;
    z-index: 2;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: var(--hairline) solid var(--line);
  }

  .next__inner {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding-block: 1.5rem;
  }

  .next__timer {
    display: flex;
    align-items: center;
  }

  .next__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }

  .next__meta > span {
    white-space: nowrap;
  }

  .next__dot {
    width: 0.375rem;
    height: 0.375rem;
    flex: 0 0 auto;
    background: var(--ink);
  }

  .next__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  @media (min-width: 48em) {
    .next__title {
      font-size: var(--text-3xl);
    }
  }

  .next__specs {
    margin: 0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .next__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ── Secciones ───────────────────────────────────────────────────────── */
  .section {
    padding-block: 0;
  }

  .section + .section {
    margin-top: 3rem;
  }

  /* ── Paneles ─────────────────────────────────────────────────────────── */
  .panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 4rem;
  }

  /* ── Premios especiales (CLARO + títulos de montaña) ─────────────────── */
  .specials {
    margin-top: -2.5rem;
    margin-bottom: 4rem;
  }

  .specials__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .specials__label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .specials__meta {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--faint);
    white-space: nowrap;
  }

  .special-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .special {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
  }

  .special__media {
    display: grid;
    place-items: center;
    height: 4.5rem;
    background: var(--bg-sunken);
    border: var(--hairline) solid var(--line);
    color: var(--copa-gold);
  }

  .special__media--logo {
    padding: 0.5rem;
    background: #fff;
  }

  .special__media--logo img {
    display: block;
    max-width: 100%;
    max-height: 3rem;
    object-fit: contain;
  }

  .special__label {
    margin: 0;
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--faint);
  }

  .special__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  .special__amount {
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--copa-gold);
  }

  .special__winner {
    margin: auto 0 0;
    padding-top: 0.6rem;
    border-top: var(--hairline) solid var(--line);
    font-size: 0.5625rem;
    line-height: 1.5;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .specials .panel__cta {
    margin-top: 1rem;
  }

  .panel__cta {
    margin-top: auto;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: none;
  }

  .panel__cta:hover {
    text-decoration: underline;
