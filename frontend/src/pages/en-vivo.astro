---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LiveLeaderboard from '../components/svelte/LiveLeaderboard.svelte';
import { API_V1, type LiveStatus } from '../lib/api';
import { formatStageDate } from '../lib/stages';
import { toDisplayTime } from '../lib/datetime';

/**
 * La página NO decide por su cuenta si hay carrera en vivo: lee el mismo
 * estado que la portada (`GET /public/live-status`, specs/02 §6).
 *
 *   live          → tablero SSE
 *   before_start  → hoy hay carrera, abre a las 08:00
 *   closed        → el admin cerró la transmisión
 *   no_race_today → próxima fecha
 */
let status: LiveStatus | null = null;
let apiError = false;

try {
  const res = await fetch(`${API_V1}/public/live-status`, { cache: 'no-store' });
  if (res.ok) {
    status = await res.json();
  } else {
    apiError = true;
  }
} catch (e) {
  apiError = true;
}

const state = status?.state ?? 'no_race_today';
const stage = status?.stage ?? null;
const nextStage = status?.next_stage ?? null;
const isLive = state === 'live';

const stageName = stage ? stage.name.replace(/^Fecha\s+\d+\s*:\s*/i, '') : '';
const nextStageName = nextStage
  ? nextStage.name.replace(/^Fecha\s+\d+\s*:\s*/i, '')
  : '';
const openTime = stage ? toDisplayTime(stage.start_time) : '08:00 HRS';
const resultsHref = stage
  ? `/ranking-general?modo=fecha&fecha=${stage.stage_number}`
  : '/ranking-general';

const title = isLive
  ? 'TIEMPOS Y LLEGADAS EN VIVO'
  : state === 'before_start'
    ? 'LA TRANSMISIÓN ABRE HOY'
    : state === 'closed'
      ? 'TRANSMISIÓN FINALIZADA'
      : 'TIEMPOS Y LLEGADAS EN VIVO';

const description = isLive
  ? 'Transmisión directa de las marcaciones de los jueces de meta. Los tiempos y puestos se actualizan a medida que los ciclistas cruzan la línea.'
  : state === 'before_start'
    ? `Hoy se corre ${stageName}. La transmisión de llegadas se abre a las ${openTime}; vuelve a esta página a esa hora.`
    : state === 'closed'
      ? 'La transmisión de llegadas terminó. Consulta la clasificación oficial de la fecha.'
      : 'El seguimiento en vivo se abre el día de la carrera a las 08:00 y se cierra cuando el organizador lo indica. Mientras tanto, puedes consultar las clasificaciones y los resultados de las fechas disputadas.';
---

<Base title="Cronometraje En Vivo — Copa MacroSur MTB">
  <SiteHeader />

  <main class="container page-content">
    <div class="page-header">
      {
        isLive ? (
          <div class="live-pill font-mono">
            <span class="live-pulse-dot" aria-hidden="true" />
            <span>[ TRANSMISIÓN EN VIVO // LLEGADAS A META ]</span>
          </div>
        ) : state === 'before_start' ? (
          <div class="live-pill live-pill--off font-mono">
            <span>[ HOY · ABRE {openTime} ]</span>
          </div>
        ) : state === 'closed' ? (
          <div class="live-pill live-pill--off font-mono">
            <span>[ TRANSMISIÓN FINALIZADA ]</span>
          </div>
        ) : (
          <div class="live-pill live-pill--off font-mono">
            <span>[ SIN TRANSMISIÓN EN ESTE MOMENTO ]</span>
          </div>
        )
      }
      <h1 class="page-title">{title}</h1>
      <p class="page-desc">{description}</p>
    </div>

    {
      isLive && stage ? (
        <LiveLeaderboard client:load stageId={stage.id} stageName={stage.name} />
      ) : (
        <div class="offline-card">
          {apiError && (
            <p class="offline-text">
              No pudimos contactar al servidor de cronometraje. Vuelve a intentarlo en unos
              segundos.
            </p>
          )}

          {state === 'closed' && (
            <>
              <p class="offline-text">
                La transmisión de <strong>{stageName}</strong> ya cerró. Los resultados oficiales
                están en la clasificación de la fecha.
              </p>
              <a class="offline-link font-mono" href={resultsHref}>
                VER RESULTADOS DE LA FECHA →
              </a>
            </>
          )}

          {state === 'before_start' && (
            <p class="offline-text">
              La carrera de hoy es <strong>{stageName}</strong>. Las llegadas se transmiten desde
              las {openTime}; esta página se activa sola a esa hora.
            </p>
          )}

          {state === 'no_race_today' && (
            <>
              {nextStage ? (
                <p class="offline-text">
                  La próxima fecha es <strong>{nextStageName}</strong>, el{' '}
                  {formatStageDate(nextStage.date)} a las {toDisplayTime(nextStage.start_time)}. El
                  seguimiento de llegadas se abre ese día a las 08:00.
                </p>
              ) : (
                <p class="offline-text">
                  El calendario de la edición ya terminó. Consulta las clasificaciones oficiales.
                </p>
              )}
              <a class="offline-link font-mono" href="/ranking-general">
                VER CLASIFICACIONES →
              </a>
            </>
          )}
        </div>
      )
    }
  </main>

  <SiteFooter />
</Base>

<style>
  .page-content {
    padding-top: 3rem;
  }

  .page-header {
    border-bottom: var(--hairline) solid var(--line);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.625rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
  }

  /* Sin transmisión no se enciende el punto rojo: sería una señal falsa. */
  .live-pill--off {
    color: var(--muted);
  }

  .offline-card {
    padding: 1.5rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
  }

  .offline-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .offline-text + .offline-text {
    margin-top: 0.75rem;
  }

  .offline-link {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--invert-fg);
    background: var(--invert-bg);
    text-decoration: none;
  }

  .offline-link:hover {
    background: var(--accent);
    color: #fff;
  }

  .live-pulse-dot {
    width: 0.375rem;
    height: 0.375rem;
    background: #ff3b30;
    box-shadow: 0 0 0.375rem #ff3b30;
    display: inline-block;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .page-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
  }

  .page-desc {
    max-width: 42.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
