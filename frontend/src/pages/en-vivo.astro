---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LiveLeaderboard from '../components/svelte/LiveLeaderboard.svelte';
import { API_V1 } from '../lib/api';

interface StageBrief {
  id: number;
  stage_number: number;
  name: string;
  slug: string;
  date: string;
  status: string;
}

/**
 * Sólo se retransmite lo que está EN VIVO de verdad. Antes la página elegía
 * "LIVE o, si no, la siguiente con inscripciones abiertas" y se presented
 * como una transmisión en vivo de una carrera que no había empezado.
 */
let liveStage: StageBrief | null = null;
let nextStage: StageBrief | null = null;
let apiError = false;

try {
  const res = await fetch(`${API_V1}/stages`);
  if (res.ok) {
    const stages: StageBrief[] = await res.json();
    liveStage = stages.find((s) => s.status === 'LIVE') ?? null;
    nextStage =
      stages.find((s) => s.status === 'REGISTRATION_OPEN') ??
      stages.find((s) => s.status === 'UPCOMING') ??
      null;
  } else {
    apiError = true;
  }
} catch (e) {
  apiError = true;
}
---
<Base title="Cronometraje En Vivo — Copa MacroSur MTB">
  <SiteHeader />

  <main class="container page-content">
    <div class="page-header">
      {
        liveStage ? (
          <div class="live-pill font-mono">
            <span class="live-pulse-dot" aria-hidden="true" />
            <span>[ TRANSMISIÓN EN VIVO // CANAL SSE ]</span>
          </div>
        ) : (
          <div class="live-pill live-pill--off font-mono">
            <span>[ SIN TRANSMISIÓN EN ESTE MOMENTO ]</span>
          </div>
        )
      }
      <h1 class="page-title">TIEMPOS Y LLEGADAS EN VIVO</h1>
      <p class="page-desc">
        {
          liveStage
            ? 'Transmisión directa de las marcaciones de los jueces de meta mediante Server-Sent Events (SSE). Los tiempos y deltas se actualizan instantáneamente sin recargar la página.'
            : 'El cronómetro en vivo se abre cuando hay una fecha en disputa. Mientras tanto, puedes consultar las clasificaciones y los resultados de las fechas ya disputadas.'
        }
      </p>
    </div>

    {
      liveStage ? (
        <LiveLeaderboard client:load stageId={liveStage.id} stageName={liveStage.name} />
      ) : (
        <div class="offline-card">
          {apiError && (
            <p class="offline-text">No pudimos contactar al servidor de cronometraje. Vuelve a intentarlo en unos segundos.</p>
          )}
          {nextStage && (
            <p class="offline-text">
              La próxima fecha del campeonato es la <strong>{nextStage.name}</strong>. El cronómetro se
              abrirá el día de la carrera.
            </p>
          )}
          <a class="offline-link font-mono" href="/ranking-general">
            VER CLASIFICACIONES →
          </a>
        </div>
      )
    }
  </main>

  <SiteFooter />
</Base>

<style>
  .page-content {
    padding-top: 3rem;
  }

  .page-header {
    border-bottom: var(--hairline) solid var(--line);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.625rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
  }

  /* Sin transmisión no se enciende el punto rojo: sería una señal falsa. */
  .live-pill--off {
    color: var(--muted);
  }

  .offline-card {
    padding: 1.5rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
  }

  .offline-text {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .offline-text + .offline-text {
    margin-top: 0.75rem;
  }

  .offline-link {
    display: inline-block;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--invert-fg);
    background: var(--invert-bg);
    text-decoration: none;
  }

  .offline-link:hover {
    background: var(--accent);
    color: #fff;
  }

  .live-pulse-dot {
    width: 0.375rem;
    height: 0.375rem;
    background: #ff3b30;
    box-shadow: 0 0 0.375rem #ff3b30;
    display: inline-block;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .page-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
  }

  .page-desc {
    max-width: 42.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
