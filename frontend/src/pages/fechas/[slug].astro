---
/**
 * Ficha de una fecha del campeonato.
 *
 * Ruta dinámica en SSR: el slug se resuelve contra
 * `GET /api/v1/stages/{slug}/summary` en cada request. Si la fecha no existe
 * la respuesta es `404`; si el backend no responde, `503`. **La página no
 * contiene ningún dato literal**: todo viene del resumen (specs/03 §0.2).
 */
import Showcase from '../../layouts/Showcase.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import StageProfile from '../../components/StageProfile.astro';
import StageStatsRow from '../../components/StageStatsRow.astro';
import StageLeaderboard from '../../components/StageLeaderboard.astro';
import StageTeamCard from '../../components/StageTeamCard.astro';
import SectionLabel from '../../components/bento/SectionLabel.astro';
import EventCountdown from '../../components/svelte/EventCountdown.svelte';
import Icon from '../../components/Icon.astro';
import { getStageSummary, type StageSummary } from '../../lib/api';
import { toDisplayTime, toStartInstant } from '../../lib/datetime';

const { slug } = Astro.params;

let summary: StageSummary | null = null;
let notFound = false;
try {
  summary = await getStageSummary(String(slug));
} catch (e) {
  if (e instanceof Error && e.message === 'stage-not-found') {
    notFound = true;
    Astro.response.status = 404;
  } else {
    // El backend no responde: se dice, no se rellena con datos inventados.
    Astro.response.status = 503;
  }
}

const stage = summary?.stage;
const stats = summary?.stats;

// El nombre visible sin el prefijo "Fecha N:" (el eyebrow ya lo dice).
const displayName = String(stage?.title || stage?.name || '').replace(
  /^Fecha\s+\d+\s*:\s*/i,
  '',
);

// La distancia y el desnivel se leen de las dos medidas de la BD: por vuelta
// Y total. Mezclarlas fue el bug que mostraba +840 m en un sitio y +280 m en
// otro. Una fecha SIN ruta (la Fecha 4) no tiene cifras: se dice "por
// confirmar" en vez de inventar un 45 km.
const distLabel = !stats
  ? ''
  : stats.distance_km_per_lap == null
    ? 'POR CONFIRMAR'
    : stats.laps > 1
      ? `${stats.distance_km_per_lap} KM × ${stats.laps} VUELTAS = ${stats.distance_km_total} KM`
      : `${stats.distance_km_per_lap} KM`;
const elevLabel = !stats
  ? ''
  : stats.elevation_m_per_lap == null
    ? 'POR CONFIRMAR'
    : stats.laps > 1
      ? `+${stats.elevation_m_per_lap} M/VUELTA · +${stats.elevation_m_total} M TOTAL`
      : `+${stats.elevation_m_per_lap} M`;

const statusLabel =
  stage?.status === 'FINISHED'
    ? 'Finalizada'
    : stage?.status === 'REGISTRATION_OPEN'
      ? 'Inscripciones Abiertas'
      : stage?.status === 'LIVE'
        ? 'En Vivo'
        : 'Próximamente';

const synopsis =
  stats && stats.distance_km_per_lap == null
    ? 'Recorrido de MTB XC por confirmar.'
    : stats && stats.laps > 1
      ? `Circuito de ${stats.distance_km_per_lap} km por vuelta y +${stats.elevation_m_per_lap} m de desnivel por vuelta: ${stats.laps} vueltas para un total de ${stats.distance_km_total} km y +${stats.elevation_m_total} m.`
      : stats && stats.distance_km_per_lap != null
        ? `Recorrido de ${stats.distance_km_per_lap} km con +${stats.elevation_m_per_lap} m de desnivel positivo acumulado.`
        : 'Recorrido de MTB XC por confirmar.';

/**
 * Lo que PUBLICA el PDF oficial de resultados frente a lo que recalcula el
 * motor (specs/01 §3.1) se explica en el bloque de cifras de la jornada
 * (`StageStatsRow`): normalmente coinciden; en Z Xtreme no, porque el PDF no
 * imprime el 6º lugar de OPEN DAMAS.
 */

const posterCard = stage?.poster_url ?? '';
const posterFull = posterCard.replace('-card.webp', '-full.webp');
const gpxUrl = stage?.gpx_file_url ?? undefined;

/**
 * Los segmentos Strava, ordenados por tipo: primero las subidas, luego las
 * bajadas y por último los llanos. Dentro de cada grupo, los más largos.
 */
const segments = [...(summary?.strava ?? [])].sort((a, b) => {
  const rank = (kind: string) => (kind === 'CLIMB' ? 0 : kind === 'DESCENT' ? 1 : 2);
  const byKind = rank(a.kind) - rank(b.kind);
  if (byKind !== 0) return byKind;
  return b.distance_km - a.distance_km;
});

/**
 * Los cuatro títulos de montaña de la fecha, en el orden en que se muestran.
 * El KOM y el QOM son la misma subida: el mejor varón y la mejor dama. Los
 * Kamikaze son el mejor varón y la mejor dama en el descenso de la jornada.
 */
const mountainTitles = [
  {
    key: 'kom',
    label: 'KING OF THE MOUNTAIN',
    scope: 'VARÓN',
    accent: 'scope-pro',
    icon: 'mountain' as const,
    data: summary?.kom ?? null,
  },
  {
    key: 'qom',
    label: 'QUEEN OF THE MOUNTAIN',
    scope: 'DAMAS',
    accent: 'scope-team',
    icon: 'mountain' as const,
    data: summary?.qom ?? null,
  },
  {
    key: 'kamikaze-male',
    label: 'EL KAMIKAZE',
    scope: 'VARÓN',
    accent: 'scope-pro',
    icon: 'descent' as const,
    data: summary?.kamikaze_male ?? null,
  },
  {
    key: 'kamikaze-female',
    label: 'LA KAMIKAZE',
    scope: 'DAMAS',
    accent: 'scope-team',
    icon: 'descent' as const,
    data: summary?.kamikaze_female ?? null,
  },
].filter((title) => title.data !== null);

/**
 * Numeración de las secciones: consecutiva y sin huecos, aunque una fecha no
 * tenga podio, equipos, extremos o Strava. Los bloques que no aplican se
 * omiten enteros; los que aplican se numeran seguidos.
 */
const sections: { key: string; label: string; present: boolean }[] = [
  { key: 'stats', label: 'CIFRAS DE LA JORNADA', present: true },
  {
    key: 'podium',
    label: 'PODIO OFICIAL POR CATEGORÍA',
    present: (summary?.podium.length ?? 0) > 0,
  },
  {
    key: 'teams',
    label: 'PODIO DE CLUBES DE LA FECHA',
    present: (summary?.teams.length ?? 0) > 0,
  },
  {
    key: 'extremes',
    label: 'ESTADÍSTICAS EXTREMAS DE LA JORNADA',
    present: Boolean(summary?.extremes.scratch || summary?.extremes.farolito),
  },
  {
    key: 'route',
    label: 'PERFIL TÉCNICO Y RUTA DE CARRERA',
    present: Boolean(summary?.route_profile),
  },
  {
    key: 'titles',
    label: 'TÍTULOS DE MONTAÑA (KOM / QOM)',
    present: mountainTitles.length > 0,
  },
  {
    key: 'strava',
    label: 'SEGMENTOS OFICIALES STRAVA',
    present: segments.length > 0,
  },
  {
    key: 'awards',
    label: 'PREMIOS DE LA JORNADA',
    present: (summary?.awards.length ?? 0) > 0,
  },
];

/** Número de sección (01, 02, …) de una clave, o null si la sección no va. */
function sectionNumber(key: string): string | null {
  const present = sections.filter((s) => s.present);
  const index = present.findIndex((s) => s.key === key);
  return index >= 0 ? String(index + 1).padStart(2, '0') : null;
}
---

<Showcase title={`${displayName} — Copa MacroSur MTB`} ghostWord={stage ? `FECHA ${stage.stage_number}` : undefined}>
  <SiteHeader />

  <main class="container stage-page">
    {
      notFound ? (
        <section class="stage-hero" data-draw>
          <div class="hero-details">
            <div class="stage-tag font-mono" data-draw-eyebrow>[ FECHA NO ENCONTRADA ]</div>
            <h1 class="stage-title">Sin resultados para «{slug}»</h1>
            <p class="stage-synopsis">
              No existe ninguna fecha con el identificador «{slug}». Revisa el calendario del campeonato.
            </p>
            <div class="hero-buttons">
              <a href="/" class="btn btn--solid">Ir al inicio →</a>
              <a href="/ranking-general" class="btn btn--ghost">Ranking Acumulado</a>
            </div>
          </div>
        </section>
      ) : !summary || !stage ? (
        <section class="stage-hero" data-draw>
          <div class="hero-details">
            <div class="stage-tag font-mono" data-draw-eyebrow>[ SERVICIO NO DISPONIBLE ]</div>
            <h1 class="stage-title">No pudimos cargar esta fecha</h1>
            <p class="stage-synopsis">
              El servicio de resultados no respondió en este momento. Vuelve a intentarlo en unos segundos.
            </p>
            <div class="hero-buttons">
              <a href="/" class="btn btn--solid">Ir al inicio →</a>
            </div>
          </div>
        </section>
      ) : (
        <>
          {/* ── Navegación entre fechas: ARRIBA, protagonista ───────── */}
          <nav class="stage-nav" aria-label="Otras fechas del campeonato">
            {summary.navigation.prev_slug ? (
              <a href={`/fechas/${summary.navigation.prev_slug}`} class="stage-nav__link stage-nav__link--prev">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
                <span class="stage-nav__text">
                  <span class="stage-nav__label font-mono">FECHA ANTERIOR</span>
                  <span class="stage-nav__name">{summary.navigation.prev_name}</span>
                </span>
              </a>
            ) : (
              <span class="stage-nav__empty" aria-hidden="true" />
            )}

            <span class="stage-nav__here font-mono">FECHA {String(stage.stage_number).padStart(2, '0')}</span>

            {summary.navigation.next_slug ? (
              <a href={`/fechas/${summary.navigation.next_slug}`} class="stage-nav__link stage-nav__link--next">
                <span class="stage-nav__text">
                  <span class="stage-nav__label font-mono">FECHA SIGUIENTE</span>
                  <span class="stage-nav__name">{summary.navigation.next_name}</span>
                </span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            ) : (
              <span class="stage-nav__empty" aria-hidden="true" />
            )}
          </nav>

          {/* ── Hero: datos reales de la BD ─────────────────────────── */}
          <section class="stage-hero" data-draw>
            <div class="hero-grid">
              {posterCard && (
                <div class="hero-poster-box" data-reveal>
                  <!--
                    Morph: este póster es el destino del que sale la tarjeta
                    del timeline de la portada.
                  -->
                  <img
                    src={posterCard}
                    alt={displayName}
                    class="hero-poster"
                    transition:name={`poster-${slug}`}
                  />
                  <a
                    href={posterFull}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="poster-full-link font-mono"
                  >
                    [ VER AFICHE COMPLETO ↗ ]
                  </a>
                </div>
              )}

              <div class="hero-details">
                <div class="stage-tag font-mono" data-draw-eyebrow>
                  [ FECHA {String(stage.stage_number).padStart(2, '0')}
                  {stage.short_name ? ` // ${stage.short_name.toUpperCase()}` : ''} · CAMPEONATO OFICIAL ]
                </div>

                <h1 class="stage-title">{displayName}</h1>

                <div class="stage-meta font-mono">
                  <span>
                    FECHA:{' '}
                    {new Date(stage.date + 'T00:00:00').toLocaleDateString('es-PE', {
                      day: 'numeric',
                      month: 'long',
                      year: 'numeric',
                    })}
                  </span>
                  {stage.start_location && (
                    <span>
                      PARTIDA: {stage.start_location}
                      {stage.start_time ? ` (${stage.start_time})` : ''}
                    </span>
                  )}
                  {distLabel && <span>DISTANCIA: {distLabel}</span>}
                  {elevLabel && <span>DESNIVEL: {elevLabel}</span>}
                  <span class="status-tag">[{statusLabel}]</span>
                </div>

                <p class="stage-synopsis">{synopsis}</p>

                <div class="hero-buttons">
                  {stage.status === 'FINISHED' ? (
                    <a
                      href={`/ranking-general?modo=fecha&tabla=PRO&fecha=${stage.stage_number}`}
                      class="btn btn--solid"
                    >
                      Ver Resultados →
                    </a>
                  ) : (
                    <a href="/inscripciones" class="btn btn--solid">Inscripción Oficial →</a>
                  )}
                  {stage.strava_route_url && (
                    <a
                      href={stage.strava_route_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn--ghost"
                    >
                      Ruta en Strava ↗
                    </a>
                  )}
                </div>

                {stage.status === 'LIVE' && (
                  <a href="/en-vivo" class="live-badge font-mono">[ EN VIVO — CRONOMETRAJE ]</a>
                )}

                {stage.status === 'REGISTRATION_OPEN' && (
                  <div class="countdown">
                    <EventCountdown
                      client:load
                      targetDate={toStartInstant(stage.date, stage.start_time)}
                      displayTime={toDisplayTime(stage.start_time)}
                      label="LARGADA OFICIAL"
                    />
                  </div>
                )}
              </div>
            </div>
          </section>

          {/* ── Cifras de la jornada ─────────────────────────────────── */}
          <section class="stats-section">
            <SectionLabel number={sectionNumber('stats')!} label="CIFRAS DE LA JORNADA" />
            <StageStatsRow stats={stats!} />
          </section>

          {/* ── Leaderboard por categoría ────────────────────────────── */}
          {summary.podium.length > 0 && (
            <section class="podium-section">
              <SectionLabel number={sectionNumber('podium')!} label="PODIO OFICIAL POR CATEGORÍA" />
              <StageLeaderboard id="podio" podium={summary.podium} />
            </section>
          )}

          {/* ── Podio de clubes de la fecha ──────────────────────────── */}
          {summary.teams.length > 0 && (
            <section class="teams-section">
              <SectionLabel number={sectionNumber('teams')!} label="PODIO DE CLUBES DE LA FECHA" />
              <StageTeamCard teams={summary.teams} />
            </section>
          )}

          {/* ── Extremos de la jornada ───────────────────────────────── */}
          {(summary.extremes.scratch || summary.extremes.farolito) && (
            <section class="extremes-section">
              <SectionLabel number={sectionNumber('extremes')!} label="ESTADÍSTICAS EXTREMAS DE LA JORNADA" />
              <div class="extremes-grid">
                {summary.extremes.scratch && (
                  <div class="extreme-card scratch-card" data-reveal>
                    <div class="card-tag font-mono">
                      <Icon name="bolt" size={13} class="card-tag__icon" />
                      SCRATCH · MÁS RÁPIDO EN META
                    </div>
                    <div class="extreme-name">{summary.extremes.scratch.rider_name}</div>
                    <div class="extreme-sub font-mono">
                      DORSAL #{summary.extremes.scratch.bib_number} //{' '}
                      {summary.extremes.scratch.team_name}
                    </div>
                    <div class="extreme-foot">
                      <span class="extreme-time font-mono">
                        {summary.extremes.scratch.formatted_time}
                      </span>
                      <span class="extreme-speed font-mono">
                        <Icon name="pace" size={13} />
                        {stats!.winner_avg_speed_kmh ?? '—'} KM/H
                      </span>
                    </div>
                  </div>
                )}

                {summary.extremes.farolito && (
                  <div class="extreme-card farolito-card" data-reveal>
                    <div class="card-tag font-mono">
                      <Icon name="endurance" size={13} class="card-tag__icon" />
                      FAROLITO · MÁXIMA PERSISTENCIA
                    </div>
                    <div class="extreme-name">{summary.extremes.farolito.rider_name}</div>
                    <div class="extreme-sub font-mono">
                      DORSAL #{summary.extremes.farolito.bib_number} //{' '}
                      {summary.extremes.farolito.team_name}
                    </div>
                    <div class="extreme-foot">
                      <span class="extreme-time font-mono">
                        {summary.extremes.farolito.formatted_time}
                      </span>
                      <span class="extreme-speed font-mono">
                        <Icon name="clock" size={13} />
                        MÁS LARGO EN META
                      </span>
                    </div>
                  </div>
                )}
              </div>
            </section>
          )}

          {/* ── Perfil de etapa ──────────────────────────────────────── */}
          {summary.route_profile && (
            <section class="route-section">
              <SectionLabel number={sectionNumber('route')!} label="PERFIL TÉCNICO Y RUTA DE CARRERA" />
              <StageProfile
                slug={String(slug)}
                stageName={displayName}
                profile={summary.route_profile}
                summits={summary.summits}
                gpxUrl={gpxUrl}
              />
            </section>
          )}

          {/* ── Títulos de montaña (KOM / QOM / Kamikaze) ─────────────── */}
          {mountainTitles.length > 0 && (
            <section class="titles-section">
              <SectionLabel number={sectionNumber('titles')!} label="TÍTULOS DE MONTAÑA (KOM / QOM)" />

              <p class="titles-note">
                El <strong>KOM</strong> y el <strong>QOM</strong> premian al mejor escalador y a la mejor
                escaladora en la subida más exigente de la jornada. El <strong>Kamikaze</strong> premia a
                quien baja más rápido el descenso más pronunciado.
              </p>

              <div class="titles">
                {mountainTitles.map((title) => (
                  <article class={`title title--${title.key} ${title.accent}`}>
                    <div class="title__label font-mono">
                      <Icon name={title.icon} size={13} class="title__icon" />
                      {title.label}
                      <span class="title__scope">{title.scope}</span>
                    </div>
                    <div class="title__name">{title.data!.athlete_name}</div>
                    <div class="title__segment">{title.data!.segment_name}</div>
                    <div class="title__meta font-mono">
                      <Icon name="clock" size={12} />
                      {title.data!.formatted_time} // {title.data!.average_grade}% //{' '}
                      {title.data!.distance_km} KM
                    </div>
                    {title.data!.location && (
                      <div class="title__place font-mono">
                        <Icon name="map" size={12} />
                        {title.data!.location}
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )}

          {/* ── Segmentos Strava ─────────────────────────────────────── */}
          {segments.length > 0 && (
            <section class="strava-section">
              <SectionLabel number={sectionNumber('strava')!} label="SEGMENTOS OFICIALES STRAVA" />

              <div class="strava-grid">
                {segments.map((seg) => (
                  <div class="strava-card" data-kind={seg.kind} data-reveal>
                    <div class="strava-header font-mono">
                      <span class="strava-logo">
                        <Icon
                          name={seg.kind === 'CLIMB' ? 'mountain' : seg.kind === 'DESCENT' ? 'descent' : 'ruler'}
                          size={13}
                        />
                        {seg.kind === 'CLIMB'
                          ? 'SUBIDA'
                          : seg.kind === 'DESCENT'
                            ? 'BAJADA'
                            : 'PLANO'}
                      </span>
                      <span class="strava-grade">{seg.average_grade}% PEND. MEDIA</span>
                    </div>
                    <div class="strava-name">{seg.name}</div>
                    <div class="strava-dist font-mono">
                      <Icon name="ruler" size={12} />
                      {seg.distance_km} KM
                      {seg.elevation_max_m != null && ` · ${seg.elevation_max_m} MSNM`}
                      {seg.location && ` · ${seg.location}`}
                    </div>
                    {seg.kom ? (
                      <div class="strava-kom font-mono">
                        <span class="kom-label">RÉCORD KOM:</span> {seg.kom.athlete_name} ({seg.kom.formatted_time})
                      </div>
                    ) : seg.efforts.length > 0 ? (
                      <div class="strava-kom strava-kom--best font-mono">
                        <span class="kom-label">MEJOR TIEMPO REGISTRADO:</span> {seg.efforts[0].athlete_name} ({seg.efforts[0].formatted_time})
                      </div>
                    ) : (
                      <div class="strava-kom strava-kom--empty font-mono">
                        <Icon name="users" size={12} />
                        SIN INTENTOS DE LA FECHA DE CARRERA
                      </div>
                    )}

                    {seg.efforts.length > 0 && (
                      <ol class="strava-board font-mono">
                        {seg.efforts.slice(0, 5).map((e, i) => (
                          <li class="board-row">
                            <span class="board-rank">{i + 1}º</span>
                            <span class="board-name">{e.athlete_name}</span>
                            <span class="board-time">{e.formatted_time}</span>
                          </li>
                        ))}
                      </ol>
                    )}

                    {seg.strava_segment_id && (
                      <a
                        class="strava-link font-mono"
                        href={`https://www.strava.com/segments/${seg.strava_segment_id}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        VER EN STRAVA ↗
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* ── Premios de la jornada ────────────────────────────────── */}
          {summary.awards.length > 0 && (
            <section class="awards-section">
              <SectionLabel number={sectionNumber('awards')!} label="PREMIOS DE LA JORNADA" />
              <div class="awards-grid">
                {summary.awards.map((a) => (
                  <div class="award-box" data-reveal>
                    {a.sponsor_logo_url && (
                      <img src={a.sponsor_logo_url} alt={a.sponsor_name ?? a.title} class="award-img" />
                    )}
                    <div class="award-content">
                      <h3 class="award-heading">{a.title}</h3>
                      {a.sponsor_name && <p class="award-sponsor font-mono">PATROCINADOR: {a.sponsor_name}</p>}
                      {a.prize_description && <p class="award-text">{a.prize_description}</p>}
                      {a.metric_value && <p class="award-text">{a.metric_value}</p>}
                      {a.winner_name && <p class="award-winner font-mono">GANADOR: {a.winner_name}</p>}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}
        </>
      )
    }
  </main>

  <SiteFooter />
</Showcase>

<style>
  .stage-page {
    padding-top: 1.5rem;
  }

  /* ── Navegación de fechas: arriba y protagonista ─────────────────── */
  .stage-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .stage-nav__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    color: var(--ink);
    text-decoration: none;
    min-width: 0;
    transition: border-color var(--default-transition-duration)
      var(--default-transition-timing-function),
      background var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .stage-nav__link--next {
    justify-content: flex-end;
    text-align: right;
  }

  .stage-nav__link svg {
    flex: 0 0 auto;
    color: var(--muted);
    transition: color var(--default-transition-duration)
