---
import Showcase from '../../layouts/Showcase.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RouteMapGpx from '../../components/svelte/RouteMapGpx.svelte';
import SectionLabel from '../../components/bento/SectionLabel.astro';
import { API_V1 } from '../../lib/api';

// SSR: ruta dinámica resuelta contra la API en cada request (antes se
// prerenderizaba con `getStaticPaths` y un `fetch` de build-time que se
// tragaba los errores). Ver specs/03 §2.
const { slug } = Astro.params;

// Datos de la etapa (espejo de la base de datos sembrada desde races/)
const stagesDb: Record<string, any> = {
  'la-joya-extreme': {
    num: 1,
    name: 'La Joya Extreme',
    shortName: 'La Joya',
    title: 'La Joya Extreme',
    date: '17 de Mayo de 2026',
    status: 'Finalizada',
    startLocation: 'Vía de Evitamiento, La Joya',
    startTime: '08:00 AM',
    poster: '/images/posters/f1-la-joya-extreme-card.webp',
    dist: 40.9,
    elev: 384,
    laps: 1,
    gpx: 'la-joya-extreme.gpx',
    stravaRoute: 'https://www.strava.com/routes/3486799154256647166',
    scratch: { name: 'RONALD LUZA CALLO', category: 'MASTER A', time: '01:07:55', bib: 38 },
    farolito: { name: 'IRENE ALFARO', category: 'DAMAS MASTER', time: '02:38:08', bib: 283 },
    strava: []
  },
  'z-xtreme-2026': {
    num: 2,
    name: 'Kúspide Z Xtreme III',
    shortName: 'Z Xtreme',
    title: 'Kúspide Z Xtreme — 3ra Edición',
    date: '23 de Agosto de 2026',
    status: 'Finalizada',
    startLocation: 'Circuito La Z',
    startTime: '08:00 AM',
    poster: '/images/posters/f2-z-xtreme-card.webp',
    dist: 11.8,
    elev: 280,
    laps: 3,
    gpx: 'z-xtreme.gpx',
    stravaRoute: 'https://www.strava.com/routes/3200784336826934006',
    scratch: { name: 'SERGIO PINEDA HUANCA', category: 'TURISMO OPEN VARONES', time: '01:00:00', bib: 159 },
    farolito: { name: 'REYNALDO PARQUE', category: 'MASTER C', time: '02:19:41', bib: 96 },
    strava: []
  },
  'vuelta-a-los-poblados': {
    num: 3,
    name: 'El Retorno a los Poblados 2',
    shortName: 'Poblados',
    title: 'El Retorno a los Poblados 2',
    date: '25 de Octubre de 2026',
    status: 'Inscripciones Abiertas',
    startLocation: 'Plaza de Chiguata',
    startTime: '08:00 AM',
    poster: '/images/posters/f3-retorno-poblados-card.webp',
    dist: 47.2,
    elev: 761,
    laps: 1,
    gpx: 'vuelta-a-los-poblados.gpx',
    stravaRoute: 'https://www.strava.com/routes/3545824230908680048',
    scratch: null,
    farolito: null,
    strava: []
  },
  'quequena-xtreme': {
    num: 4,
    name: 'Quequeña Xtreme III',
    shortName: 'Quequeña',
    title: 'Quequeña Xtreme III',
    date: '13 de Diciembre de 2026',
    status: 'Próximamente',
    startLocation: 'Plaza Principal de Quequeña',
    startTime: '08:00 AM',
    poster: '/images/posters/f4-quequena-xtreme-card.webp',
    dist: 45.0,
    elev: 950,
    laps: 1,
    gpx: null,
    stravaRoute: null,
    scratch: null,
    farolito: null,
    strava: []
  }
};

const stage = { ...(stagesDb[slug ?? ''] || stagesDb['vuelta-a-los-poblados']) };
stage.notFound = false;

// Enriquecer con datos reales de la API (extremos, segmentos Strava, métricas)
try {
  const res = await fetch(`${API_V1}/stages/${slug}`);
  if (res.status === 404) {
    Astro.response.status = 404;
    stage.notFound = true;
  } else if (res.ok) {
    const data = await res.json();
    const s = data.stage;
    if (s) {
      stage.name = s.title || s.name;
      stage.title = s.title || s.name;
      stage.shortName = s.short_name || stage.shortName;
      stage.startLocation = s.start_location || stage.startLocation;
      stage.startTime = s.start_time || stage.startTime;
      stage.poster = s.poster_url || stage.poster;
      stage.date = new Date(s.date + 'T00:00:00').toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });
      stage.dist = s.distance_km;
      stage.elev = s.elevation_gain_m;
      stage.laps = s.laps;
      stage.status = s.status === 'FINISHED' ? 'Finalizada' : (s.status === 'REGISTRATION_OPEN' ? 'Inscripciones Abiertas' : 'Próximamente');
    }
    const ex = data.extremes || {};
    if (ex.scratch) {
      stage.scratch = {
        name: ex.scratch.rider_name,
        category: ex.scratch.category_name,
        time: ex.scratch.formatted_time,
        bib: ex.scratch.bib_number,
      };
    }
    if (ex.farolito) {
      stage.farolito = {
        name: ex.farolito.rider_name,
        category: ex.farolito.category_name,
        time: ex.farolito.formatted_time,
        bib: ex.farolito.bib_number,
      };
    }
    if (Array.isArray(data.strava_segments) && data.strava_segments.length) {
      stage.strava = data.strava_segments.map((seg: any) => ({
        name: seg.name,
        dist: `${(seg.distance_m / 1000).toFixed(2)} km`,
        grade: `${seg.average_grade}%`,
        kom: seg.efforts && seg.efforts.length
          ? `${seg.efforts[0].athlete_name} (${seg.efforts[0].formatted_time})`
          : 'Sin registros aún',
      }));
    }
  }
} catch (e) {}

// Nombre visible sin el prefijo "Fecha N:" (se muestra aparte en el eyebrow)
const displayName = String(stage.name || '').replace(/^Fecha\s+\d+\s*:\s*/i, '');
---
<Showcase title={`${displayName} — Kúspide MTB`} ghostWord={`FECHA ${stage.num}`}>
  <SiteHeader />

  <main class="container stage-page">
    {stage.notFound ? (
      <section class="stage-hero" data-draw>
        <div class="hero-details">
          <div class="stage-tag font-mono" data-draw-eyebrow>[ FECHA NO ENCONTRADA ]</div>
          <h1 class="stage-title">Sin resultados para «{slug}»</h1>
          <p class="stage-synopsis">
            No existe ninguna fecha con el identificador «{slug}». Revisa el calendario del campeonato.
          </p>
          <div class="hero-buttons">
            <a href="/" class="btn btn--solid">Ir al inicio →</a>
            <a href="/ranking-general" class="btn btn--ghost">Ranking Acumulado</a>
          </div>
        </div>
      </section>
    ) : (
    <>
    <!-- Cabecera de Fecha con Póster y Datos -->
    <section class="stage-hero" data-draw>
      <div class="hero-grid">
        <div class="hero-poster-box" data-reveal>
          <img src={stage.poster} alt={stage.name} class="hero-poster" />
          <a href={stage.poster.replace('-card.webp', '-full.webp')} target="_blank" rel="noopener noreferrer" class="poster-full-link font-mono">
            [ VER AFICHE COMPLETO ↗ ]
          </a>
        </div>
        <div class="hero-details">
          <div class="stage-tag font-mono" data-draw-eyebrow>[ FECHA 0{stage.num} // {stage.shortName ? `${stage.shortName.toUpperCase()} · ` : ''}CAMPEONATO OFICIAL ]</div>
          <h1 class="stage-title">{stage.title || displayName}</h1>
          <div class="stage-meta font-mono">
            <span>FECHA: {stage.date}</span>
            <span>PARTIDA: {stage.startLocation || 'Arequipa'} ({stage.startTime || '08:00 AM'})</span>
            <span>DISTANCIA: {stage.laps > 1 ? `${stage.dist} KM × ${stage.laps} VUELTAS` : `${stage.dist} KM`}</span>
            <span>DESNIVEL: +{stage.elev * stage.laps} M</span>
            <span class="status-tag">[{stage.status}]</span>
          </div>

          <p class="stage-synopsis">
            {stage.laps > 1
              ? `Circuito de ${stage.dist} km por vuelta y +${stage.elev} m de desnivel por vuelta. ${stage.laps} vueltas para las categorías fuertes.`
              : `Recorrido de ${stage.dist} km con +${stage.elev} m de desnivel positivo acumulado.`}
          </p>

          <div class="hero-buttons">
            {stage.status === 'Finalizada' ? (
              <a href={`/fechas/${slug}/resultados`} class="btn btn--solid">Resultados Oficiales →</a>
            ) : (
              <a href="/inscripciones" class="btn btn--solid">Inscripción Oficial →</a>
            )}
            <a href="/ranking-general" class="btn btn--ghost">Ranking Acumulado</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Bento de Estadísticas Extremas (si la fecha finalizó) -->
    {stage.scratch && (
      <section class="extremes-section">
        <SectionLabel number="01" label="ESTADÍSTICAS EXTREMAS DE LA JORNADA" />
        <div class="extremes-grid">
          <div class="extreme-card scratch-card" data-reveal>
            <div class="card-tag font-mono">[ SCRATCH // TIEMPO MÁS RÁPIDO EN META ]</div>
            <div class="extreme-name">{stage.scratch.name}</div>
            <div class="extreme-sub font-mono">DORSAL #{stage.scratch.bib} // {stage.scratch.category}</div>
            <div class="extreme-time font-mono">{stage.scratch.time}</div>
          </div>

          <div class="extreme-card farolito-card" data-reveal>
            <div class="card-tag font-mono">[ LANTERNE ROUGE // MÁXIMA PERSISTENCIA ]</div>
            <div class="extreme-name">{stage.farolito.name}</div>
            <div class="extreme-sub font-mono">DORSAL #{stage.farolito.bib} // {stage.farolito.category}</div>
            <div class="extreme-time font-mono">{stage.farolito.time}</div>
          </div>
        </div>
      </section>
    )}

    <!-- Bento de Ruta Interactiva y Altimetría -->
    <section class="route-section">
      <SectionLabel number="02" label="PERFIL TÉCNICO Y RUTA DE CARRERA" />
      <RouteMapGpx
        client:visible
        stageName={stage.name}
        distanceKm={stage.dist}
        elevationGainM={stage.elev}
        gpxUrl={stage.gpx ? `/gpx/${stage.gpx}` : undefined}
      />
    </section>

    <!-- Bento Segmentos Strava (Filosofía Strava) -->
    {stage.strava.length > 0 && (
      <section class="strava-section">
        <SectionLabel number="03" label="SEGMENTOS OFICIALES STRAVA (KOM / QOM)" />
        <div class="strava-grid">
          {stage.strava.map((seg: any) => (
            <div class="strava-card font-mono" data-reveal>
              <div class="strava-header">
                <span class="strava-logo">STRAVA SEGMENT // VERIFICADO</span>
                <span class="strava-grade">{seg.grade} PEND. MEDIA</span>
              </div>
              <div class="strava-name">{seg.name}</div>
              <div class="strava-dist">DISTANCIA OFICIAL: {seg.dist}</div>
              <div class="strava-kom"><span class="kom-label">RÉCORD KOM:</span> {seg.kom}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Bento Premios Especiales -->
    <section class="awards-section">
      <SectionLabel number="04" label="PREMIOS DE LA JORNADA" />
      <div class="awards-grid">
        <div class="award-box" data-reveal>
          <img src="/images/premio_coca.jpg" alt="Premio Coca" class="award-img" />
          <div class="award-content">
            <h3 class="award-heading">Premio Especial Coca</h3>
            <p class="award-text">Reconocimiento oficial a la persistencia deportiva y resiliencia en carrera.</p>
          </div>
        </div>
        <div class="award-box" data-reveal>
          <img src="/images/rey_montana.jpg" alt="Rey Montaña" class="award-img" />
          <div class="award-content">
            <h3 class="award-heading">Rey de la Montaña (KOM)</h3>
            <p class="award-text">S/ 500 al mejor tiempo en el sector de ascenso de montaña.</p>
          </div>
        </div>
      </div>
    </section>
    </>
    )}
  </main>

  <SiteFooter />
</Showcase>

<style>
  .stage-page {
    padding-top: 2rem;
  }

  .stage-hero {
    padding-bottom: 3rem;
    border-bottom: var(--hairline) solid var(--line);
    margin-bottom: 3rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .hero-poster-box {
    aspect-ratio: 3/4;
    max-width: 23.75rem;
    background: #14171c;
    overflow: hidden;
    border: var(--hairline) solid var(--line);
  }

  .hero-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .poster-full-link {
    display: block;
    padding: 0.5rem;
    font-size: 0.6875rem;
    text-align: center;
    letter-spacing: 0.1em;
    color: var(--muted);
    background: var(--bg-surface);
    border-top: var(--hairline) solid var(--line);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .poster-full-link:hover {
    color: var(--accent);
    background: var(--bg-raised);
  }

  .hero-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .stage-tag {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    color: var(--faint);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .stage-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--ink-strong);
    text-wrap: balance;
    margin: 0 0 1rem 0;
  }

  .stage-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .status-tag {
    color: var(--muted);
    font-weight: var(--font-weight-medium);
  }

  .stage-synopsis {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 33.75rem;
    margin-bottom: 2rem;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.125rem;
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium, 500);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border: var(--hairline) solid transparent;
    border-radius: var(--radius, 0);
    white-space: nowrap;
    text-decoration: none;
    transition: background var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .btn--solid {
    background: var(--invert-bg);
    color: var(--invert-fg);
  }

  .btn--solid:hover {
    background: var(--accent, #ff5500);
    color: #ffffff;
  }

  .btn--ghost {
    border-color: var(--line);
    color: var(--ink);
    background: transparent;
  }

  .btn--ghost:hover {
    border-color: var(--line-strong);
    background: var(--bg-sunken);
  }

  /* Estadísticas Extremas */
  .extremes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .extreme-card {
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    padding: 2rem;
  }

  .card-tag {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.14em;
    color: var(--faint);
    margin-bottom: 0.75rem;
  }

  .extreme-name {
    font-family: var(--font-display, var(--font-sans));
    font-size: 1.5rem;
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--ink-strong);
    margin-bottom: 0.25rem;
  }

  .extreme-sub {
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .extreme-time {
    font-size: 2rem;
    font-weight: var(--font-weight-medium);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  /* Strava */
  .strava-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .strava-card {
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    padding: 1.25rem 1.5rem;
  }

  .strava-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: #fc4c02; /* Strava Orange */
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .strava-name {
    font-size: 1.125rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .strava-dist {
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .strava-kom {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
  }

  /* Premios */
  .awards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 4rem;
  }

  .award-box {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    padding: 1.5rem;
  }

  .award-img {
    width: 5.625rem;
    height: 5.625rem;
    object-fit: cover;
    flex-shrink: 0;
  }

  .award-heading {
    font-family: var(--font-display, var(--font-sans));
    font-size: 1.125rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }

  .award-text {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }

  @media (min-width: 48em) {
    .hero-grid {
      grid-template-columns: 21.25rem 1fr;
    }

    .extremes-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .strava-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .awards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
