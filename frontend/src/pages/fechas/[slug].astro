---
/**
 * Ficha de una fecha del campeonato.
 *
 * Ruta dinámica en SSR: el slug se resuelve contra
 * `GET /api/v1/stages/{slug}/summary` en cada request. Si la fecha no existe
 * la respuesta es `404`; si el backend no responde, `503`. **La página no
 * contiene ningún dato literal**: todo viene del resumen (specs/03 §0.2).
 */
import Showcase from '../../layouts/Showcase.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import StageProfile from '../../components/StageProfile.astro';
import StageStatsRow from '../../components/StageStatsRow.astro';
import StageLeaderboard from '../../components/StageLeaderboard.astro';
import StageTeamCard from '../../components/StageTeamCard.astro';
import SectionLabel from '../../components/bento/SectionLabel.astro';
import DisplayTitle from '../../components/DisplayTitle.astro';
import Button from '../../components/Button.astro';
import EventCountdown from '../../components/svelte/EventCountdown.svelte';
import Icon from '../../components/Icon.astro';
import PrizeScale from '../../components/PrizeScale.astro';
import { getStageSummary, type StageSummary } from '../../lib/api';
import { toDisplayTime, toStartInstant } from '../../lib/datetime';
import {
  PER_DATE_PRIZES,
  PER_DATE_PRIZE_ICON,
  PRIZE_CATEGORIES,
  PRIZE_CURRENCY,
} from '../../data/prizes';
import { MOUNTAIN_TITLES } from '../../data/mountain-titles';

const MOUNTAIN_PRIZE_USD = MOUNTAIN_TITLES[0]?.amountUsd ?? 15;

const { slug } = Astro.params;

let summary: StageSummary | null = null;
let notFound = false;
try {
  summary = await getStageSummary(String(slug));
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=30');
} catch (e) {
  if (e instanceof Error && e.message === 'stage-not-found') {
    notFound = true;
    Astro.response.status = 404;
  } else {
    // El backend no responde: se dice, no se rellena con datos inventados.
    Astro.response.status = 503;
  }
}

const stage = summary?.stage;
const stats = summary?.stats;

// El nombre visible sin el prefijo "Fecha N:" (el eyebrow ya lo dice).
const displayName = String(stage?.title || stage?.name || '').replace(
  /^Fecha\s+\d+\s*:\s*/i,
  '',
);

/**
 * El titular usa la primitiva del sistema (`DisplayTitle`): la sans para el
 * nombre y **una palabra en Instrument Serif itálica**. La palabra acentuada
 * es la última del nombre —"La Joya *Extreme*", "Kúspide Z Xtreme *III*"—,
 * que es donde la referencia pone el acento ("Thirteen apps. One *craft*").
 */
const titleWords = displayName.split(' ').filter(Boolean);
const titleAccent = titleWords.length > 1 ? titleWords.pop()! : displayName;
const titleBefore = titleWords.join(' ');
/** El espacio va explícito: `DisplayTitle` concatena las tres partes sin
 *  separarlas. */
const titlePrefix = titleBefore ? `${titleBefore} ` : '';

// Distancia y desnivel: UNA sola vez en el hero, y en TOTALES. El detalle
// por vuelta no se repite aquí: si la fecha tiene varias vueltas se dice
// cuántas, y el desglose vive en la sección de perfil. Una fecha SIN ruta
// (la Fecha 4) no tiene cifras: se dice "por confirmar" en vez de inventar
// un 45 km.
const distLabel = !stats
  ? ''
  : stats.distance_km_per_lap == null
    ? 'POR CONFIRMAR'
    : stats.laps > 1
      ? `${stats.distance_km_total} KM · ${stats.laps} VUELTAS`
      : `${stats.distance_km_total} KM`;
const elevLabel = !stats
  ? ''
  : stats.elevation_m_per_lap == null
    ? 'POR CONFIRMAR'
    : `+${stats.elevation_m_total} M`;

const statusLabel =
  stage?.status === 'FINISHED'
    ? 'Finalizada'
    : stage?.status === 'REGISTRATION_OPEN'
      ? 'Inscripciones Abiertas'
      : stage?.status === 'LIVE'
        ? 'En Vivo'
        : 'Próximamente';

/** Rótulo único: el nombre lo dice el H1 y las vueltas, la distancia. */
const raceTag = 'MTB XC';

/**
 * Lo que PUBLICA el PDF oficial de resultados frente a lo que recalcula el
 * motor (specs/01 §3.1) se explica en el bloque de cifras de la jornada
 * (`StageStatsRow`): normalmente coinciden; en Z Xtreme no, porque el PDF no
 * imprime el 6º lugar de OPEN DAMAS.
 */

const posterCard = stage?.poster_url ?? '';
const gpxUrl = stage?.gpx_file_url ?? undefined;

/**
 * Los segmentos Strava, ordenados por tipo: primero las subidas, luego las
 * bajadas y por último los llanos. Dentro de cada grupo, los más largos.
 */
const segments = [...(summary?.strava ?? [])].sort((a, b) => {
  const rank = (kind: string) => (kind === 'CLIMB' ? 0 : kind === 'DESCENT' ? 1 : 2);
  const byKind = rank(a.kind) - rank(b.kind);
  if (byKind !== 0) return byKind;
  return b.distance_km - a.distance_km;
});

/**
 * Los cuatro títulos de montaña de la fecha, en el orden en que se muestran.
 * El KOM y el QOM son la misma subida: el mejor varón y la mejor dama. Los
 * Kamikaze son el mejor varón y la mejor dama en el descenso de la jornada.
 *
 * `short` es el nombre corto (KOM, QOM…): es el que cabe en el rótulo de la
 * tarjeta; el nombre largo va debajo, en la línea de datos.
 */
const mountainTitles = [
  {
    key: 'kom',
    short: 'KOM',
    label: 'KING OF THE MOUNTAIN',
    scope: 'VARÓN',
    icon: 'mountain' as const,
    data: summary?.kom ?? null,
  },
  {
    key: 'qom',
    short: 'QOM',
    label: 'QUEEN OF THE MOUNTAIN',
    scope: 'DAMAS',
    icon: 'mountain' as const,
    data: summary?.qom ?? null,
  },
  {
    key: 'kamikaze-male',
    short: 'EL KAMIKAZE',
    label: 'MEJOR DESCENSO · VARONES',
    scope: 'VARÓN',
    icon: 'descent' as const,
    data: summary?.kamikaze_male ?? null,
  },
  {
    key: 'kamikaze-female',
    short: 'LA KAMIKAZE',
    label: 'MEJOR DESCENSO · DAMAS',
    scope: 'DAMAS',
    icon: 'descent' as const,
    data: summary?.kamikaze_female ?? null,
  },
].filter((title) => title.data !== null);

/**
 * Numeración de las secciones: consecutiva y sin huecos, aunque una fecha no
 * tenga podio, equipos, extremos o Strava. Los bloques que no aplican se
 * omiten enteros; los que aplican se numeran seguidos.
 *
 * Cada sección lleva además un `id`: es el ancla del índice lateral
 * (`PageIndex`), el aparato de la referencia.
 */
const sections: { key: string; id: string; label: string; present: boolean }[] = [
  { key: 'stats', id: 'cifras', label: 'CIFRAS DE LA JORNADA', present: true },
  {
    key: 'podium',
    id: 'podio-categorias',
    label: 'PODIO POR CATEGORÍA',
    present: (summary?.podium.length ?? 0) > 0,
  },
  {
    key: 'teams',
    id: 'clubes',
    label: 'PODIO DE CLUBES',
    present: (summary?.teams.length ?? 0) > 0,
  },
  {
    key: 'extremes',
    id: 'extremos',
    label: 'EXTREMOS DE LA JORNADA',
    present: Boolean(summary?.extremes.scratch || summary?.extremes.farolito),
  },
  {
    key: 'route',
    id: 'ruta',
    label: 'PERFIL Y RUTA',
    present: Boolean(summary?.route_profile),
  },
  {
    key: 'strava',
    id: 'strava',
    label: 'SEGMENTOS STRAVA',
    present: segments.length > 0,
  },
  {
    key: 'titles',
    id: 'titulos',
    label: 'TÍTULOS DE MONTAÑA',
    present: mountainTitles.length > 0,
  },
  {
    key: 'prizes',
    id: 'premios',
    label: 'PREMIOS DE LA JORNADA',
    present: true,
  },
];

/** Las secciones presentes, para el índice lateral de la referencia. */
const indexSections = sections
  .filter((s) => s.present)
  .map((s) => ({ label: s.label, id: s.id }));

/** Número de sección (01, 02, …) de una clave, o null si la sección no va. */
function sectionNumber(key: string): string | null {
  const present = sections.filter((s) => s.present);
  const index = present.findIndex((s) => s.key === key);
  return index >= 0 ? String(index + 1).padStart(2, '0') : null;
}
---

<Showcase
  title={`${displayName} — Copa MacroSur MTB`}
  ghostWord={stage ? `FECHA ${stage.stage_number}` : undefined}
  sections={indexSections}
>
  <SiteHeader />

  <main class="container stage-page">
    {
      notFound ? (
        <section class="stage-hero" data-draw>
          <div class="hero-details">
            <div class="stage-tag font-mono" data-draw-eyebrow>[ FECHA NO ENCONTRADA ]</div>
            <h1 class="stage-title">Sin resultados para «{slug}»</h1>
            <p class="stage-synopsis">
              No existe ninguna fecha con el identificador «{slug}». Revisa el calendario del campeonato.
            </p>
            <div class="hero-buttons">
              <Button variant="solid" href="/" label="Ir al inicio">
                <span aria-hidden="true">→</span>
              </Button>
              <Button variant="ghost" href="/ranking-general" label="Ranking Acumulado" />
            </div>
          </div>
        </section>
      ) : !summary || !stage ? (
        <section class="stage-hero" data-draw>
          <div class="hero-details">
            <div class="stage-tag font-mono" data-draw-eyebrow>[ SERVICIO NO DISPONIBLE ]</div>
            <h1 class="stage-title">No pudimos cargar esta fecha</h1>
            <p class="stage-synopsis">
              El servicio de resultados no respondió en este momento. Vuelve a intentarlo en unos segundos.
            </p>
            <div class="hero-buttons">
              <Button variant="solid" href="/" label="Ir al inicio">
                <span aria-hidden="true">→</span>
              </Button>
            </div>
          </div>
        </section>
      ) : (
        <>
          {/* ── Navegación entre fechas: ARRIBA, protagonista ───────── */}
          <nav class="stage-nav" aria-label="Otras fechas del campeonato">
            {summary.navigation.prev_slug ? (
              <a href={`/fechas/${summary.navigation.prev_slug}`} class="stage-nav__link stage-nav__link--prev">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
                <span class="stage-nav__text">
                  <span class="stage-nav__label font-mono">FECHA ANTERIOR</span>
                  <span class="stage-nav__name">{summary.navigation.prev_name}</span>
                </span>
              </a>
            ) : (
              <span class="stage-nav__empty" aria-hidden="true" />
            )}

            <span class="stage-nav__here font-mono">FECHA {String(stage.stage_number).padStart(2, '0')}</span>

            {summary.navigation.next_slug ? (
              <a href={`/fechas/${summary.navigation.next_slug}`} class="stage-nav__link stage-nav__link--next">
                <span class="stage-nav__text">
                  <span class="stage-nav__label font-mono">FECHA SIGUIENTE</span>
                  <span class="stage-nav__name">{summary.navigation.next_name}</span>
                </span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            ) : (
              <span class="stage-nav__empty" aria-hidden="true" />
            )}
          </nav>

          {/* ── Hero: datos reales de la BD ─────────────────────────── */}
          <section class="stage-hero" data-draw>
            <div class="hero-grid">
              {posterCard && (
                <div class="hero-poster-box" data-reveal>
                  <!--
                    Morph: este póster es el destino del que sale la tarjeta
                    del timeline de la portada.
                  -->
                  <img
                    src={posterCard}
                    alt={displayName}
                    class="hero-poster"
                    transition:name={`poster-${slug}`}
                  />
                </div>
              )}

              <div class="hero-details">
                <div class="stage-tagline" data-draw-eyebrow>
                  <span class="stage-tag font-mono">[ {raceTag} ]</span>
                  <span class="stage-status font-mono">{statusLabel}</span>
                </div>

                <DisplayTitle size="page" before={titlePrefix} accent={titleAccent} />

                <dl class="stage-meta">
                  <div class="stage-meta__item">
                    <dt class="font-mono">Fecha</dt>
                    <dd class="font-mono">
                      {new Date(stage.date + 'T00:00:00').toLocaleDateString('es-PE', {
                        day: 'numeric',
                        month: 'long',
                        year: 'numeric',
                      })}
                    </dd>
                  </div>
                  {stage.start_location && (
                    <div class="stage-meta__item">
                      <dt class="font-mono">Partida</dt>
                      <dd class="font-mono">
                        {stage.start_location}
                        {stage.start_time ? ` · ${stage.start_time}` : ''}
                      </dd>
                    </div>
                  )}
                  {distLabel && (
                    <div class="stage-meta__item">
                      <dt class="font-mono">Distancia</dt>
                      <dd class="font-mono">{distLabel}</dd>
                    </div>
                  )}
                  {elevLabel && (
                    <div class="stage-meta__item">
                      <dt class="font-mono">Desnivel</dt>
                      <dd class="font-mono">{elevLabel}</dd>
                    </div>
                  )}
                </dl>
                <div class="hero-buttons">
                  {stage.status === 'FINISHED' ? (
                    <Button
                      variant="solid"
                      href={`/ranking-general?modo=fecha&tabla=PRO&fecha=${stage.stage_number}`}
                      label="Ver Resultados"
                    >
                      <span aria-hidden="true">→</span>
                    </Button>
                  ) : (
                    <Button variant="solid" href="/inscripciones" label="Inscripción Oficial">
                      <span aria-hidden="true">→</span>
                    </Button>
                  )}
                  {summary.route_profile && (
                    <Button
                      variant="ghost"
                      href="#ruta"
                      label="Ver Altimetría y GPX"
                    >
                      <span aria-hidden="true">↓</span>
                    </Button>
                  )}
                  {stage.strava_route_url && (
                    <Button
                      variant="ghost"
                      href={stage.strava_route_url}
                      label="Ruta en Strava"
                      external
                    >
                      <span aria-hidden="true">↗</span>
                    </Button>
                  )}
                </div>

                {stage.status === 'LIVE' && (
                  <a href="/en-vivo" class="live-badge font-mono">[ EN VIVO — CRONOMETRAJE ]</a>
                )}

                {stage.status === 'REGISTRATION_OPEN' && (
                  <div class="countdown">
                    <EventCountdown
                      client:load
                      targetDate={toStartInstant(stage.date, stage.start_time)}
                      displayTime={toDisplayTime(stage.start_time)}
                      label="LARGADA OFICIAL"
                    />
                  </div>
                )}
              </div>
            </div>
          </section>

          {/* ── Cifras de la jornada ─────────────────────────────────── */}
          <section class="stats-section" id="cifras">
            <SectionLabel number={sectionNumber('stats')!} label="CIFRAS DE LA JORNADA" />
            <StageStatsRow stats={stats!} />
          </section>

          {/* ── Leaderboard por categoría ────────────────────────────── */}
          {summary.podium.length > 0 && (
            <section class="podium-section" id="podio-categorias">
              <SectionLabel number={sectionNumber('podium')!} label="PODIO OFICIAL POR CATEGORÍA" />
              <StageLeaderboard
                id="podio"
                podium={summary.podium}
                stageNumber={stage.stage_number}
              />
            </section>
          )}

          {/* ── Podio de clubes de la fecha ──────────────────────────── */}
          {summary.teams.length > 0 && (
            <section class="teams-section" id="clubes">
              <SectionLabel number={sectionNumber('teams')!} label="PODIO DE CLUBES DE LA FECHA" />
              <StageTeamCard teams={summary.teams} />
            </section>
          )}

          {/* ── Extremos de la jornada ───────────────────────────────── */}
          {(summary.extremes.scratch || summary.extremes.farolito) && (
            <section class="extremes-section" id="extremos">
              <SectionLabel number={sectionNumber('extremes')!} label="ESTADÍSTICAS EXTREMAS DE LA JORNADA" />
              <div class="extremes-card">
                {summary.extremes.scratch && (
                  <article class="extreme" data-reveal>
                    <header class="extreme__head">
                      <Icon name="bolt" size={12} class="extreme__icon" />
                      <span class="extreme__label font-mono">SCRATCH</span>
                      <span class="extreme__meta font-mono">MÁS RÁPIDO</span>
                    </header>
                    <p class="extreme__name">{summary.extremes.scratch.rider_name}</p>
                    <p class="extreme__sub font-mono">
                      #{summary.extremes.scratch.bib_number} · {summary.extremes.scratch.team_name}
                    </p>
                    <p class="extreme__value font-mono">
                      {summary.extremes.scratch.formatted_time}
                    </p>
                  </article>
                )}

                {summary.extremes.farolito && (
                  <article class="extreme" data-reveal>
                    <header class="extreme__head">
                      <Icon name="endurance" size={12} class="extreme__icon" />
                      <span class="extreme__label font-mono">FAROLITO</span>
                      <span class="extreme__meta font-mono">MÁS PERSISTENTE</span>
                    </header>
                    <p class="extreme__name">{summary.extremes.farolito.rider_name}</p>
                    <p class="extreme__sub font-mono">
                      #{summary.extremes.farolito.bib_number} · {summary.extremes.farolito.team_name}
                    </p>
                    <p class="extreme__value font-mono">
                      {summary.extremes.farolito.formatted_time}
                    </p>
                  </article>
                )}
              </div>
            </section>
          )}

          {/* ── Perfil de etapa ──────────────────────────────────────── */}
          {summary.route_profile && (
            <section class="route-section" id="ruta">
              <SectionLabel number={sectionNumber('route')!} label="PERFIL TÉCNICO Y RUTA DE CARRERA" />
              <StageProfile
                slug={String(slug)}
                stageName={displayName}
                profile={summary.route_profile}
                summits={summary.summits}
                gpxUrl={gpxUrl}
              />
            </section>
          )}

          {/* ── Segmentos Strava ─────────────────────────────────────── */}
          {segments.length > 0 && (
            <section class="strava-section" id="strava">
              <SectionLabel number={sectionNumber('strava')!} label="SEGMENTOS OFICIALES STRAVA" />

              <div class="strava-grid">
                {segments.map((seg) => {
                  const segIcon =
                    seg.badge_tag === 'ESCALADOR'
                      ? 'climber'
                      : seg.badge_tag === 'PUNCHER'
                        ? 'puncher'
                        : seg.badge_tag === 'KAMIKAZE'
                          ? 'kamikaze'
                          : seg.badge_tag === 'LLANERO'
                            ? 'roller'
                            : seg.kind === 'CLIMB'
                              ? 'mountain'
                              : seg.kind === 'DESCENT'
                                ? 'descent'
                                : 'ruler';
                  const segLabel =
                    seg.badge_tag ??
                    (seg.kind === 'CLIMB'
                      ? 'SUBIDA'
                      : seg.kind === 'DESCENT'
                        ? 'BAJADA'
                        : 'PLANO');

                  return (
                    <article class="card strava-card" data-kind={seg.kind} data-reveal>
                      <header class="card__head">
                        <span class="strava-card__emblem">
                          <Icon name={segIcon} size={20} />
                        </span>
                        <span class="card__label font-mono">{segLabel}</span>
                        <span class="card__meta font-mono">{seg.average_grade}% PEND. MEDIA</span>
                      </header>

                      {seg.award_target && (
                        <div class="strava-card__award-row">
                          <span class="strava-card__prize-sticker font-mono">
                            {seg.award_target === 'KOM_QOM'
                              ? `TÍTULO KOM / QOM · USD ${seg.award_amount_usd ?? 15}`
                              : `TÍTULO KAMIKAZE · USD ${seg.award_amount_usd ?? 15}`}
                          </span>
                        </div>
                      )}

                      <p class="card__name">{seg.name}</p>

                      <p class="card__sub font-mono">
                        {seg.distance_km} KM
                        {seg.elevation_max_m != null && ` · ${seg.elevation_max_m} MSNM`}
                        {seg.location && ` · ${seg.location}`}
                      </p>

                      {/*
                        El récord sólo se dice cuando APORTA algo: si su
                        corredor ya está en la tabla de la fecha, la línea
                        repetía el mismo nombre y el mismo tiempo.
                      */}
                      {seg.kom &&
                        !seg.efforts
                          .slice(0, 3)
                          .some((e) => e.athlete_name === seg.kom!.athlete_name) && (
                          <p class="card__record card__record--gold font-mono">
                            RÉCORD · {seg.kom.athlete_name} · {seg.kom.formatted_time}
                          </p>
                        )}

                      {/*
                        El tiempo del 1º va en ORO: es el dato que importa y
                        da color a la sección. Si no hay tiempos (etapa futura o no corrida),
                        se informa limpiamente sin inventar datos.
                      */}
                      {seg.efforts.length > 0 ? (
                        <ol class="strava-board font-mono">
                          {seg.efforts.slice(0, 3).map((e, i) => (
                            <li class:list={['board-row', i === 0 && 'board-row--first']}>
                              <span class="board-rank">{i + 1}º</span>
                              <span class="board-name">{e.athlete_name}</span>
                              <span class="board-time">{e.formatted_time}</span>
                            </li>
                          ))}
                        </ol>
                      ) : (
                        <p class="strava-card__pending font-mono">
                          TIEMPOS OFICIALES EN VIVO EL DÍA DE LA CARRERA
                        </p>
                      )}

                      {seg.strava_segment_id && (
                        <a
                          class="card__link font-mono"
                          href={`https://www.strava.com/segments/${seg.strava_segment_id}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          VER EN STRAVA ↗
                        </a>
                      )}
                    </article>
                  );
                })}
              </div>
            </section>
          )}

          {/* ── Títulos de montaña (KOM / QOM / Kamikaze) ─────────────── */}
          {mountainTitles.length > 0 && (
            <section class="titles-section" id="titulos">
              <SectionLabel
                number={sectionNumber('titles')!}
                label="TÍTULOS DE MONTAÑA"
                kicker={`${PRIZE_CURRENCY} ${MOUNTAIN_PRIZE_USD} CADA UNO`}
              />

              {/*
                Sin nota que explique la regla: eso ya está en /premios, y aquí
                lo que importa es QUIÉN SE LLEVÓ EL PREMIO. Por eso cada
                título lleva su emblema (subida / bajada) y su sticker con
                el monto, igual que los premios especiales de la portada.
              */}
              <div class="titles">
                {mountainTitles.map((title) => (
                  <article class={`card title-card title--${title.key}`}>
                    <header class="card__head">
                      <span class="title-card__emblem">
                        <Icon name={title.icon} size={20} />
                      </span>
                      <span class="card__label font-mono">{title.short}</span>
                      <span class="title-card__sticker font-mono">
                        {PRIZE_CURRENCY} {MOUNTAIN_PRIZE_USD}
                      </span>
                    </header>
                    <p class="card__name">{title.data!.athlete_name}</p>
                    <p class="card__sub font-mono">
                      {title.scope} · {title.label}
                    </p>
                    <p class="card__sub font-mono">
                      {title.data!.segment_name} · {title.data!.formatted_time} //{' '}
                      {title.data!.average_grade}% // {title.data!.distance_km} KM
                    </p>
                    {title.data!.location && (
                      <p class="card__sub font-mono">{title.data!.location}</p>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )}

          {/* ── Premios ─────────────────────────────────────────────────── */}
          <section class="prizes-section" id="premios">
            <SectionLabel
              number={sectionNumber('prizes')!}
              label="PREMIOS DE LA JORNADA"
              kicker={`${PRIZE_CURRENCY} 100 / 50 / 30 · CADA CATEGORÍA`}
            />

            {/*
              En la ficha de UNA fecha sólo va el premio de esa fecha. Los
              acumulados (PRO, NORMAL, Copa de Equipos) y el Premio CLARO
              son del campeonato y se publican en /premios: aquí serían una
              copia que ni siquiera trae resultados.

              Y de los títulos de montaña no hace falta decir nada más: cada
              una de sus tarjetas lleva su propio premio.
            */}
            <div class="stage-prizes">
              <PrizeScale
                label="POR FECHA"
                title="CADA CATEGORÍA"
                body="El podio de cada una de las 11 categorías en esta fecha."
                tiers={PER_DATE_PRIZES}
                podium={PER_DATE_PRIZES}
                currency={PRIZE_CURRENCY}
                accent="gold"
                icon={PER_DATE_PRIZE_ICON}
                status="CADA FECHA"
                tags={[`${PRIZE_CATEGORIES.length} CATEGORÍAS`, '4 FECHAS']}
              />
            </div>
          </section>
        </>
      )
    }
  </main>

  <SiteFooter />
</Showcase>

<style>
  .stage-page {
    padding-top: 1.5rem;
  }

  /* ── Navegación de fechas: text-only, sin cajas ───────────────────
     La nav es utilería, no protagonista: sin fondos, sin bordes en los
     enlaces y sin hairline de separación. Solo texto + flecha. */
  .stage-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .stage-nav__link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
