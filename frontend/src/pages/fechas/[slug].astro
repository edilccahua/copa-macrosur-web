    min-width: 0;
    transition: color var(--default-transition-duration)
      var(--default-transition-timing-function);
  }

  .stage-nav__link--next {
    justify-content: flex-end;
    text-align: right;
  }

  .stage-nav__link svg {
    flex: 0 0 auto;
    color: var(--muted);
    transition: color var(--default-transition-duration)
      var(--default-transition-timing-function),
      transform var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .stage-nav__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .stage-nav__label {
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .stage-nav__name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--ink-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stage-nav__here {
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .stage-nav__link:hover {
    color: var(--ink-strong);
  }

  .stage-nav__link:hover svg {
    color: var(--accent);
  }

  .stage-nav__link--prev:hover svg {
    transform: translateX(-3px);
  }

  .stage-nav__link--next:hover svg {
    transform: translateX(3px);
  }

  @media (max-width: 47.99em) {
    .stage-nav__name {
      font-size: 0.8125rem;
    }
  }

  /* ── Hero ────────────────────────────────────────────────────────── */
  .stage-hero {
    padding-bottom: 3rem;
    border-bottom: var(--hairline) solid var(--line);
    margin-bottom: 3rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  /* En móvil el contenido va primero: el póster (3/4, ~500px) no puede
     empujar el H1 bajo el fold. */
  .hero-details {
    order: 1;
  }

  .hero-poster-box {
    order: 2;
    max-width: 23.75rem;
  }

  .hero-poster {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: var(--hairline) solid var(--line);
    background: #14171c;
  }

  .hero-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .stage-tagline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .stage-tag,
  .stage-status {
    font-size: 0.65625rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stage-tag {
    color: var(--faint);
  }

  /* El estado es la única señal enmarcada del hero: dice si la fecha ya se
     corrió, si está abierta o si falta. */
  .stage-status {
    padding: 0.125rem 0.375rem;
    border: var(--hairline) solid var(--line-strong);
    color: var(--ink);
  }

  .stage-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.02;
    color: var(--ink-strong);
    text-wrap: balance;
    margin: 0 0 1rem 0;
  }

  .stage-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0 1.5rem;
    margin: 0 0 1.5rem;
  }

  .stage-meta__item {
    padding: 0.625rem 0;
    border-bottom: var(--hairline) solid var(--line);
  }

  .stage-meta__item dt {
    font-family: var(--font-mono);
    font-size: 0.59375rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .stage-meta__item dd {
    margin: 0.15rem 0 0;
