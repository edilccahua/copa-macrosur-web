  .board-row {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    gap: 0.625rem;
    align-items: baseline;
    padding: 0.35rem 0;
    border-bottom: var(--hairline) solid var(--line);
    font-size: 0.6875rem;
  }

  .board-row:last-child {
    border-bottom: 0;
  }

  .board-rank {
    color: var(--faint);
  }

  /* El primero de la tabla: su tiempo va en oro. Es el color de la
     sección y no hace falta la medalla (la página ya lleva demasiadas). */
  .board-row--first .board-time {
    color: var(--copa-gold);
  }

  .board-row--first .board-rank {
    color: var(--copa-gold);
  }

  .board-name {
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .board-time {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .strava-card__award-row {
    margin: 0.25rem 0 0.5rem;
  }

  .strava-card__prize-sticker {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    font-size: 0.625rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    color: var(--bg);
    background: var(--copa-gold);
    border-radius: 2px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .strava-card__pending {
    margin: 0.75rem 0 0;
    padding: 0.75rem 0;
    border-top: var(--hairline) solid var(--line);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    color: var(--faint);
    text-transform: uppercase;
  }

  /* ── Premios ─────────────────────────────────────────────────────── */
  .awards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 4rem;
  }

  .award-card {
    flex-direction: row;
    align-items: flex-start;
    gap: 1.25rem;
  }

  /* El logotipo del patrocinador es una FOTO (un trofeo, una camiseta): se
     muestra a su proporción, sin recortarla a un cuadrado que la dejaba
     ilegible. */
  .award-img {
    width: auto;
    height: 4.5rem;
    max-width: 6rem;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .award-content {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 48em) {
    .hero-grid {
      grid-template-columns: 21.25rem 1fr;
    }

    /* En escritorio el póster vuelve a la izquierda. */
    .hero-poster-box {
      order: 0;
    }

    .hero-details {
      order: 0;
    }

    .extremes-card {
      grid-template-columns: 1fr 1fr;
    }

    .extreme + .extreme {
      border-top: 0;
      border-left: var(--hairline) solid var(--line);
    }

    .strava-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .awards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
