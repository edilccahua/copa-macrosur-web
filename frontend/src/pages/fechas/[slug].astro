    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-strong);
  }

  /* Solo la usan las pantallas de error (404 / 503): el hero ya no lleva
     párrafo porque repetía las cifras del bloque de datos. */
  .stage-synopsis {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 33.75rem;
    margin-bottom: 2rem;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .live-badge {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.5rem 0.875rem;
    background: var(--danger, #b3261e);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
  }

  .countdown {
    margin-top: 1.75rem;
    max-width: 22rem;
  }

  /* ══ Tarjeta editorial ═══════════════════════════════════════════════
     UNA sola gramografía de tarjeta para los cuatro bloques de datos de la
     ficha (extremos, títulos de montaña, segmentos Strava y premios):
     superficie, hairline, cabeza con rótulo y metadato, nombre, cuerpo y
     pie.

     Lo que desaparece: la barra vertical de color (`inset 3px`), el borde
     punteado para marcar una variante y los chips con borde. El acento lo
     llevan las MEDALLAS, que son jerarquía, no decoración, y el tipo de cada
     bloque se dice con la palabra y el ícono. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
  }

  .card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.25rem;
    padding-bottom: 0.625rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .card__icon {
    flex: 0 0 auto;
    color: var(--ink);
  }

  .card__label {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card__meta {
    margin-left: auto;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  .card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ink-strong);
  }

  .card__sub {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .card__record {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-strong);
  }

  .card__record--muted {
    color: var(--faint);
  }

  /* El récord del tramo: el único dato en oro de la sección. */
  .card__record--gold {
    color: var(--copa-gold);
  }

  .card__value {
    margin: 0.25rem 0 0;
    font-size: 2rem;
    font-weight: var(--font-weight-medium, 500);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    line-height: 1.1;
  }

  .card__link {
    align-self: flex-start;
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: none;
    border-bottom: var(--hairline) solid var(--line-strong);
    padding-bottom: 0.1rem;
  }

  .card__link:hover {
    color: var(--ink-strong);
  }

  /* ── Extremos: UNA tarjeta dividida en dos mitades ─────────────────
     Son dos datos, no dos fichas: no necesitan superficie propia cada uno.
     La altura la fija el contenido (nombre + tiempo), no una caja vacía. */
  .extremes-card {
    display: grid;
    grid-template-columns: 1fr;
    margin: 1rem 0 3rem;
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
  }

  .extreme {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    min-width: 0;
  }

  .extreme + .extreme {
    border-top: var(--hairline) solid var(--line);
  }

  .extreme__head {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding-bottom: 0.375rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .extreme__icon {
    flex: 0 0 auto;
    color: var(--faint);
  }

  .extreme__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .extreme__meta {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  .extreme__name {
    margin: 0.125rem 0 0;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 620;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .extreme__sub {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.65625rem;
    line-height: 1.4;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .extreme__value {
    margin: 0.125rem 0 0;
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.1;
  }

  /* ── Títulos de montaña ──────────────────────────────────────────── */
  .titles-section {
    margin-top: 2rem;
  }

  .prizes-section {
    margin-top: 2rem;
  }

  /* En la ficha, el único premio de la fecha va CENTRADO: es un bloque
     suelto, no una fila de tarjetas. */
  .stage-prizes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    max-width: 30rem;
    margin: 1.5rem auto 0;
  }

  /* La nota que explicaba la regla de los títulos se fue: esa explicación
     vive en /premios. */
  .titles-note {
    max-width: 68ch;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--muted);
  }

  .titles-note strong {
    font-weight: 600;
    color: var(--ink-strong);
  }

  .titles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  /* El emblema del título: un cuadro con la subida o la bajada, en el oro
     de la copa. Y el premio, en un sticker. Es lo que hace que esta sección
     se lea como un palmares y no como otra tabla de datos. */
  .title-card__emblem {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
    background: var(--bg-sunken);
    border: var(--hairline) solid var(--line);
    color: var(--copa-gold);
  }

  .title-card__sticker {
    margin-left: auto;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--bg);
    background: var(--copa-gold);
    transform: rotate(-2.5deg);
  }

  /* ── Strava ──────────────────────────────────────────────────────── */
  .strava-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 0;
    margin-bottom: 3.5rem;
  }

  .strava-board {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0.75rem 0 0;
    border-top: var(--hairline) solid var(--line);
