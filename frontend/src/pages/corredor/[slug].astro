---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { BASE_URL } from '../../lib/api';

// SSR: el perfil se resuelve contra la API en cada request. Antes se generaba
// con `getStaticPaths` y un perfil MOCK hardcodeado (con nombre real y DNI
// ficticio) que además rompía los slugs reales de la BD. Ver specs/03 §2.
const { slug } = Astro.params;

let profile: any = null;
let notFound = false;
try {
  const res = await fetch(`${BASE_URL}/api/v1/riders/${slug}`);
  if (res.status === 404) {
    notFound = true;
    Astro.response.status = 404;
  } else if (res.ok) {
    profile = await res.json();
  }
} catch (e) {
  Astro.response.status = 503;
}

const rider = profile?.rider;
const standings = profile?.standings || [];
const history = profile?.history || [];
---
<Base title={`${rider?.full_name || 'Ciclista no encontrado'} — Perfil de Ciclista | Kúspide MTB`}>
  <SiteHeader />

  <main class="container page-content">
    {notFound || !rider ? (
      <div class="rider-header-box">
        <div class="breadcrumb font-mono">
          <a href="/ranking-general">← VOLVER AL RANKING GENERAL</a>
        </div>
        <h1 class="rider-name">CICLISTA NO ENCONTRADO</h1>
        <p class="page-desc">
          No existe ningún corredor con el identificador «{slug}».
        </p>
      </div>
    ) : (
    <>
    <div class="rider-header-box">
      <div class="breadcrumb font-mono">
        <a href="/ranking-general">← VOLVER AL RANKING GENERAL</a>
      </div>

      <div class="rider-main-info">
        <div class="rider-avatar font-mono">
          {rider.full_name.charAt(0)}
        </div>
        <div>
          <span class="rider-badge font-mono">CATEGORÍA OFICIAL / TEMPORADA 2026</span>
          <h1 class="rider-name">{rider.full_name}</h1>
          <div class="rider-meta font-mono">
            <span>DNI: {rider.masked_dni}</span>
            <span>CLUB: {rider.team_name}</span>
            <span>GÉNERO: {rider.gender === 'M' ? 'VARONES' : 'DAMAS'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Resumen de Ranking Acumulado -->
    <section class="section-block">
      <div class="block-title font-mono">CLASIFICACIÓN EN EL CAMPEONATO ACUMULADO</div>
      <div class="standings-cards">
        {standings.map((st: any) => (
          <div class="st-card font-mono">
            <div class="st-rank">{st.current_rank}° LUGAR GENERAL</div>
            <div class="st-cat">{st.category_name}</div>
            <div class="st-stats">
              <span>PUNTOS: <strong>{st.total_points} pts</strong></span>
              <span>VICTORIAS: <strong>{st.first_places_count}</strong></span>
              <span>TIEMPO: <strong>{st.formatted_total_time}</strong></span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Historial en las 4 fechas -->
    <section class="section-block">
      <div class="block-title font-mono">HISTORIAL POR ETAPAS (4 FECHAS)</div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Fecha</th>
              <th class="col-bib">Dorsal</th>
              <th>Categoría</th>
              <th class="col-rank">Puesto</th>
              <th class="col-time">Tiempo Neto</th>
              <th class="col-pts">Puntos</th>
            </tr>
          </thead>
          <tbody>
            {history.map((h: any) => (
              <tr>
                <td>
                  <a href={`/fechas/${h.stage_slug}`} class="stage-link">
                    {h.stage_name}
                  </a>
                </td>
                <td class="col-bib font-mono">#{h.bib_number}</td>
                <td>{h.category_name}</td>
                <td class="col-rank font-mono">{h.rank ? `${h.rank}°` : '-'}</td>
                <td class="col-time font-mono">{h.formatted_time}</td>
                <td class="col-pts font-mono pts-tag">{h.points_earned ? `+${h.points_earned} pts` : '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    </>
    )}
  </main>

  <SiteFooter />
</Base>

<style>
  .page-content {
    padding-top: 3rem;
  }

  .rider-header-box {
    border-bottom: var(--hairline) solid var(--line);
    padding-bottom: 2.5rem;
    margin-bottom: 3rem;
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .rider-main-info {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .rider-avatar {
    width: 5rem;
    height: 5rem;
    background: var(--invert-bg, #101014);
    color: var(--invert-fg, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 800;
  }

  .rider-badge {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    display: block;
    margin-bottom: 0.35rem;
  }

  .rider-name {
    font-family: var(--font-display, var(--font-sans));
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }

  .rider-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .section-block {
    margin-bottom: 3.5rem;
  }

  .block-title {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .standings-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17.5rem, 1fr));
    gap: 1.5rem;
  }

  .st-card {
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    padding: 1.5rem;
  }

  .st-rank {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent);
    margin-bottom: 0.25rem;
  }

  .st-cat {
    font-size: 0.8125rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .st-stats {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.75rem;
  }

  .table-wrap {
    overflow-x: auto;
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.8125rem;
  }

  .data-table th {
    padding: 0.75rem 1.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    border-bottom: var(--hairline) solid var(--line);
    background: var(--bg);
  }

  .data-table td {
    padding: 0.875rem 1.25rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .stage-link {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }

  .stage-link:hover {
    color: var(--accent);
  }

  .pts-tag {
    color: var(--accent);
    font-weight: 800;
  }
</style>
