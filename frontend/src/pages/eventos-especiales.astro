---
/**
 * eventos-especiales.astro — las clásicas de ruta y los eventos especiales.
 *
 * Página editorial con la gramática de `copiaartcraft/src/pages/apps.astro`:
 * masthead con titular de acento serif, rótulo de sección pegajoso y lineup
 * de tarjetas `AppCard`.
 *
 * Sin datos literales: si la API no responde, la página lo dice (specs/03
 * §0.2). Antes había un arreglo hardcodeado que tapaba la caída del backend.
 */
import Showcase from '../layouts/Showcase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionLabel from '../components/bento/SectionLabel.astro';
import PageHeader from '../components/PageHeader.astro';
import RouteEventCard, { type RouteEvent } from '../components/RouteEventCard.astro';
import { API_V1 } from '../lib/api';

let events: RouteEvent[] = [];
let apiError = false;

try {
  const res = await fetch(`${API_V1}/public/extra-events`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) events = data;
  } else {
    apiError = true;
  }
} catch (e) {
  apiError = true;
}
---

<Showcase
  title="Eventos Especiales y Clásicas de Ruta — Copa MacroSur MTB"
  ghostWord="Ruta"
  sections={[{ label: 'Calendario', id: 'eventos' }]}
>
  <SiteHeader />

  <main class="page-content container">
    <PageHeader
      eyebrow="Kúspide Xtreme Sports // Eventos de ruta"
      before="Clásicas & "
      accent="eventos"
      after=" especiales"
      lead="Competiciones de ruta y pruebas independientes organizadas por Kúspide Xtreme Sports en la región Arequipa. Eventos no puntuables para el ranking acumulado de la Copa MacroSur MTB, pero con premiación independiente, trazados sobre asfalto y cupos exclusivos."
    />

    <section class="events-section" id="eventos">
      <SectionLabel number="01" label="CALENDARIO DE RUTA & ESPECIALES" kicker="AREQUIPA 2026" />

      {apiError && (
        <p class="events-error font-mono">
          [ NO PUDIMOS CARGAR EL CALENDARIO DE EVENTOS — VUELVE A INTENTARLO EN UNOS SEGUNDOS ]
        </p>
      )}

      <ol class="lineup">
        {events.map((ev, i) => (
          <li>
            <RouteEventCard event={ev} index={String(i + 1).padStart(2, '0')} />
          </li>
        ))}
      </ol>
    </section>
  </main>

  <SiteFooter />
</Showcase>

<style>
  .page-content {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .events-section {
    margin-top: 2rem;
  }

  .events-error {
    margin: 1.5rem 0 0;
    padding: 1rem 1.25rem;
    border: var(--hairline) solid var(--line);
    background: var(--bg-raised);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  /* El lineup de la referencia: dos columnas a partir de 768px. */
  .lineup {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48em) {
    .lineup {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
