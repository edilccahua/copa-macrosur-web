---
/**
 * premios.astro — Página de premios de la edición.
 *
 * La escala se declara en `src/data/prizes.ts` (PROVISIONAL: la BD todavía
 * conserva la escala anterior; ver `docs/PREMIOS-PENDIENTE.md`). Aquí no se
 * escribe ningún monto suelto: portada y página leen del mismo módulo.
 *
 * Reglas de la edición:
 *   · Acumulado del campeonato: 300 / 200 / 100 USD al podio de PRO y al
 *     podio de NORMAL (por agrupación, no por categoría).
 *   · Por fecha: 100 / 50 / 30 USD en CADA UNA de las 11 categorías.
 *
 * La página tiene CUATRO secciones (acumulado, premio por fecha, Premio
 * CLARO y títulos de montaña) y UNA sola gramática: todas se construyen con
 * `PrizeCell`, la celda de la tabla de principios de la referencia
 * (`copiaartcraft/src/pages/apps.astro`). Mismo filete, mismo titular, mismo
 * color. La cabecera es el masthead de la referencia: titular grande y
 * bajada, sin tablas al lado.
 */
import Showcase from '../layouts/Showcase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionLabel from '../components/bento/SectionLabel.astro';
import PageHeader from '../components/PageHeader.astro';
import PrizeCell from '../components/PrizeCell.astro';
import { getRemontada, getStandings, type StandingsRow, type TeamStandingRow } from '../lib/api';
import { MOUNTAIN_TITLES } from '../data/mountain-titles';
import {
  ACCUMULATED_PRIZES,
  PER_DATE_PRIZES,
  PER_DATE_PRIZE_ICON,
  PRIZE_CATEGORIES,
  PRIZE_CURRENCY,
  type PrizePosition,
} from '../data/prizes';
import type { PrizePodiumStep } from '../components/PrizeCell.astro';

/** La clasificación de una agrupación: sus filas y las fechas ya disputadas. */
interface ScopeData {
  rows: StandingsRow[];
  stagesCounted: number;
}

async function fetchScope(scope: 'PRO' | 'NORMAL'): Promise<ScopeData> {
  try {
    const data = await getStandings({ scope });
    return {
      rows: (data.rows ?? []) as StandingsRow[],
      stagesCounted: data.context?.stages_counted ?? 0,
    };
  } catch (e) {
    return { rows: [], stagesCounted: 0 };
  }
}

/** La Copa de Equipos: los clubes con más puntos acumulados. */
interface TeamData {
  rows: TeamStandingRow[];
}

async function fetchTeams(): Promise<TeamData> {
  try {
    const data = await getStandings({ kind: 'teams' });
    return { rows: (data.rows ?? []) as TeamStandingRow[] };
  } catch (e) {
    return { rows: [] };
  }
}

// Las lecturas van en paralelo: la página no encadena latencias.
//
// Los títulos de montaña NO se piden aquí: son premios POR FECHA y su
// ganador es el de la Fecha 1, no el del campeonato. Se publican en la
// ficha de cada fecha (`/fechas/[slug]`) y en la portada.
const [remontada, proScope, normalScope, teamData] = await Promise.all([
  getRemontada(),
  fetchScope('PRO'),
  fetchScope('NORMAL'),
  fetchTeams(),
]);

/**
 * El podio del premio: cada peldaño con su cifra y con el ganador
 * PROVISIONAL de ese puesto (sólo en los premios acumulados: los por fecha
 * se resuelven en cada carrera).
 */
function podio(
  tiers: { position: PrizePosition; amountUsd: number }[],
  holders: { name: string; points: number }[]
): PrizePodiumStep[] {
  return tiers.map((tier) => {
    const holder = holders[tier.position - 1];
    return {
      position: tier.position,
      amountUsd: tier.amountUsd,
      holder: holder?.name ?? null,
    };
  });
}

const claro = remontada?.winner ?? null;

/** Los tres primeros de una agrupación, con sus puntos. */
function podiumHolders(rows: { rider_name: string; total_points: number }[]) {
  return rows.slice(0, 3).map((r) => ({ name: r.rider_name, points: r.total_points }));
}

/** Los tres primeros clubes de la Copa de Equipos. */
function teamHolders(rows: { team_name: string; total_points: number }[]) {
  return rows.slice(0, 3).map((r) => ({ name: r.team_name, points: r.total_points }));
}
---

<Showcase
  title="Premios — Copa MacroSur MTB"
  sections={[
    { label: 'Acumulado', id: 'acumulado' },
    { label: 'Por fecha', id: 'por-fecha' },
    { label: 'Equipos', id: 'equipos' },
    { label: 'Claro', id: 'claro' },
    { label: 'Montaña', id: 'montana' },
  ]}
>
  <SiteHeader />

  <main class="page-content container" id="premios">
    <PageHeader
      eyebrow="Kúspide Xtreme Sports // Premios"
      before="La escala de "
      accent="premios"
      lead="Ocho premios con regla propia. Cada uno dice quién lo cobra, cuánto y en qué fecha se decide."
    />

    <!-- ── 01 · Acumulado del campeonato ─────────────────────────────── -->
    <section class="premios-section" id="acumulado">
      <SectionLabel
        number="01"
        label="Acumulado del campeonato"
        kicker="PRO Y NORMAL"
      />

      <div class="prize-table prize-table--pair">
        {
          ACCUMULATED_PRIZES.map((prize) => {
            const scope = prize.scope === 'PRO' ? proScope : normalScope;
            return (
              <PrizeCell
                title={prize.label}
                body={`Al que más puntos suma en el acumulado ${prize.scope}.`}
                podium={podio(prize.tiers, podiumHolders(scope.rows))}
                icon={prize.icon}
              />
            );
          })
        }
      </div>
    </section>

    <!-- ── 02 · Premio por fecha ─────────────────────────────────────── -->
    <section class="premios-section" id="por-fecha">
      <SectionLabel
        number="02"
        label="Premio por fecha"
        kicker={`${PRIZE_CATEGORIES.length} CATEGORÍAS · 4 FECHAS`}
      />

      <div class="prize-table prize-table--pair">
        <PrizeCell
          title="CADA CATEGORÍA"
          body={`El podio de cada una de las ${PRIZE_CATEGORIES.length} categorías.`}
          podium={PER_DATE_PRIZES.map((tier) => ({ ...tier, holder: null }))}
          icon={PER_DATE_PRIZE_ICON}
          state="Cada fecha"
          notes={PRIZE_CATEGORIES}
        />

        <PrizeCell
          label="[ CÓMO SE REPARTE ]"
          body="Once podios por fecha, uno en cada categoría. El acumulado se paga al líder de la agrupación PRO y al de la NORMAL."
        />
      </div>
    </section>

    <!-- ── 03 · Premio de equipos ─────────────────────────────────────── -->
    <section class="premios-section" id="equipos">
      <SectionLabel
        number="03"
        label="Premio de equipos"
        kicker="COPA DE EQUIPOS"
      />

      <div class="prize-table prize-table--pair">
        <PrizeCell
          title="COPA DE EQUIPOS"
          body="Al club con más puntos en la Copa de Equipos acumulada."
          podium={podio(ACCUMULATED_PRIZES[0].tiers, teamHolders(teamData.rows))}
          icon="users"
        />

        <PrizeCell
          label="[ CÓMO SE REPARTE ]"
          body="Suma los puntos de todas sus categorías en todas las fechas. Se entrega al cerrar el campeonato, con el podio de la Copa de Equipos."
        />
      </div>
    </section>

    <!-- ── 04 · Premio CLARO ─────────────────────────────────────────── -->
    <section class="premios-section" id="claro">
      <SectionLabel
        number="04"
        label="Premio CLARO"
        kicker="LA REMONTADA"
      />

      <div class="prize-table prize-table--pair">
        <PrizeCell
          logo={remontada?.sponsor_logo_url ?? '/images/sponsors/claro.svg'}
          logoAlt="Claro"
          title={remontada?.title ?? 'PREMIO CLARO'}
          body={
            remontada?.criterion ??
            'Al corredor que más puestos sube en su categoría entre la primera y la última fecha disputada, habiendo terminado todas las fechas del campeonato.'
          }
          amount={`${PRIZE_CURRENCY} ${remontada?.amount_usd ?? 100}`}
          state={
            claro ? (remontada?.provisional ? 'Ganador provisional' : 'Ganador') : 'Por anunciar'
          }
          value={claro?.rider_name}
          detail={
            claro
              ? `+${claro.positions_gained} PUESTOS · ${remontada?.stages_counted ?? 0} DE ${remontada?.total_stages ?? 0} FECHAS`
              : null
          }
        />

        <PrizeCell
          label="[ CÓMO SE ENTREGA ]"
          body="Se entrega al cerrar las cuatro fechas, no en una carrera. Hasta entonces, el ganador es provisional."
        />
      </div>
    </section>

    <!-- ── 05 · Títulos de montaña ───────────────────────────────────── -->
    <section class="premios-section" id="montana">
      <SectionLabel
        number="05"
        label="Títulos de montaña"
        kicker="4 TÍTULOS POR FECHA"
      />

      <div class="prize-table prize-table--four">
        {
          MOUNTAIN_TITLES.map((definition) => (
            <PrizeCell
              title={definition.title}
              body={definition.criterion}
              amount={`${PRIZE_CURRENCY} ${definition.amountUsd}`}
              icon={definition.icon}
              state="Uno por fecha"
            />
          ))
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</Showcase>

<style>
  .page-content {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .premios-section + .premios-section {
    margin-top: 3.5rem;
  }

  /* La barra de sección ya trae su hairline; la sección no la repite. */
  .premios-section {
    padding-top: 0;
  }

  /* ── La tabla de premios ──────────────────────────────────────────────
     La grilla dibuja los filetes con `gap: 1px` sobre su propio fondo, y
     las celdas lo tapan con el fondo de la página: por eso es UNA rejilla
     y no un mosaico de cajas. Es el mecanismo de la tabla de principios de
     la referencia (`copiaartcraft/src/pages/apps.astro`). */
  .prize-table {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin-top: 1.5rem;
    background: var(--line);
    border-top: var(--hairline) solid var(--line);
  }

  @media (min-width: 48em) {
    .prize-table--pair {
      grid-template-columns: repeat(2, 1fr);
    }

    .prize-table--four {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68.75em) {
    .prize-table--four {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
