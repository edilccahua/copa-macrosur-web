---
/**
 * premios.astro — Página de premios de la edición.
 *
 * La escala se declara en `src/data/prizes.ts` (PROVISIONAL: la BD todavía
 * conserva la escala anterior; ver `docs/PREMIOS-PENDIENTE.md`). Aquí no se
 * escribe ningún monto suelto: portada y página leen del mismo módulo.
 *
 * Reglas de la edición:
 *   · Acumulado del campeonato: 300 / 200 / 100 USD al podio de PRO y al
 *     podio de NORMAL (por agrupación, no por categoría).
 *   · Por fecha: 100 / 50 / 30 USD en CADA UNA de las 11 categorías.
 *
 * La página tiene UNA gramática: los ocho premios son celdas de la misma
 * tabla (`PrizeCell`), con el filete de 1px de la referencia. El masthead es
 * el de la referencia (`copiaartcraft/src/pages/apps.astro`): titular grande
 * y bajada. Ni tablas aparte, ni notas, ni párrafos que repitan lo que ya
 * dice la celda.
 */
import Showcase from '../layouts/Showcase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionLabel from '../components/bento/SectionLabel.astro';
import PageHeader from '../components/PageHeader.astro';
import PrizeCell from '../components/PrizeCell.astro';
import { API_V1, getRemontada, getStandings, type MountainTitle, type StandingsRow } from '../lib/api';
import { MOUNTAIN_TITLES } from '../data/mountain-titles';
import {
  ACCUMULATED_PRIZES,
  PER_DATE_PRIZES,
  PER_DATE_PRIZE_ICON,
  PRIZE_CATEGORIES,
  PRIZE_CURRENCY,
} from '../data/prizes';

/** Los cuatro títulos de montaña de la Fecha 1 (KOM/QOM/Kamikaze). */
async function fetchMountainTitles(): Promise<Record<string, MountainTitle | null>> {
  const titles: Record<string, MountainTitle | null> = {
    kom: null,
    qom: null,
    kamikaze_male: null,
    kamikaze_female: null,
  };
  try {
    const res = await fetch(`${API_V1}/stages/la-joya-extreme/summary`);
    if (res.ok) {
      const data = await res.json();
      titles.kom = data.kom ?? null;
      titles.qom = data.qom ?? null;
      titles.kamikaze_male = data.kamikaze_male ?? null;
      titles.kamikaze_female = data.kamikaze_female ?? null;
    }
  } catch (e) {
    /* Las celdas muestran "sin ganador todavía". */
  }
  return titles;
}

/** La clasificación de una agrupación: sus filas y las fechas ya disputadas. */
interface ScopeData {
  rows: StandingsRow[];
  stagesCounted: number;
}

async function fetchScope(scope: 'PRO' | 'NORMAL'): Promise<ScopeData> {
  try {
    const data = await getStandings({ scope });
    return {
      rows: (data.rows ?? []) as StandingsRow[],
      stagesCounted: data.context?.stages_counted ?? 0,
    };
  } catch (e) {
    return { rows: [], stagesCounted: 0 };
  }
}

// Las lecturas van en paralelo: la página no encadena latencias.
const [mountain, remontada, proScope, normalScope] = await Promise.all([
  fetchMountainTitles(),
  getRemontada(),
  fetchScope('PRO'),
  fetchScope('NORMAL'),
]);

/**
 * El premio acumulado se paga al LÍDER de la agrupación. Mientras el
 * campeonato no se cierra, ese líder sólo es provisional.
 */
function leader(scope: ScopeData) {
  const top = scope.rows[0];
  if (!top) return null;
  return {
    name: top.rider_name,
    points: top.total_points,
    stagesCounted: scope.stagesCounted,
    totalStages: remontada?.total_stages ?? 0,
  };
}

/** "300 / 200 / 100": los peldaños de una escala, en una línea. */
function escala(tiers: { amountUsd: number }[]): string {
  return tiers.map((tier) => tier.amountUsd).join(' / ');
}

const pro = leader(proScope);
const normal = leader(normalScope);
const claro = remontada?.winner ?? null;

/** La línea de puntos y fechas del ganador provisional. */
function progreso(p: { points: number; stagesCounted: number; totalStages: number } | null) {
  if (!p) return null;
  return p.totalStages > 0
    ? `${p.points} PTS · ${p.stagesCounted} DE ${p.totalStages} FECHAS`
    : `${p.points} PTS`;
}
---

<Showcase
  title="Premios — Copa MacroSur MTB"
  sections={[{ label: 'La escala', id: 'escala' }]}
>
  <SiteHeader />

  <main class="page-content container" id="premios">
    <PageHeader
      eyebrow="Kúspide Xtreme Sports // Premios"
      before="La escala de "
      accent="premios"
      lead="Ocho premios con regla propia. Cada uno dice quién lo cobra, cuánto y en qué fecha se decide."
    />

    <section class="premios-section" id="escala">
      <SectionLabel number="01" label="La escala" kicker={`EDICIÓN 2026`} />

      <div class="prize-table">
        {
          ACCUMULATED_PRIZES.map((prize, i) => {
            const p = prize.scope === 'PRO' ? pro : normal;
            return (
              <PrizeCell
                index={String(i + 1).padStart(2, '0')}
                title={prize.label}
                body={`Al líder de puntos del acumulado ${prize.scope}.`}
                amount={`${PRIZE_CURRENCY} ${escala(prize.tiers)}`}
                icon={prize.icon}
                accent={prize.scope === 'PRO' ? 'pro' : 'normal'}
                state={p ? 'Ganador provisional' : 'Por anunciar'}
                value={p?.name}
                detail={progreso(p)}
              />
            );
          })
        }

        <PrizeCell
          index="03"
          title="CADA CATEGORÍA"
          body={`El podio de cada una de las ${PRIZE_CATEGORIES.length} categorías.`}
          amount={`${PRIZE_CURRENCY} ${escala(PER_DATE_PRIZES)}`}
          icon={PER_DATE_PRIZE_ICON}
          accent="gold"
          state="Cada fecha"
          detail={`${PRIZE_CATEGORIES.length} PODIOS POR FECHA`}
        />

        <PrizeCell
          index="04"
          title="PREMIO CLARO"
          body="Al corredor que más puestos sube en el campeonato."
          amount={`${PRIZE_CURRENCY} ${remontada?.amount_usd ?? 100}`}
          logo={remontada?.sponsor_logo_url ?? '/images/sponsors/claro.svg'}
          logoAlt="Claro"
          accent="gold"
          state={claro ? (remontada?.provisional ? 'Ganador provisional' : 'Ganador') : 'Por anunciar'}
          value={claro?.rider_name}
          detail={
            claro
              ? `+${claro.positions_gained} PUESTOS · ${remontada?.stages_counted ?? 0} DE ${remontada?.total_stages ?? 0} FECHAS`
              : null
          }
        />

        {
          MOUNTAIN_TITLES.map((definition, i) => {
            const winner = mountain[definition.key] ?? null;
            return (
              <PrizeCell
                index={String(i + 5).padStart(2, '0')}
                title={definition.title}
                body={definition.criterion}
                amount={`${PRIZE_CURRENCY} ${definition.amountUsd}`}
                icon={definition.icon}
                accent="gold"
                state="Uno por fecha"
                value={winner?.athlete_name}
                detail={
                  winner
                    ? `${winner.formatted_time} · ${winner.segment_name}`
                    : 'Sin ganador todavía'
                }
              />
            );
          })
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</Showcase>

<style>
  .page-content {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .premios-section + .premios-section {
    margin-top: 3.5rem;
  }

  /* La barra de sección ya trae su hairline; la sección no la repite. */
  .premios-section {
    padding-top: 0;
  }

  /* ── La tabla de premios ──────────────────────────────────────────────
     La grilla dibuja los filetes con `gap: 1px` sobre su propio fondo, y
     las celdas lo tapan con el fondo de la página: por eso es UNA rejilla
     y no un mosaico de cajas. Es el mecanismo de la tabla de principios de
     la referencia (`copiaartcraft/src/pages/apps.astro`). */
  .prize-table {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1px;
    margin-top: 1.5rem;
    background: var(--line);
    border-top: var(--hairline) solid var(--line);
  }

  @media (min-width: 48em) {
    .prize-table {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68.75em) {
    .prize-table {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
