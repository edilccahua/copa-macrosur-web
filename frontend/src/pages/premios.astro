---
/**
 * premios.astro — Página de premios de la edición.
 *
 * La escala se declara en `src/data/prizes.ts` (PROVISIONAL: la BD todavía
 * conserva la escala anterior; ver `docs/PREMIOS-PENDIENTE.md`). Aquí no se
 * escribe ningún monto suelto: portada y página leen del mismo módulo.
 *
 * Reglas de la edición:
 *   · Acumulado del campeonato: 300 / 200 / 100 USD al podio de PRO y al
 *     podio de NORMAL (por agrupación, no por categoría).
 *   · Por fecha: 100 / 50 / 30 USD en CADA UNA de las 11 categorías.
 *
 * Los premios especiales (Premio Coca y Rey de la Montaña) salen de la API,
 * con su ganador cuando `winner_rider_id` ya está resuelto.
 */
import Showcase from '../layouts/Showcase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionLabel from '../components/bento/SectionLabel.astro';
import PageHeader from '../components/PageHeader.astro';
import PrizeScale from '../components/PrizeScale.astro';
import MountainTitleCard from '../components/MountainTitleCard.astro';
import { API_V1, getRemontada, getStandings, type MountainTitle, type StandingsRow } from '../lib/api';
import { MOUNTAIN_TITLES } from '../data/mountain-titles';
import {
  ACCUMULATED_PRIZES,
  PER_DATE_PRIZES,
  PER_DATE_PRIZE_ICON,
  PRIZE_CATEGORIES,
  PRIZE_CURRENCY,
} from '../data/prizes';
import type { PrizeLeader } from '../components/PrizeScale.astro';

/**
 * Los cuatro títulos de montaña de la Fecha 1 (KOM/QOM/Kamikaze).
 */
async function fetchMountainTitles(): Promise<Record<string, MountainTitle | null>> {
  const titles: Record<string, MountainTitle | null> = {
    kom: null,
    qom: null,
    kamikaze_male: null,
    kamikaze_female: null,
  };
  try {
    const res = await fetch(`${API_V1}/stages/la-joya-extreme/summary`);
    if (res.ok) {
      const data = await res.json();
      titles.kom = data.kom ?? null;
      titles.qom = data.qom ?? null;
      titles.kamikaze_male = data.kamikaze_male ?? null;
      titles.kamikaze_female = data.kamikaze_female ?? null;
    }
  } catch (e) {
    /* Las tarjetas muestran "sin ganador todavía". */
  }
  return titles;
}

/** La clasificación de una agrupación: sus filas y las fechas ya disputadas. */
interface ScopeData {
  rows: StandingsRow[];
  stagesCounted: number;
}

async function fetchScope(scope: 'PRO' | 'NORMAL'): Promise<ScopeData> {
  try {
    const data = await getStandings({ scope });
    return {
      rows: (data.rows ?? []) as StandingsRow[],
      stagesCounted: data.context?.stages_counted ?? 0,
    };
  } catch (e) {
    return { rows: [], stagesCounted: 0 };
  }
}

// Las cuatro lecturas van en paralelo: la página no encadena latencias.
const [mountain, remontada, proScope, normalScope] = await Promise.all([
  fetchMountainTitles(),
  getRemontada(),
  fetchScope('PRO'),
  fetchScope('NORMAL'),
]);

/**
 * El premio acumulado se paga al LÍDER de la agrupación. Mientras el
 * campeonato no se cierra, ese líder sólo es provisional: la tarjeta lo dice
 * con su nombre en vez de un "por anunciar" vacío.
 */
function toLeader(scope: ScopeData): PrizeLeader | null {
  const top = scope.rows[0];
  if (!top) return null;
  return {
    name: top.rider_name,
    slug: top.rider_slug,
    points: top.total_points,
    stagesCounted: scope.stagesCounted,
    totalStages: remontada?.total_stages ?? 0,
  };
}
---

<Showcase
  title="Premios — Copa MacroSur MTB"
  sections={[{ label: 'Premios', id: 'premios' }]}
>
  <SiteHeader />

  <main class="page-content container" id="premios">
    <PageHeader
      eyebrow="Kúspide Xtreme Sports // Premios"
      before="La escala de "
      accent="premios"
      lead="El acumulado del campeonato reparte 300 / 200 / 100 USD entre los líderes de PRO y de NORMAL. Cada fecha reparte 100 / 50 / 30 USD en cada una de las 11 categorías."
    />

    <!-- ── 01 · Acumulado del campeonato ─────────────────────────────── -->
    <section class="premios-section">
      <SectionLabel
        number="01"
        label="Acumulado del campeonato"
        kicker={`${PRIZE_CURRENCY} 300 / 200 / 100`}
      />

      <div class="prize-grid">
        {
          ACCUMULATED_PRIZES.map((prize) => (
            <PrizeScale
              label="ACUMULADO"
              title={prize.label}
              body={prize.blurb}
              tiers={prize.tiers}
              currency={PRIZE_CURRENCY}
              accent={prize.scope === 'PRO' ? 'pro' : 'normal'}
              icon={prize.icon}
              leader={toLeader(prize.scope === 'PRO' ? proScope : normalScope)}
              tags={['PODIO DE LA AGRUPACIÓN']}
            />
          ))
        }
      </div>
    </section>

    <!-- ── 02 · Premio por fecha ─────────────────────────────────────── -->
    <section class="premios-section">
      <SectionLabel
        number="02"
        label="Premio por fecha"
        kicker={`${PRIZE_CURRENCY} 100 / 50 / 30 · CADA CATEGORÍA`}
      />

      <div class="date-grid">
        <PrizeScale
          label="POR FECHA"
          title="CADA CATEGORÍA"
          body="El podio de cada categoría cobra en cada una de las cuatro fechas. No hay una bolsa común para el grupo NORMAL."
          tiers={PER_DATE_PRIZES}
          currency={PRIZE_CURRENCY}
          accent="gold"
          icon={PER_DATE_PRIZE_ICON}
          status="CADA FECHA"
          tags={['11 CATEGORÍAS', '4 FECHAS']}
        >
          <div class="categories">
            <p class="categories__label font-mono">SE REPARTE EN CADA UNA DE ESTAS CATEGORÍAS</p>
            <ul class="categories__list">
              {PRIZE_CATEGORIES.map((category) => (
                <li class="categories__item font-mono">{category}</li>
              ))}
            </ul>
          </div>
        </PrizeScale>

        <aside class="prize-note">
          <p class="prize-note__label font-mono">[ CÓMO SE REPARTE ]</p>
          <p class="prize-note__text">
            Cada fecha tiene once podios, uno por categoría. El 1º de cada categoría cobra
            <strong> {PRIZE_CURRENCY} 100</strong>, el 2º <strong>{PRIZE_CURRENCY} 50</strong> y el
            3º <strong>{PRIZE_CURRENCY} 30</strong>.
          </p>
          <p class="prize-note__text">
            El acumulado es distinto: no se paga por categoría, sino al líder de puntos de toda la
            agrupación <strong>PRO</strong> y al de toda la agrupación <strong>NORMAL</strong>.
          </p>
        </aside>
      </div>
    </section>

    <!-- ── 03 · Premio CLARO ─────────────────────────────────────────── -->
    <section class="premios-section" id="claro">
      <SectionLabel
        number="03"
        label="Premio CLARO"
        kicker={`${PRIZE_CURRENCY} ${remontada?.amount_usd ?? 100} · ACUMULADO`}
      />

      <div class="claro">
        <div class="claro__logo">
          <img
            src={remontada?.sponsor_logo_url ?? '/images/sponsors/claro.svg'}
            alt="Claro"
            loading="lazy"
          />
        </div>

        <div class="claro__body">
          <p class="claro__eyebrow font-mono">
            ACUMULADO · {PRIZE_CURRENCY} {remontada?.amount_usd ?? 100}
          </p>
          <h2 class="claro__title">{remontada?.title ?? 'PREMIO CLARO'}</h2>
          <p class="claro__criterion">
            {remontada?.criterion ??
              'Al corredor que más puestos sube en su categoría entre la primera y la última fecha disputada, habiendo terminado todas las fechas del campeonato.'}
          </p>

          <p class="claro__rule">
            Se entrega al cerrar las cuatro fechas, no en una carrera. Debe haber terminado
            <strong>todas</strong>; gana quien más puestos sube entre la <strong>primera</strong> y
            la <strong>última</strong>. Hasta entonces, el ganador es
            <strong>provisional</strong>.
          </p>

          <div class="claro__winner">
            {
              remontada?.winner ? (
                <>
                  <p class="claro__winner-label font-mono">
                    {remontada.provisional ? 'GANADOR PROVISIONAL' : 'GANADOR'}
                  </p>
                  <p class="claro__winner-name">{remontada.winner.rider_name}</p>
                  <p class="claro__winner-detail font-mono">
                    FECHA {remontada.winner.first_stage_number}: {remontada.winner.first_rank}º →
                    FECHA {remontada.winner.last_stage_number}: {remontada.winner.last_rank}º · +
                    {remontada.winner.positions_gained} PUESTOS ·{' '}
                    {remontada.winner.category_name}
                  </p>
                  <p class="claro__winner-meta font-mono">
                    {remontada.stages_counted} DE {remontada.total_stages} FECHAS DISPUTADAS
                  </p>
                </>
              ) : (
                <p class="claro__winner-label font-mono">POR ANUNCIAR</p>
              )
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ── 04 · Títulos de montaña ───────────────────────────────────── -->
    <section class="premios-section" id="montana">
      <SectionLabel
        number="04"
        label="Títulos de montaña"
        kicker={`${PRIZE_CURRENCY} 15 CADA UNO`}
      />

      <p class="mountain-note">
        Cuatro títulos por fecha, con <strong>un solo ganador</strong> cada uno. Se resuelven con
        los intentos de Strava de la ruta oficial y cada uno cobra
        <strong>{PRIZE_CURRENCY} 15</strong>. Los que se ven aquí son los de la Fecha 1; se
        actualizan al cerrar cada carrera.
      </p>

      <div class="mountain-grid">
        {
          MOUNTAIN_TITLES.map((definition) => (
            <MountainTitleCard
              definition={definition}
              winner={mountain[definition.key] ?? null}
            />
          ))
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</Showcase>

<style>
  .page-content {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .premios-section + .premios-section {
    margin-top: 3.5rem;
  }

  /* La barra de sección ya trae su hairline; la sección no la repite. */
  .premios-section {
    padding-top: 0;
  }

  .prize-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .date-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    align-items: start;
  }

  @media (min-width: 48em) {
    .prize-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68.75em) {
    .date-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    }
  }

  /* ── La nota de la regla ─────────────────────────────────────────────── */
  .prize-note {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-sunken);
    border: var(--hairline) solid var(--line);
  }

  .prize-note__label {
    margin: 0;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .prize-note__text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .prize-note__text strong {
    color: var(--ink-strong);
    font-weight: var(--font-weight-medium);
  }

  /* ── Las 11 categorías ───────────────────────────────────────────────── */
  .categories {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
  }

  .categories__label {
    margin: 0 0 0.625rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .categories__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .categories__item {
    padding: 0.25rem 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    border: var(--hairline) solid var(--line);
  }

  /* ── Premio CLARO ────────────────────────────────────────────────────── */
  .claro {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 1.5rem;
    background: var(--bg-raised);
    border: var(--hairline) solid var(--line);
  }

  .claro__logo {
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: #fff;
    border: var(--hairline) solid var(--line);
  }

  .claro__logo img {
    display: block;
    width: 100%;
    max-width: 12rem;
    height: auto;
  }

  .claro__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .claro__eyebrow {
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--copa-gold);
  }

  .claro__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  .claro__criterion {
    margin: 0;
    max-width: 58ch;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--ink);
  }

  .claro__rule {
    margin: 0;
    max-width: 62ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .claro__rule strong {
    color: var(--ink-strong);
    font-weight: var(--font-weight-medium);
  }

  .claro__winner {
    margin-top: 0.75rem;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
  }

  .claro__winner-label {
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .claro__winner-name {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-tight);
    color: var(--ink-strong);
  }

  .claro__winner-detail {
    margin: 0.35rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.6;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .claro__winner-meta {
    margin: 0.35rem 0 0;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--faint);
  }

  /* ── Títulos de montaña ─────────────────────────────────────────────── */
  .mountain-note {
    max-width: 62ch;
    margin: 1.5rem 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .mountain-note strong {
    color: var(--ink-strong);
    font-weight: var(--font-weight-medium);
  }

  .mountain-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 48em) {
    .claro {
      grid-template-columns: 14rem 1fr;
      align-items: start;
    }

    .mountain-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
