---
/**
 * premios.astro — Página de premios de la edición.
 *
 * La escala se declara en `src/data/prizes.ts` (PROVISIONAL: la BD todavía
 * conserva la escala anterior; ver `docs/PREMIOS-PENDIENTE.md`). Aquí no se
 * escribe ningún monto suelto: portada y página leen del mismo módulo.
 *
 * Reglas de la edición:
 *   · Acumulado del campeonato: 300 / 200 / 100 USD al podio de PRO y al
 *     podio de NORMAL (por agrupación, no por categoría).
 *   · Por fecha: 100 / 50 / 30 USD en CADA UNA de las 11 categorías.
 *
 * Los premios especiales (Premio Coca y Rey de la Montaña) salen de la API,
 * con su ganador cuando `winner_rider_id` ya está resuelto.
 */
import Showcase from '../layouts/Showcase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionLabel from '../components/bento/SectionLabel.astro';
import PrizeScale from '../components/PrizeScale.astro';
import { API_V1 } from '../lib/api';
import {
  ACCUMULATED_PRIZES,
  PER_DATE_PRIZES,
  PRIZE_CATEGORIES,
  PRIZE_CURRENCY,
} from '../data/prizes';

/** Los premios especiales de la Fecha 1, con su ganador si ya se conoce. */
let awards: {
  title: string;
  sponsor_name?: string | null;
  sponsor_logo_url?: string | null;
  prize_description?: string | null;
  metric_value?: string | null;
  winner_name?: string | null;
}[] = [];
try {
  const res = await fetch(`${API_V1}/stages/la-joya-extreme/summary`);
  if (res.ok) {
    const data = await res.json();
    awards = Array.isArray(data.awards) ? data.awards : [];
  }
} catch (e) {
  awards = [];
}
---

<Showcase
  title="Premios — Copa MacroSur MTB"
  sections={[{ label: 'Premios', id: 'premios' }]}
>
  <SiteHeader />

  <main class="page-content container" id="premios">
    <header class="page-header" data-draw>
      <div class="page-tag font-mono" data-draw-eyebrow>[ KÚSPIDE XTREME SPORTS // PREMIOS ]</div>
      <h1 class="page-title">PREMIOS</h1>
      <p class="page-desc">
        El acumulado del campeonato reparte 300 / 200 / 100 USD entre los líderes de PRO y de
        NORMAL. Cada fecha reparte 100 / 50 / 30 USD en cada una de las 11 categorías.
      </p>
    </header>

    <!-- ── 01 · Acumulado del campeonato ─────────────────────────────── -->
    <section class="premios-section">
      <SectionLabel
        number="01"
        label="Acumulado del campeonato"
        kicker={`${PRIZE_CURRENCY} 300 / 200 / 100`}
      />

      <div class="prize-grid">
        {
          ACCUMULATED_PRIZES.map((prize) => (
            <PrizeScale
              label="CAMPEONATO"
              title={prize.label}
              body={prize.blurb}
              tiers={prize.tiers}
              currency={PRIZE_CURRENCY}
              accent={prize.scope === 'PRO' ? 'pro' : 'normal'}
              tags={['ACUMULADO', 'PODIO DE LA AGRUPACIÓN']}
            />
          ))
        }
      </div>
    </section>

    <!-- ── 02 · Premio por fecha ─────────────────────────────────────── -->
    <section class="premios-section">
      <SectionLabel
        number="02"
        label="Premio por fecha"
        kicker={`${PRIZE_CURRENCY} 100 / 50 / 30 · CADA CATEGORÍA`}
      />

      <div class="date-grid">
        <PrizeScale
          label="POR FECHA"
          title="CADA CATEGORÍA"
          body="El podio de cada categoría cobra en cada una de las cuatro fechas. No hay una bolsa común para el grupo NORMAL."
          tiers={PER_DATE_PRIZES}
          currency={PRIZE_CURRENCY}
          accent="gold"
          tags={['11 CATEGORÍAS', '4 FECHAS']}
        >
          <div class="categories">
            <p class="categories__label font-mono">SE REPARTE EN CADA UNA DE ESTAS CATEGORÍAS</p>
            <ul class="categories__list">
              {PRIZE_CATEGORIES.map((category) => (
                <li class="categories__item font-mono">{category}</li>
              ))}
            </ul>
          </div>
        </PrizeScale>

        <aside class="prize-note">
          <p class="prize-note__label font-mono">[ CÓMO SE REPARTE ]</p>
          <p class="prize-note__text">
            Cada fecha tiene once podios, uno por categoría. El 1º de cada categoría cobra
            <strong> {PRIZE_CURRENCY} 100</strong>, el 2º <strong>{PRIZE_CURRENCY} 50</strong> y el
            3º <strong>{PRIZE_CURRENCY} 30</strong>.
          </p>
          <p class="prize-note__text">
            El acumulado es distinto: no se paga por categoría, sino al líder de puntos de toda la
            agrupación <strong>PRO</strong> y al de toda la agrupación <strong>NORMAL</strong>.
          </p>
        </aside>
      </div>
    </section>

    <!-- ── 03 · Premios especiales ───────────────────────────────────── -->
    <section class="premios-section">
      <SectionLabel number="03" label="Premios especiales" kicker="FECHA 1" />

      {
        awards.length > 0 ? (
          <ul class="awards">
            {awards.map((award) => (
              <li class="award">
                {award.sponsor_logo_url && (
                  <img class="award__logo" src={award.sponsor_logo_url} alt="" loading="lazy" />
                )}
                <div>
                  <h3 class="award__name">{award.title}</h3>
                  {award.prize_description && (
                    <p class="award__prize font-mono">{award.prize_description}</p>
                  )}
                  {award.metric_value && <p class="award__metric">{award.metric_value}</p>}
                  <p class="award__winner font-mono">
                    {award.winner_name ? `GANADOR: ${award.winner_name}` : 'GANADOR POR ANUNCIAR'}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty-state">
            <div class="empty-state__label font-mono">[ EN PREPARACIÓN ]</div>
            <p class="empty-state__text">
              Los premios especiales se anuncian al cerrar la fecha. Vuelve pronto.
            </p>
          </div>
        )
      }
    </section>
  </main>

  <SiteFooter />
</Showcase>

<style>
  .page-content {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    max-width: 52rem;
  }

  .page-tag {
    font-size: var(--text-xs, 0.6875rem);
    letter-spacing: 0.14em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .page-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .page-desc {
    margin-top: 1rem;
    max-width: 52ch;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .premios-section + .premios-section {
    margin-top: 3.5rem;
  }

  /* La barra de sección ya trae su hairline; la sección no la repite. */
  .premios-section {
    padding-top: 0;
  }

  .prize-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .date-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    align-items: start;
  }

  @media (min-width: 48em) {
    .prize-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68.75em) {
    .date-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.6fr);
    }
  }

  /* ── La nota de la regla ─────────────────────────────────────────────── */
  .prize-note {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-sunken);
    border: var(--hairline) solid var(--line);
  }

  .prize-note__label {
    margin: 0;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .prize-note__text {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .prize-note__text strong {
    color: var(--ink-strong);
    font-weight: var(--font-weight-medium);
  }

  /* ── Las 11 categorías ───────────────────────────────────────────────── */
  .categories {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: var(--hairline) solid var(--line);
  }

  .categories__label {
    margin: 0 0 0.625rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .categories__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .categories__item {
    padding: 0.25rem 0.5rem;
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    border: var(--hairline) solid var(--line);
  }

  /* ── Los premios especiales ─────────────────────────────────────────── */
  .awards {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .award {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    border-bottom: var(--hairline) solid var(--line);
  }

  .award__logo {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: cover;
    border: var(--hairline) solid var(--line);
  }

  .award__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium, 500);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-strong);
  }

  .award__prize {
    margin: 0.25rem 0 0;
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .award__metric {
    margin: 0.15rem 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .award__winner {
    margin: 0.35rem 0 0;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .empty-state {
    padding: 2.5rem 0;
  }

  .empty-state__label {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .empty-state__text {
    margin-top: 0.75rem;
    max-width: 40ch;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }
</style>
