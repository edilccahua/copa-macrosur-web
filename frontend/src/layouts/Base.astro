---
/**
 * Base.astro — shell global de Kúspide MTB.
 * Carga las 4 tipografías autoalojadas y los tokens medidos de GetArtCraft.
 * Cero Tailwind (AGENTS.md).
 *
 * Además monta el ROUTER de Astro (`astro:transitions`): la navegación pasa
 * a ser de cliente, en la MISMA pestaña, con un fundido corto y con la
 * cabecera persistida. Así la entrada de la barra ocurre una sola vez por
 * sesión y cambiar de página no recarga ni repite las animaciones.
 */
import { ClientRouter } from 'astro:transitions';
import PageRuler from '../components/PageRuler.astro';
import '@fontsource-variable/archivo';
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/display.css';
import '../styles/motion.css';

interface Props {
  title?: string;
  description?: string;
  theme?: 'light' | 'dark';
  /**
   * La página lleva el regulador lateral. Ya va en TODAS las páginas
   * (el layout lo renderiza siempre); la prop se conserva para que los
   * layouts puedan declararlo explícitamente.
   */
  ruler?: boolean;
  /** La página lleva el índice de secciones fijo a la derecha. */
  pageindex?: boolean;
}

const {
  title = 'Copa MacroSur MTB — Campeonato Oficial 2026',
  description = 'Plataforma oficial de cronometraje en vivo, clasificaciones y ranking acumulado de la Copa MacroSur MTB 2026.',
  theme,
  ruler = true,
  pageindex = false,
} = Astro.props;
---
<!doctype html>
<html
  lang="es"
  data-theme={theme}
  class:list={[
    ruler ? 'no-scrollbar' : undefined,
    pageindex ? 'has-pageindex' : undefined
  ]}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#101014" />

    <!--
      El tema se aplica ANTES del primer pintado (evita el destello).
      Se escribe SIEMPRE `data-theme`, aunque no haya preferencia guardada:
      si no, el botón de tema queda desincronizado del tema real (el sitio
      se ve oscuro por `prefers-color-scheme` pero el icono pide "ponerse
      oscuro", y el conmutador no hace nada visible).
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('kuspide-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <!--
      `motion-ready` marca que la página tiene movimiento y que el estado
      inicial de las animaciones lo aplica el CSS. La red de seguridad
      (quitar la clase si el módulo no arrancó) la pone el layout de
      escaparate, no éste: las páginas sin movimiento NUNCA deben ocultar
      contenido.
    -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!--
      El regulador de scroll del borde derecho. Va en TODAS las páginas (la
      de clasificaciones incluida) y es de altura completa, de modo que el
      regulador y el menú forman un solo instrumento: no queda un hueco
      entre la cabecera y la regleta.
    -->
    <PageRuler />

    <ClientRouter />
  </body>
</html>

<script>
  import '../scripts/site-shell';
</script>

<style>
  :global(.container) {
    width: 100%;
    max-width: var(--container-page, 80rem);
    box-sizing: border-box;
    min-width: 0;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media (min-width: 48em) {
    :global(.container) {
      padding-inline: 1.5rem;
      padding-right: 4.5rem;
    }
  }

  /*
    La banda de la derecha la usan DOS cosas fijas: el regulador (3.75rem) y
    las etiquetas del índice de secciones, que se alinean a 5.5rem del borde y
    se extienden hacia la izquierda (~7rem). Con solo 4.5rem de reserva el
    contenido se metía debajo de las etiquetas: a 1280 px, "CLASIFICACIÓN" se
    montaba sobre el botón "Ficha de ruta" de la banda de la próxima fecha.

    La reserva NO es fija: el contenedor es de 80rem y va centrado, así que
    cuanto más ancho es el viewport, más margen hay a los lados y menos banda
    hay que reservar. Por encima de 96em el margen ya basta y se queda el
    4.5rem de siempre.
  */
  @media (min-width: 48em) and (max-width: 95.99em) {
    :global(html.has-pageindex .container) {
      padding-right: max(4.5rem, calc(13rem - max(0rem, (100vw - 80rem) / 2)));
    }
  }

  /* ── Transición de página ───────────────────────────────────────────────
     Un fundido corto (180 ms). El contenido entra con el fundido y los
     elementos que quedan fuera de pantalla se revelan al hacer scroll. */
  :global(::view-transition-old(root)) {
    animation: 180ms cubic-bezier(0.4, 0, 0.2, 1) both vt-out;
  }

  :global(::view-transition-new(root)) {
    animation: 180ms cubic-bezier(0.4, 0, 0.2, 1) both vt-in;
  }

  @keyframes vt-out {
    to {
      opacity: 0;
    }
  }

  @keyframes vt-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(::view-transition-old(root)),
    :global(::view-transition-new(root)) {
      animation: none;
    }
  }
</style>
